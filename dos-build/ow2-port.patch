+					Vtx->LB += O->L.B * Dot;
+				}
+			}*/
+/*
+	N = surface normal
+	L     = unit vector between point and light
+	V = unit vector between point and view
+*/
+//    Ka + Kd * (N dot L) + Ks * (N dot ( L + V / 2))^n
+		for(O=Sc->OmniHead;O;O=O->Next)
