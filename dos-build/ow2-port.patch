+	PUBLIC	PT_Texture_32_
+PT_Texture_32_:
+mov [TEBP],ebp
+
+;vtx in ebx , bitmap in eax , where in ecx
+
+mov [BitMap],eax
+mov [Where],ecx
+
+mov ecx,ebx
+mov esi,ebx
+mov edi,ebx
