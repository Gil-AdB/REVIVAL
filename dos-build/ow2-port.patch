+// Return Pseudorandom value between -1 and 1. Requires a polynomial
+// seed given at x.
+
+float frand1d(long x)
+{
+  long s = 71 * x; s = s * 8192 ^ s;
+  return 1.0 - ((s*(s*s*15731+789221)+1376312589)& 0x7fffffff)/1073741824.0;
+}
+
+float Noise1D(float x)
+{
+  long i;
+  float f,n0,n1;
+
+  i = floor(x);
+  f = x - i;
+  n0 = frand1d(i);
+  n1 = frand1d(i+1);
+
+  return n0 + (n1-n0)*f;
+}
