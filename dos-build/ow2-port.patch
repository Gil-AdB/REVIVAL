+// Loads a PCX image from FN to Store,using IDR as results from previous
+// Detection via PCXDetect, and Pal to store the Palette.
+char PCXLoad(char *FN,unsigned char *Store,ImageDetectResult IDR,Palette *Pal)
+{
+  FILE *F;
+  char Ret;
+  long I,J,K;
+  long X,Y;
+  long FSize;
+  unsigned char V;
+  unsigned char C;
+  unsigned char *outpt;
