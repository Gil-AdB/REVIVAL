+  if (!Check_Texture_Memory_Range(Sc)) return;
+
+/*  for(Obj = Sc->ObjectHead;Obj;Obj=Obj->Next)
+    printf("Object (%s)'s Pivot is (%f,%f,%f)\n",Obj->Name,Obj->Pivot.X,Obj->Pivot.Y,Obj->Pivot.Z);*/
+
+  Timer=0; Frames=0;
+  CurFrame=0;
+
+  while (!Keyboard[ScESC])
