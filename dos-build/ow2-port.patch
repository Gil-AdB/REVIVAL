+// Functions.
+// Generates Sine/Cosine Lookup Tables, at 1/4 a Degree accuracy.
+void Generate_SCTabs()
+{
+  long I;
+  SinTab[0]=0.0;
+  CosTab[0]=1.0;
+  SinTab[1]=sin(PI/720);
+  CosTab[1]=cos(PI/720);
+  for(I=2;I<1440;I++)
+  {
+    SinTab[I]=SinTab[I-1]*CosTab[1]+CosTab[I-1]*SinTab[1];
+    CosTab[I]=CosTab[I-1]*CosTab[1]-SinTab[I-1]*SinTab[1];
+  }
+}
