+			if (S.Z<0)
+			{
+				T->Flags |= Tri_Invisible;
+				continue;
+			}
+			T->Flags |= Tri_Ahead;
+		}
+
+		dz = S.Z - Sc->FZP;
+		if (dz*dz>L2*T->BSphereRad)
+		{
+			if (dz>0.0f)
+			{
+				T->Flags |= Tri_Invisible;
+				continue;
+			}
+		}
+		// Out by left/right
+		S.X=fabs(S.X);
+		L1 = PX*S.X - CntrEX*S.Z;
+		if (L1*L1>L2*T->BSphereRad*(PX*PX+CntrEX*CntrEX))
