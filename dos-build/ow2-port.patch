+void Flip_Fake14H(VESA_Surface *VS)
+{
+  // ok, for each 16bit pixel, we put two 7bit colors next to each other
+  unsigned short *DWP = (unsigned short *)VS->Data;
+  char *DWS = (char *)VGAPtr;
+  long I;
+  unsigned short C;
+  char R,G,B;
+  I=PageSizeW;
+  while(I--)
+  {
+    C = *DWP++;
+    R = C>>11;
+    G = ((C>>5)&0x3F)>>2;
+    B = C&0x1F;
+    *DWS++ = (R<<2)+(G>>2);
+    *DWS++ = ((G&0x3)<<5)+B+128;
+  }
+}
+
+void Flip_Fake14V(VESA_Surface *VS)
+{
+  // ok, for each 16bit pixel, we put two 7bit colors next to each other
+  unsigned short *DWP = (unsigned short *)VS->Data;
+  char *DWS = (char *)VGAPtr;
+  long I,J;
+  unsigned short C;
+  char R,G,B;
+  for(J=0;J<YRes;J++)
+  {
+    for(I=0;I<XRes;I++)
+    {
+      C = *DWP++;
+      R = C>>11;
+      G = ((C>>5)&0x3F)>>2;
+      B = C&0x1F;
+      *DWS = (R<<2)+(G>>2);
+      *(DWS+XRes) = ((G&0x3)<<5)+B+128;
+      DWS++;
+    }
+    DWS+=XRes;
+  }
+}
