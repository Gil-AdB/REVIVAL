+void AW_Staticmap(AGridPoint *AGP)
+{
+  long I,J;
+  AGridPoint *GP = AGP;
+  float QX=XRes*0.1;
+  float QY=YRes*0.1;
+  float RX=XRes*0.8;
+  float RY=YRes*0.8;
+  for(J=0;J<AGrid_Y;J++)
+    for(I=0;I<AGrid_X;I++)
+    {
+      GP->X = QX+I*RX/(float)(AGrid_X-1);
+      GP->Y = QY+J*RY/(float)(AGrid_Y-1);
