+void Flip_Emu8_32(VESA_Surface *VS)
+{
+  char *Data = VS->Data,*DE = Data + VS->X*VS->Y;
+  char *Vid = VGAPtr;
+  char *PalTbl = VS->Pal,*CPal;
+  while(Data<DE)
