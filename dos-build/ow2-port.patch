+		J = (*Pixel)+((int)A->LB<<2);
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+		J = (*Pixel)+((int)A->LG<<2);
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+		J = (*Pixel)+((int)A->LR<<2);
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+		Pixel++;
+		J = (*Pixel)+A->LB;
+    if (J>255) *Pixel++=255; else *Pixel++=J;
+    J = (*Pixel)+A->LG;
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+		J = (*Pixel)+A->LR;
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+    Pixel += (XRes<<2)-7;
+		J = (*Pixel)+A->LB;
+    if (J>255) *Pixel++=255; else *Pixel++=J;
+		J = (*Pixel)+A->LG;
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+		J = (*Pixel)+A->LR;
+		if (J>255) *Pixel++=255; else *Pixel++=J;
+	}
