# Fountain — lightning look knobs (hot-reloads while running; tune via the
# console at localhost:8666, or pause inside a strike and scrub F1/F2).
bolt_width = 0.85   # core ribbon half-width factor (thin=0.6, fat=1.6)
bolt_kink  = 0.40   # fractal roughness (0.25 smooth, 0.4 jagged, >0.5 loops)
bolt_seg   = 2.8    # glow width multiplier (1=no glow, 4=heavy bloom)
