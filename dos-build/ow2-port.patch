+void AW_Distort(AGridPoint *AGP,float Bang)
+{
+  long I,J;
+  AGridPoint *GP = AGP;
+  float ratio = Bang/16384.0;
+  for(J=0;J<AGrid_Y;J++)
+    for(I=0;I<AGrid_X;I++)
+    {
+      GP->X += (rand()-16384)*ratio;
+      GP->Y += (rand()-16384)*ratio;
