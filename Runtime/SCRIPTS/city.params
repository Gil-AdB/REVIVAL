# City — per-scene scripted parameters (see docs/PARAM_SCRIPTS.md).
# Edit while the demo runs: the file hot-reloads on save, and deleting it
# restores the pre-script values. CLI/env-set flags always win over lines
# here. Times are scene Timer units (city runs 0..~2800).

# Fog: the froxel config tuned for city this session. bottom=0 keeps the
# slab above the waterline (negative bottom puts fog UNDER the water and
# brightens every water pixel).
fast_fog          = 1
fast_fog_blobs    = 1
fast_fog_worley   = 1
fast_fog_bottom   = 0
fast_fog_top      = 420
fast_fog_cell     = 500
fast_fog_glow_max = 300
fast_fog_inscatter = 3

# Density ramps over the timeline: roll in, hold, burn off near the end.
fast_fog_density @ 0    = 2
fast_fog_density @ 600  = 8
fast_fog_density @ 2200 = 8
fast_fog_density @ 2800 = 1
