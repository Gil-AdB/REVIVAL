+					Intersection2.Z-=Origin2.Z;
+					r=(sqrt(Intersection2.X*Intersection2.X+Intersection2.Y*Intersection2.Y+Intersection2.Z*Intersection2.Z)*32);
+					if (r>255.0) r=255.0;
+					r=255-r;
+					if (r<1.0) r=1;
+					b=r * 0.7;
+					g= r*0.8;
