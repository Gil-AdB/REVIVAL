// Single source of truth for FDS feature flags.
//
// Three macros, each with the same signature:
//   FDS_FLAG_BOOL (NAME, ENV, DEFAULT, CATEGORY, HELP)
//   FDS_FLAG_FLOAT(NAME, ENV, DEFAULT, CATEGORY, HELP)
//   FDS_FLAG_INT  (NAME, ENV, DEFAULT, CATEGORY, HELP)
//
// NAME    — C identifier; also the CLI form ("--<name>" / "--no-<name>" / "--<name>=value").
// ENV     — environment variable name (existing FDS_* names preserved).
// DEFAULT — compile-time default. Some defaults reference macros (FDS_*_DEFAULT_ON)
//           so the WASM build can flip them via -DFDS_DEFERRED_DEFAULT_ON=1.
// CATEGORY — short string used to group output of --help.
// HELP    — one-line description shown in --help.
//
// Adding a flag is a single line in this file.

// ─── engine ──────────────────────────────────────────────────────────────
FDS_FLAG_BOOL(param_scripts,            "FDS_PARAM_SCRIPTS",            1,                              "engine",   "Per-scene scripted parameters: load SCRIPTS/<scene>.params (relative to CWD) at scene start, apply its FeatureFlags values each frame (time-keyed lines lerp over the scene Timer), hot-reload on file change. CLI/env-set flags always win over the script. See docs/PARAM_SCRIPTS.md.")

FDS_FLAG_BOOL(profiler,                 "FDS_PROFILER",                 0,                              "engine",   "On-screen profiler overlay (per-section ms, FPS, polys/Mpx). Runtime equivalent of rev.cfg's ProfilerEnable (the cfg seeds this flag; CLI/script/tune-console can override either way, per frame).")
FDS_FLAG_BOOL(tune_server,              "FDS_TUNE_SERVER",              1,                              "engine",   "Live tuning console: embedded HTTP server (localhost only) serving a knob page over every FeatureFlag. Open http://localhost:<tune_port> while the demo runs; changes apply immediately with CLI precedence (param scripts yield); release buttons hand knobs back; copy buttons export CLI/.params lines.")
FDS_FLAG_INT(tune_port,                 "FDS_TUNE_PORT",                8666,                           "engine",   "Live tuning console port (see tune_server).")

// ─── deferred pipeline ───────────────────────────────────────────────────
FDS_FLAG_BOOL(deferred,                 "FDS_DEFERRED",                 FDS_DEFERRED_DEFAULT_ON,        "deferred", "Deferred G-buffer pipeline")
FDS_FLAG_BOOL(spot_cone_cull,           "FDS_SPOT_CONE_CULL",           1,                              "deferred", "Tile-vs-cone culling for spot lights in the per-tile light lists + volumetric cone pass. Range-sphere culling alone puts a narrow spot (disco beams: 4.5 deg, range 38) in nearly every tile while it lights almost none of it.")
FDS_FLAG_BOOL(cone_fine_tiles,          "FDS_CONE_FINE_TILES",          1,                              "deferred", "Volumetric cone pass uses the 12x8 lighting grid (96 tiles) instead of the coarse 6x4 (24). Same per-pixel work (byte-identical output — verified on conetest), but the cone-heavy tiles (disco/beam region) spread across 4x more work-stealing tasks -> less idle at the pass barrier (~8% off the greets central-room frame). HDR-safe (separate pass, runs after activation). Default on; set 0 for the legacy coarse 6x4.")
FDS_FLAG_BOOL(deferred_zcull,           "FDS_DEFERRED_ZCULL",           1,                              "deferred", "Cull G-buffer ROP writes against existing Z (default on)")
FDS_FLAG_BOOL(deferred_vec,             "FDS_DEFERRED_VEC",             0,                              "deferred", "SIMD lighting tile kernel (slower on arm64-via-simde)")
FDS_FLAG_BOOL(deferred_outer_vec,       "FDS_DEFERRED_OUTER_VEC",       0,                              "deferred", "Outer-vec kernel (8 px x 1 omni); when unset, falls back to Scene::PreferOuterVec")
FDS_FLAG_BOOL(deferred_checkerboard,    "FDS_DEFERRED_CHECKERBOARD",    0,                              "deferred", "Half-rate lighting on a checkerboard pattern")
FDS_FLAG_BOOL(deferred_quarter,         "FDS_DEFERRED_QUARTER",         0,                              "deferred", "Quarter-rate lighting (one of every 2x2 pixels)")
FDS_FLAG_BOOL(deferred_no_spec,         "FDS_DEFERRED_NO_SPEC",         0,                              "deferred", "Skip specular term in tile kernel")
FDS_FLAG_BOOL(deferred_unified_tbr,     "FDS_DEFERRED_UNIFIED_TBR",     1,                              "deferred", "Unified transparent + particle TBR. Default on — scenes without a TBR (city, greets) fall through to the legacy peel via the SBufferHead/NumTiles check in deferredUnifiedTbrEnabled().")
FDS_FLAG_INT  (xpar_peel_passes,        "FDS_XPAR_PEEL_PASSES",         1,                              "deferred", "Transparent depth-peel passes PER SIDE (front and back each), so total stacked layers = 2x this. Each pass peels one fragment farther than the last via a per-pixel peel floor, then composites it — fixes >2 overlapping transparents (nested fountain glass orbs sharing one mesh, stacked greets panels) that the single front/back peel drops. 1 = legacy 2-deep (byte-identical). Costs one extra transparent raster+composite pass per (mesh/clump, side) per increment; only transparent area pays.")
FDS_FLAG_BOOL(deferred_gloss_stats,     "FDS_DEFERRED_GLOSS_STATS",     0,                              "deferred", "Dump per-frame glossiness histogram")
FDS_FLAG_BOOL(deferred_tile_stats,      "FDS_DEFERRED_TILE_STATS",      0,                              "deferred", "Dump per-tile lighting cost stats")
FDS_FLAG_FLOAT(deferred_max_range,      "FDS_DEFERRED_MAX_RANGE",       0.0f,                           "deferred", "Optional Range cap used for culling only (0 = disabled)")

// ─── shadows ─────────────────────────────────────────────────────────────
FDS_FLAG_BOOL(shadows,                  "FDS_SHADOWS",                  FDS_SHADOWS_DEFAULT_ON,         "shadows",  "Shadow mapping (requires deferred)")
FDS_FLAG_BOOL(shadow_polyid,            "FDS_SHADOW_POLYID",            FDS_SHADOW_POLYID_DEFAULT_ON,   "shadows",  "Use PolyId equality test instead of depth comparison")
FDS_FLAG_BOOL(shadow_polyid_no_pcf,     "FDS_SHADOW_POLYID_NO_PCF",     0,                              "shadows",  "Disable 2x2 PCF for the PolyId cube path — use a single nearest-neighbor tap instead. Diagnostic: lets you see how much of the intra-mesh material-boundary darkening comes from PCF blurring the artifact across 4 taps vs being intrinsic to the matID-vs-receiver identity test. With PCF the artifact spreads ~2 px; without PCF it shrinks to a 1 px sharp transition (but doesn't go away).")
FDS_FLAG_BOOL(shadow_backface_cull,     "FDS_SHADOW_BACKFACE_CULL",     0,                              "shadows",  "Cull back-facing tris from shadow maps")
FDS_FLAG_BOOL(shadow_validate,          "FDS_SHADOW_VALIDATE",          0,                              "shadows",  "Capture clipper outputs outside the input triangle hull")
FDS_FLAG_BOOL(shadow_prof,              "FDS_SHADOW_PROF",              0,                              "shadows",  "Per-light shadow timing")
FDS_FLAG_BOOL(shadow_prof_cache,        "FDS_SHADOW_PROF_CACHE",        0,                              "shadows",  "Per-frame shadow-sample cache-line transition stats")
FDS_FLAG_BOOL(shadow_cone_cull,         "FDS_SHADOW_CONE_CULL",         0,                              "shadows",  "Mesh-bsphere-vs-spot-cone cull during shadow-pass Transform_Objects")
FDS_FLAG_BOOL(shadow_skip_animated,     "FDS_SHADOW_SKIP_ANIMATED",     0,                              "shadows",  "Static shadow bake: skip meshes whose Pos spline has more than one key. Off by default — many scenes (greets) have *every* mesh animated, so skipping would leave shadow maps empty. Enable when the scene has real static occluders + a separate dynamic pass for moving meshes.")
FDS_FLAG_BOOL(shadow_dynamic,           "FDS_SHADOW_DYNAMIC",           0,                              "shadows",  "Per-frame dynamic-mesh shadow pass. For each static omni, re-renders only animated meshes into a parallel dynamic shadow buffer; lighting kernel samples min(static, dynamic). Pair with --shadow-skip-animated so the static bake is dynamic-mesh-free. Off by default — costs an extra Transform_Objects + raster per static omni per frame.")
FDS_FLAG_FLOAT(shadow_fzp_mult,         "FDS_SHADOW_FZP_MULT",          3.0f,                           "shadows",  "Shadow camera FZP multiplier over light IRange")
FDS_FLAG_BOOL(shadow_gbuffer_overlap,   "FDS_SHADOW_GBUFFER_OVERLAP",   0,                              "shadows",  "Stage A: run the per-frame dynamic shadow bake (Render_DeferredShadowMaps) on its own orchestrator thread concurrently with the gbuffer fill, joining before deferred lighting. Off by default — validate with FDS_THREADS=1 byte-identity + the 12-concurrent-bench STEADY-count (TSan-blind race class) before defaulting on. See docs/THREADING_OVERLAP_PLAN.md.")
#if FDS_DEV
FDS_FLAG_BOOL(dump_shadowmap,           "FDS_DUMP_SHADOWMAP",           0,                              "shadows-dev", "[dev] Dump shadow map to PGM on first frame")
#endif
FDS_FLAG_INT(shadow_bias,               "FDS_SHADOW_BIAS",              512,                            "shadows",  "Constant Z bias for shadow comparison")
FDS_FLAG_INT(shadow_slope_bias,         "FDS_SHADOW_SLOPE_BIAS",        1024,                           "shadows",  "Slope-scale Z bias for shadow comparison")
FDS_FLAG_BOOL(shadow_lightmap,          "FDS_SHADOW_LIGHTMAP",          0,                              "shadows",  "Pre-bake per-face shadow factor for static omnis into TriMesh::staticShadowLM at scene init; deferred kernel reads the lightmap instead of doing a per-pixel cube-shadow tap on static meshes. Off by default — bake is opt-in until kernel hookup ships.")
FDS_FLAG_INT(shadow_lightmap_res,       "FDS_SHADOW_LIGHTMAP_RES",      16,                             "shadows",  "Per-face lightmap edge length N (atlas is N×N per face). Defaults to 16 → 256 texels/face/omni. Powers of two recommended.")
FDS_FLAG_INT(shadow_lightmap_viz,       "FDS_SHADOW_LIGHTMAP_VIZ",      0,                              "shadows",  "Debug viz mode: render lightmap data instead of normal lighting. 0 = off; 1 = lightmap meshLMId (greyscale, 0=red); 2 = faceIdx (color hash); 3 = bary s (red→green); 4 = bary t (red→blue); 5 = lightmap factor for omni 0 nearest-neighbor (greyscale); 9 = bary world delta: |interp(F.A/B/C->Pos, runtime bary) - pixel world from depth|. Green ≤0.1, yellow ≤0.5, orange ≤1.0, red >1.0. Tests whether bary points to the pixel's actual 3D position on F's plane.")
FDS_FLAG_BOOL(shadow_lightmap_recompute_bake, "FDS_SHADOW_LIGHTMAP_RECOMPUTE_BAKE", 0,                    "shadows",  "Debug: in resolveCubeAtten, skip the atlas bilinear lookup and call SampleStaticCubeAtWorld(pixelWorldPos) per pixel — same code the bake uses. Verifies the bake function matches CubeShadow_Sample. (Has been bit-perfect since the depth-compare bake landed.)")
FDS_FLAG_BOOL(shadow_lightmap_recompute_at_bary, "FDS_SHADOW_LIGHTMAP_RECOMPUTE_AT_BARY", 0,               "shadows",  "Debug: same as --shadow-lightmap-recompute-bake but sample at the world position the RUNTIME-STORED bary points to (interpolate face A/B/C world from the stamped sB/tB), not at the rendered pixel's world position. Mismatch with recompute-bake means the runtime bary doesn't correspond to the pixel's actual world position.")
FDS_FLAG_BOOL(shadow_lightmap_nearest,  "FDS_SHADOW_LIGHTMAP_NEAREST",  0,                              "shadows",  "Debug: use sampleNearest instead of sampleBilinear for the per-face atlas lookup. Helps separate bilinear cross-edge blend artifacts (then nearest gives crisp blocky shadow) from atlas-content artifacts (then nearest shows the same shape just sharper).")
FDS_FLAG_BOOL(shadow_lightmap_planar,   "FDS_SHADOW_LIGHTMAP_PLANAR",   0,                              "shadows",  "Bake + sample the per-face atlas in a world-axis-aligned planar projection (Quake/idTech trick) instead of the per-triangle (B-A, C-A) bary basis. Eliminates the sheared-lattice zig-zag on shadow edges that hits the bary atlas when the face isn't right-isoceles with axis-aligned legs. Picks the projection plane from the face's dominant cardinal axis (max |N.x/y/z|). Runtime sampler uses the pixel's world position instead of stamped bary.")

// ─── SoA vertex refactor (Phase 1+) ──────────────────────────────────────
FDS_FLAG_BOOL(soa_verify,               "FDS_SOA_VERIFY",               0,                              "soa",      "Verification: in Transform_Objects, after per-vertex transform, assert that the AoS-written and SoA-written values match bit-for-bit. ~free when off; quadratic-ish cost per vert when on. Default off; turn on during migration to catch drift between AoS and SoA write paths.")

// ─── rasterizer ──────────────────────────────────────────────────────────
FDS_FLAG_BOOL(rast_full_store,          "FDS_RAST_FULL_STORE",          1,                              "raster",   "When all 8 lanes of a tile row pass edge+Z, take a vector-store fast path. Mekalele: one wide store per G-buffer plane (normal/tangent/lightmapST/lightmapMF/shadowMatID) instead of an 8-lane scatter. ShadowBarry: direct compressed-Z store + broadcast polyId store instead of blendv RMW + per-lane scatter.")
FDS_FLAG_BOOL(rast_inside_template,     "FDS_RAST_INSIDE_TEMPLATE",     1,                              "raster",   "Mekalele rasterizer: dispatch apply_exact<true> for tiles the dispatcher proves are fully inside the triangle (conservative min_a/b/c test), eliding the per-row edge mask.")

// ─── sort ────────────────────────────────────────────────────────────────
FDS_FLAG_BOOL(no_sort,                  "FDS_NO_SORT",                  0,                              "sort",     "Bypass Radix_SortingASM — dispatch FList in transform order (correctness depends on the rasterizer being order-independent)")

// ─── transparency ────────────────────────────────────────────────────────
FDS_FLAG_BOOL(no_quad_sort,             "FDS_NO_QUAD_SORT",             0,                              "xpar",     "Skip quad reorder during sort")
FDS_FLAG_BOOL(xpar_force_twosided,      "FDS_XPAR_FORCE_TWOSIDED",      0,                              "xpar",     "Force transparent fills to be two-sided")
FDS_FLAG_BOOL(no_xpar_frontback,        "FDS_NO_XPAR_FRONTBACK",        0,                              "xpar",     "Skip front/back separation for two-sided xpar")
FDS_FLAG_BOOL(no_xpar_objgroup,         "FDS_NO_XPAR_OBJGROUP",         0,                              "xpar",     "Skip per-object grouping of xpar faces")
FDS_FLAG_BOOL(xpar_light_all,           "FDS_XPAR_LIGHT_ALL",           0,                              "xpar",     "Run every omni on every xpar pixel (vs per-strip)")
#if FDS_DEV
FDS_FLAG_BOOL(debug_xpar_ids,           "FDS_DEBUG_XPAR_IDS",           0,                              "xpar-dev", "[dev] Colorize transparent fills by object id")
FDS_FLAG_FLOAT(debug_xpar_min_area,     "FDS_DEBUG_XPAR_MIN_AREA",      0.0f,                           "xpar-dev", "[dev] Min triangle area for xpar debug coloring")
#endif

// ─── profiling ablation gates ────────────────────────────────────────────
FDS_FLAG_BOOL(prof_no_tex,              "FDS_PROF_NO_TEX",              0,                              "prof",     "Skip texture sample in deferred kernel")
FDS_FLAG_BOOL(prof_no_lights,           "FDS_PROF_NO_LIGHTS",           0,                              "prof",     "Skip omni loop in deferred kernel")
FDS_FLAG_BOOL(prof_no_spec,             "FDS_PROF_NO_SPEC",             0,                              "prof",     "Skip specular in deferred kernel")
FDS_FLAG_BOOL(prof_no_fog,              "FDS_PROF_NO_FOG",              0,                              "prof",     "Skip fog pass")
FDS_FLAG_BOOL(prof_no_cube_tap,         "FDS_PROF_NO_CUBE_TAP",         0,                              "prof",     "Diagnostic: skip the per-pixel cube-shadow tap in the deferred lighting kernel — resolveCubeAtten short-circuits to 1.0 (fully lit). Lets you measure how much of the receiver-side shadow cost is the tap itself vs the surrounding lighting math. Does NOT skip the shadow render (cube bake); only the runtime sample.")
FDS_FLAG_FLOAT(quarter_normal_cos,      "FDS_QUARTER_NORMAL_COS",       0.95f,                          "deferred", "Quarter-rate fill: minimum dot(N_center, N_neighbor) for the neighbor's shaded value to be averaged in. Wave-2 currently only checks matID equality; that misses curved surfaces (same hull material, different normals → different shading) and creates the cartoonish look on the robot. Threshold ~0.95 ≈ 18°. Lower → softer (more averaging, more artifacts). Set to 0 to disable the check entirely (legacy behavior).")
FDS_FLAG_FLOAT(quarter_z_jump,          "FDS_QUARTER_Z_JUMP",           0.04f,                          "deferred", "Quarter-rate fill: maximum |zEnc_center - zEnc_neighbor| / zEnc_center accepted before falling back to full shading. Detects silhouettes / material creases (which produce sharp depth steps even when both sides share matID and normal). Default 0.04 ≈ 4% relative depth change. 0 disables the check.")
FDS_FLAG_INT(nmap_lod_fade_start,       "FDS_NMAP_LOD_FADE_START",      2,                              "deferred", "Normal map LOD fade: the miplevel at which bump strength FIRES — at this mip the bump is already scaled by (1 - step). Below this mip, full bump (1.0). Above, drops by step per mip until 0. At distance the texture mip chain averages cleanly, but the normal map's per-mip averaged direction has shorter length → bump becomes high-frequency lighting noise. Set to a very high value (e.g. 16) to disable the fade. Use --nmap-lod-fade-start=0 --nmap-lod-fade-step=1 to fully disable the bump everywhere (useful to verify the path is firing).")
FDS_FLAG_FLOAT(nmap_lod_fade_step,      "FDS_NMAP_LOD_FADE_STEP",       0.33f,                          "deferred", "Normal map LOD fade rate per miplevel past --nmap-lod-fade-start. 0.33 → bump fades to zero over 3 mip levels. Lower = gentler fade.")

// ─── normals / textures ──────────────────────────────────────────────────
FDS_FLAG_BOOL(no_nmap,                  "FDS_NO_NMAP",                  0,                              "nmap",     "Force flat normals everywhere")
FDS_FLAG_FLOAT(nmap_strength,           "FDS_NMAP_STRENGTH",            1.5f,                           "nmap",     "Sobel-bake strength: higher = more pronounced bump")
FDS_FLAG_INT(nmap_blur,                 "FDS_NMAP_BLUR",                4,                              "nmap",     "Box-blur passes (3x3) applied to luminance before Sobel (0 = no blur)")
#if FDS_DEV
FDS_FLAG_BOOL(nmap_from_diffuse,        "FDS_NMAP_FROM_DIFFUSE",        0,                              "nmap-dev", "[dev] Derive normal map from diffuse")
FDS_FLAG_BOOL(viz_tangent,              "FDS_VIZ_TANGENT",              0,                              "nmap-dev", "[dev] Visualize per-pixel view-space tangent as diffuse color")
FDS_FLAG_BOOL(viz_normal,               "FDS_VIZ_NORMAL",               0,                              "nmap-dev", "[dev] Visualize per-pixel view-space normal as diffuse color (POST normal-map perturbation)")
FDS_FLAG_BOOL(viz_geonormal,            "FDS_VIZ_GEONORMAL",            0,                              "nmap-dev", "[dev] Visualize per-pixel GEOMETRY normal (the vertex-interpolated normal BEFORE the normal map perturbs it) as diffuse colour. A flat wall should be ONE solid colour; any variation (e.g. a diagonal kink along a quad's triangle split) is the geometry-normal interpolation. Pair with --viz-tangent to separate a normal crease from a tangent crease.")
FDS_FLAG_BOOL(viz_matid,                "FDS_VIZ_MATID",                0,                              "nmap-dev", "[dev] Visualize per-pixel matID as a deterministic colour (8-bit id hashed to BGRA) so you can see which face won z at each pixel. Use to verify reflected-floor pixels are actually the floor clone (and not some other face that happens to z-fight there).")
FDS_FLAG_BOOL(viz_pmid,                 "FDS_VIZ_PMID",                 0,                              "nmap-dev", "[dev] Visualize per-pixel mirror id (gb.mirrorId post-commit) as a deterministic colour. Distinct from --viz-matid because original + clone faces share material/matID — pmid is the only way to tell them apart per pixel.")
FDS_FLAG_BOOL(nmap_as_diffuse,          "FDS_NMAP_AS_DIFFUSE",          0,                              "nmap-dev", "[dev] Paint baked normal map directly as diffuse — confirms swizzle round-trip")
#endif

// ─── display / present ───────────────────────────────────────────────────
FDS_FLAG_BOOL(no_vsync,                 "FDS_NO_VSYNC",                 0,                              "display",  "Disable SDL_RENDERER_PRESENTVSYNC — lets SDL_RenderPresent return immediately for benching real flip cost")

// ─── volumetric / atmospheric ────────────────────────────────────────────
FDS_FLAG_BOOL(draw_cones,               "FDS_DRAW_CONES",               0,                              "atmos",    "Draw volumetric spotlight cones (additive). Off by default; scene driver opts in.")
FDS_FLAG_BOOL(city_test_spots,          "FDS_CITY_TEST_SPOTS",          0,                              "atmos",    "Install 6 test spotlights in city for cone-overlay experimentation")
FDS_FLAG_FLOAT(cone_strength,           "FDS_CONE_STRENGTH",            0.05f,                          "atmos",    "Volumetric cone density (per-step contribution × 1e-3). 0.05 = subtle shafts, 0.5 = pea-soup fog")
FDS_FLAG_BOOL(volumetric_unified,       "FDS_VOLUMETRIC_UNIFIED",       0,                              "atmos",    "Use unified Beer-Lambert volumetric pass (replaces separate fog + cone passes; adds omni halos)")
FDS_FLAG_FLOAT(fog_sigma_mult,          "FDS_FOG_SIGMA_MULT",           3.0f,                           "atmos",    "Beer-Lambert extinction coefficient as multiple of 1/FZP. σ=mult/FZP → T(FZP)=exp(-mult). Default 3 = ~5% transmittance at FZP")
FDS_FLAG_FLOAT(omni_halo_strength,      "FDS_OMNI_HALO_STRENGTH",       0.0f,                           "atmos",    "Volumetric halo brightness scale for omnis (0 = no halos; 0.05 = subtle; 0.5 = strong). Runs in both unified and legacy pipelines (Render_OmniHalos standalone pass).")
FDS_FLAG_FLOAT(omni_halo_range_mult,    "FDS_OMNI_HALO_RANGE_MULT",     1.0f,                           "atmos",    "Global multiplier on every Omni's halo sphere radius (multiplies HaloRange when set, IRange otherwise). 1 = no change; use to scale halo footprints across a scene without editing every light.")
FDS_FLAG_FLOAT(omni_halo_force_range,   "FDS_OMNI_HALO_FORCE_RANGE",    0.0f,                           "atmos",    "Hard override: when > 0, every Omni's halo radius is forced to this value, ignoring IRange / HaloRange / omni_halo_range_mult. Cleanest way to tune halo footprints without compounding per-light settings.")
FDS_FLAG_BOOL(vol_prof,                 "FDS_VOL_PROF",                 0,                              "atmos",    "Per-frame timing for volumetric passes (cones/halos/unified). Prints averaged ms every FDS_VOL_PROF_INTERVAL frames.")
FDS_FLAG_INT(vol_n_samples,             "FDS_VOL_N_SAMPLES",            4,                              "atmos",    "Samples per pixel for volumetric ray-march. Lower = faster but noisier; 4 default (2× faster than 8 with only √2 more noise — best perf/quality knee per profiling).")
FDS_FLAG_BOOL(vol_cone_half_y,          "FDS_VOL_CONE_HALF_Y",          0,                              "atmos",    "Volumetric cone pass at half VERTICAL rate (even rows computed, written to both rows). Halves the pass cost but thins narrow beams — the 1-2px bright core line can fall between sampled rows (user-observed). Off by default; available for wide-cone scenes.")
FDS_FLAG_BOOL(vol_vec,                  "FDS_VOL_VEC",                  1,                              "atmos",    "Vectorize the per-sample inner loop in the cone/halo/unified passes (8-wide SIMD). Default on; --no-vol_vec falls back to scalar for A/B.")
FDS_FLAG_BOOL(vol_rect_cull,            "FDS_VOL_RECT_CULL",            1,                              "atmos",    "Per-batch (vec) / per-pixel (scalar) screen-rect cull in the cone tile fn. Skips the per-spot quadratic when the pixel/batch falls outside the spot's cone-bbox screen projection. Default on; --no-vol_rect_cull disables for A/B.")
FDS_FLAG_BOOL(vol_halo_analytic,        "FDS_VOL_HALO_ANALYTIC",        1,                              "atmos",    "Replace the halo per-sample ray-march with a closed-form arctan integral. Drops the (1-d/r)² near-edge softness (sharper boundary) but is ~8 ops/pixel vs N×30 ops. Default on; --no-vol_halo_analytic falls back to N-sample ray-march.")
FDS_FLAG_BOOL(vol_cone_analytic,        "FDS_VOL_CONE_ANALYTIC",        1,                              "atmos",    "Spotlight equivalent of vol_halo_analytic: closed-form arctan integral over the cone-clipped segment [zLo,zHi], coneAtten approximated at midpoint. Falls back to ray-march for shadow-casting spots (shadow lookup can't be integrated analytically). Default on.")
FDS_FLAG_FLOAT(vol_analytic_noise,      "FDS_VOL_ANALYTIC_NOISE",       0.08f,                          "atmos",    "Per-pixel multiplicative jitter strength applied to analytic halo / cone results. 0 = silky smooth analytic gradient; 0.08 = subtle dither matching ray-march visual noise; 0.2+ = heavy grain. Hashed from pixel coords so it's stable frame-to-frame.")
FDS_FLAG_BOOL(deferred_skybox,          "FDS_DEFERRED_SKYBOX",          0,                              "atmos",    "Skybox-from-G-buffer pass. Paints pixels with zEnc==0 (no surface) by reconstructing view ray + sampling the sky cube. Off by default until visually validated. When on, the forward RenderSkyCube becomes redundant (perf win pending separate suppression).")
FDS_FLAG_BOOL(fast_fog,                 "FDS_FAST_FOG",                 0,                              "atmos",    "Analytic exponential fog post-pass (iquilezles model) that composes with the analytic cone/halo passes. Independent of Scn_Fogged so it can be toggled on clear scenes (city). Mixes pixels toward the scene Ambient color by 1-exp(-tau).")
FDS_FLAG_FLOAT(fast_fog_density,        "FDS_FAST_FOG_DENSITY",         3.0f,                           "atmos",    "fast_fog extinction as a multiple of 1/FZP: sigma = density/FZP. At the far plane tau~=density, so 3 => ~95% fogged. Higher = thicker.")
FDS_FLAG_FLOAT(fast_fog_height,         "FDS_FAST_FOG_HEIGHT",          0.0f,                           "atmos",    "fast_fog height falloff k in 1/world-units. 0 = uniform density. >0 = denser at low altitude (ground thickest), density(y) ~ exp(-k*y). Try ~1/(scene height) e.g. 0.0005 in city.")
FDS_FLAG_FLOAT(fast_fog_bottom,         "FDS_FAST_FOG_BOTTOM",          -1.0e9f,                        "atmos",    "fast_fog slab BOTTOM in world Y. Fog only fills the ray segment between bottom and top, so it reads as a bounded mass floating in the air rather than tinting every surface. Default -1e9 = no floor (unbounded below).")
FDS_FLAG_FLOAT(fast_fog_top,            "FDS_FAST_FOG_TOP",             1.0e9f,                         "atmos",    "fast_fog slab TOP in world Y. Set finite (e.g. 1000 in city) to cap the fog layer so building tops emerge above a discrete bank. Default 1e9 = no ceiling (unbounded above).")
FDS_FLAG_FLOAT(fast_fog_feather,        "FDS_FAST_FOG_FEATHER",         0.0f,                           "atmos",    "Softens the slab's top/bottom Y-cutoff over this many world units (smoothstep ramp) so the boundary doesn't show a razor-sharp horizontal line at grazing view angles. 0 = auto (20%% of slab thickness). Set explicit for tighter/softer edges.")
FDS_FLAG_BOOL(fast_fog_blobs,           "FDS_FAST_FOG_BLOBS",           0,                              "atmos",    "Fill the fog slab with procedurally-scattered blobs (one jittered sphere per world grid cell, closed-form cubic density per blob, 3D-DDA along the ray). Turns the smooth slab into a lumpy volumetric mass. Off = smooth slab.")
FDS_FLAG_FLOAT(fast_fog_cell,           "FDS_FAST_FOG_CELL",            400.0f,                         "atmos",    "Blob grid cell size in world units (= blob diameter). Smaller = finer, lumpier fog but more DDA cells/ray. Try ~1/4 of the slab horizontal extent.")
FDS_FLAG_FLOAT(fast_fog_blob_jitter,    "FDS_FAST_FOG_BLOB_JITTER",     0.35f,                          "atmos",    "Per-cell blob center jitter as a fraction of the cell size (0 = regular lattice, 0.5 = blobs can sit on cell faces). Breaks up the grid regularity.")
FDS_FLAG_BOOL(fast_fog_worley,          "FDS_FAST_FOG_WORLEY",          0,                              "atmos",    "Froxel blob field uses inverted Worley F1 (distance to the nearest jittered per-cell feature point) instead of trilinear value noise: density peaks AT scattered points and falls off radially, so fog reads as puffy rounded cloud masses instead of caustic-like veins. Size-modulated by a large-scale value-noise octave so puffs vary instead of forming a polka-dot lattice. Froxel path only; ~27 cell hashes per sample vs 8 (costs more).")
FDS_FLAG_FLOAT(fast_fog_worley_thresh,  "FDS_FAST_FOG_WORLEY_THRESH",   0.5f,                           "atmos",    "Worley puff cutoff: density reaches 0 at F1 = (1 - thresh) cells from a feature point. Higher = smaller, more separated puffs with clear air between (0.5 -> puff radius half a cell); lower = fatter merging masses. Range ~0.2-0.7.")
FDS_FLAG_FLOAT(fast_fog_blob_overlap,   "FDS_FAST_FOG_BLOB_OVERLAP",    0.0f,                           "atmos",    "Metaball-style ADDITIVE blob field (overrides worley/value noise when > 0): each cell's jittered blob contributes (1-(d/R)^2)^2 and overlapping blobs SUM, so density piles up where they stack - the 'lots of overlapping big blobs' cloud look that inverted-Worley F1 cannot express (nearest-distance is bounded; bigger radii just fill space uniformly). Value = blob radius in CELL units: 0.7 = separated puffs, 1.0 = touching, 1.2-1.5 = overlapping cloud masses (capped at 1.5, the 3x3x3 search limit). fast_fog_cell stays the spacing knob; this decouples size from spacing. fast_fog_worley_thresh is reused as the iso-threshold (where fog begins out of the summed field).")
FDS_FLAG_FLOAT(fast_fog_falloff,        "FDS_FAST_FOG_FALLOFF",         0.0f,                           "atmos",    "Distance (world units) over which fog density e-folds with view distance: density *= exp(-z/falloff). Makes fog a near-camera mass that thins out far away instead of forming a wall at the far plane. 0 = auto (= scene FZP). Smaller = tighter, closer fog.")
FDS_FLAG_BOOL(fast_fog_froxel,          "FDS_FAST_FOG_FROXEL",          1,                              "atmos",    "Froxel (view-frustum 3D grid) volumetric fog — THE fast_fog renderer. Populates density+in-scatter per froxel, integrates front-to-back along depth, trilinearly composites; temporal supersampling, distance-LOD, worley/metaball fields, glow compression and xpar fog all live on this path. Volumetric by construction (fog fills air, not painted on surfaces), no grazing speckle, cost decoupled from screen resolution. --no-fast_fog_froxel falls back to the LEGACY screen-space per-pixel march (value-noise only, glow speckles at grazing angles, saturates at high inscatter) — kept for A/B reference.")
FDS_FLAG_INT(fast_fog_froxel_x,         "FDS_FAST_FOG_FROXEL_X",        256,                            "atmos",    "Froxel grid width (columns). Coarse is fine — fog is low-frequency and the composite trilinearly upsamples.")
FDS_FLAG_INT(fast_fog_froxel_y,         "FDS_FAST_FOG_FROXEL_Y",        144,                             "atmos",    "Froxel grid height (rows).")
FDS_FLAG_INT(fast_fog_froxel_z,         "FDS_FAST_FOG_FROXEL_Z",        64,                            "atmos",    "Froxel grid depth slices (camera to fog far). More = finer depth resolution / less near-camera banding.")
FDS_FLAG_BOOL(fast_fog_froxel_temporal, "FDS_FAST_FOG_FROXEL_TEMPORAL", 1,                             "atmos",    "Temporal supersampling of the froxel grid: jitter the per-froxel sample position each frame (Halton 2/3/5), reproject each froxel's center into the previous frame's grid and blend the history in. Averages 8 sub-froxel positions over time, dissolving the XY stair/blockiness of the coarse grid without raising its resolution. Costs one history fetch per froxel; moving lights can show slight glow lag (lower fast_fog_froxel_blend if so).")
FDS_FLAG_BOOL(rain,                     "FDS_RAIN",                     0,                             "atmos",    "Screen-space rain: procedural streaks composited as a tile-parallel post pass (3 depth layers with parallax, z-buffer occluded, attenuated by the froxel/SS fog at each layer's depth, sinusoidal wind gusts). Works in any scene with a z-buffer; scene time drives the fall so pause freezes it. Read per frame - scriptable (e.g. ramp a storm in via SCRIPTS/<scene>.params).")
FDS_FLAG_FLOAT(rain_intensity,          "FDS_RAIN_INTENSITY",           1.0f,                          "atmos",    "Screen-space rain amount: scales streak density and opacity (0 = none, 1 = steady rain, 2+ = downpour). Per-frame / scriptable.")
FDS_FLAG_FLOAT(rain_speed,              "FDS_RAIN_SPEED",               1.0f,                          "atmos",    "Screen-space rain fall speed multiplier. Per-frame / scriptable.")
FDS_FLAG_BOOL(fast_fog_refl_depth,      "FDS_FAST_FOG_REFL_DEPTH",      1,                             "atmos",    "Fog the water's reflections at their MIRRORED path length (pass-1 Z, displaced through the wobble) instead of uniformly at the fog far plane — near buildings stay crisp in the mirror, far ones drown, matching the world above the waterline. City only (the scene hands the engine its reflection Z).")
FDS_FLAG_FLOAT(bolt_width,              "FDS_BOLT_WIDTH",               0.85f,                          "scene",    "Fountain lightning CORE ribbon half-width factor (px = POW * this * RZ * FOVX). Thin=0.8, fat=2.5. Per-strike / scriptable (SCRIPTS/fountain.params hot-reloads).")
FDS_FLAG_FLOAT(bolt_kink,               "FDS_BOLT_KINK",                0.30f,                         "scene",    "Fountain lightning texture ROUGHNESS: midpoint-displacement amplitude of the baked bolt texture (fraction of width). ~0.18 smooth, ~0.3 jagged, >0.4 wild. Changing it re-bakes the texture set (live, slight hitch).")
FDS_FLAG_FLOAT(bolt_seg,                "FDS_BOLT_SEG",                 1.0f,                          "scene",    "Fountain lightning BRIGHTNESS multiplier (additive). 1=default, <1 dimmer, >1 hotter/blown. Live / scriptable.")
FDS_FLAG_BOOL (bolt_geom,               "FDS_BOLT_GEOM",                1,                              "scene",    "Fountain lightning glow rendering: 1 = fully geometric untextured additive Gouraud ribbon (default — no texture bake/sample, clean at any zoom and at screen edges/forks), 0 = baked bilinear texture quad. Both share the geometric AA core line.")
FDS_FLAG_FLOAT(bolt_interval,           "FDS_BOLT_INTERVAL",            220.0f,                         "scene",    "Fountain lightning strike cadence in Timer units (smaller = more frequent strikes). Strikes fire periodically from the first scripted time through the scene at random spires; deterministic per index so it stays scrub-safe. ~120 = frantic, ~500 = sparse.")
FDS_FLAG_FLOAT(bolt_flash_peak,         "FDS_BOLT_FLASH_PEAK",          500.0f,                         "scene",    "Fountain strike-flash light ISize at full intensity (lights the froxel fog + nearby geometry). Keep it mostly BELOW --fast_fog_glow_max so the fog's 1/d^2 falloff shows (bright halo at the strike, dark away) instead of a flat bright wash that hides the bolt. 0 = no flash light.")
FDS_FLAG_FLOAT(bolt_flash_range,        "FDS_BOLT_FLASH_RANGE",         500.0f,                         "scene",    "Fountain strike-flash light reach in world units. Smaller = tighter halo around the bolt; larger spreads it across more fog (too large = whole-screen wash).")
FDS_FLAG_FLOAT(bolt_flash_decay,        "FDS_BOLT_FLASH_DECAY",         0.10f,                          "scene",    "Fountain strike-flash decay rate: intensity *= exp(-dTime*this) per frame. Larger = shorter/snappier flash (~0.05 ≈ a few frames); smaller = lingers.")
FDS_FLAG_BOOL(rain_lens,                "FDS_RAIN_LENS",                1,                             "atmos",    "On-camera droplets while --rain is active: refracting discs that stick to the 'lens', dwell, then trickle down and shrink. Spawn rate follows rain_intensity; scene time drives the motion (pause freezes). Deterministic (hash-seeded, no rand).")
FDS_FLAG_BOOL(city_rain,                "FDS_CITY_RAIN",                0,                             "scene",    "The 1998 city rain: 3000 camera-tracking drops (1px + transparent motion trail), sinusoidal wind gusts, spline-lookahead respawn. Read once at scene init (allocates the particle pool) — CLI/env only, not hot-scriptable.")
FDS_FLAG_BOOL(city_headlights,          "FDS_CITY_HEADLIGHTS",          1,                             "scene",    "Vehicle headlight beams in the city: every path-following mesh (the ships) gets a warm spotlight welded to its nose, aimed along its motion heading. Volumetric beams when --draw_cones is on; surface lighting always. Scriptable per-frame (city.params).")
FDS_FLAG_FLOAT(city_headlight_intensity,"FDS_CITY_HEADLIGHT_INTENSITY", 1.2f,                          "scene",    "Headlight beam intensity (spot ISize). 0 also disables; ~2-4 reads well against the streetlights.")
FDS_FLAG_INT(fast_fog_froxel_taps,      "FDS_FAST_FOG_FROXEL_TAPS",     1,                             "atmos",    "Density samples per froxel per frame when temporal is on (1 or 2). 2 averages two opposite phases of the jitter cycle each frame — halves the temporal cycle's amplitude and doubles convergence, for roughly double the noise-field cost in foggy froxels. Diagnostic / quality knob for residual fog shimmer.")
FDS_FLAG_FLOAT(fast_fog_froxel_blend,   "FDS_FAST_FOG_FROXEL_BLEND",    0.9f,                          "atmos",    "Temporal history weight (0..0.95): new froxel value = lerp(current, history, blend). The jitter cycle's residual flicker scales with (1-blend), so HIGHER = LESS shimmer (camera motion is handled by reprojection, not by this); the cost of high values is fog/glow response lag (~1/(1-blend) frames). Lower = more responsive but more shimmer; 0 disables blending (jitter then shows as raw per-frame noise).")
FDS_FLAG_BOOL(fast_fog_xpar,            "FDS_FAST_FOG_XPAR",            1,                             "atmos",    "Fog the transparent peel from the froxel grid: each transparent pixel's lit color becomes lit*T(z) + inscatter(z) at ITS OWN depth before the alpha blend (out = a*(C*T+acc) + (1-a)*Bg — exact under the froxel model, one trilinear grid sample per transparent pixel). Off = transparents keep the legacy per-light sqrt ramp (no aerial perspective on water/glass).")
FDS_FLAG_INT(fast_fog_glow_grid_div,    "FDS_FAST_FOG_GLOW_GRID_DIV",   4,                             "atmos",    "Froxel glow (light in-scatter radiance) is evaluated on an XY grid this many times coarser than the fog grid (full z resolution) and bilinearly upsampled - light radiance is low-frequency in XY, and this divides the per-light glow cost (the #1 froxel cost in many-light scenes: 30-omni city glow ~26ms -> ~1.6ms at div=4) by div^2. 1 = exact per-column glow (the A/B reference). Softens shadow boundaries INSIDE fog glow by ~div fine froxels; surface shadows unaffected.")
FDS_FLAG_FLOAT(fast_fog_glow_max,       "FDS_FAST_FOG_GLOW_MAX",        0.0f,                          "atmos",    "Soft-knee compressor for the froxel fog's per-slice in-scatter radiance (8-bit output units): EXACTLY linear below half this value, then compressed, asymptotically approaching it — tames the white-clipping cores near lamps (radial kernel peaks ~20x, times fast_fog_inscatter) WITHOUT dimming the glow's dim reaches or touching density/extinction. Hue-preserving (max-channel scaled). 0 = off. Try ~250-400; lower = flatter glow, higher = only the hottest cores compressed. Reduce fast_fog_inscatter instead if you want the WHOLE glow dimmer.")
FDS_FLAG_BOOL(fast_fog_halfres,         "FDS_FAST_FOG_HALFRES",         1,                              "atmos",    "Compute fast_fog at half resolution and bilaterally (depth-weighted) upsample. Fog is low-frequency so the quality cost is tiny; ~4x cheaper, makes the blob field affordable. --no-fast_fog_halfres for full-res.")
FDS_FLAG_BOOL(fast_fog_adaptive,        "FDS_FAST_FOG_ADAPTIVE",        0,                              "atmos",    "Hierarchical fast_fog: compute on a coarse grid (fast_fog_adaptive_step), interpolate where neighbouring coarse samples agree, recompute per-pixel only where they disagree (occluder/shadow/depth edges). Cheaper than half-res in smooth regions, full-res-sharp at edges. Overrides fast_fog_halfres when set.")
FDS_FLAG_INT(fast_fog_adaptive_step,    "FDS_FAST_FOG_ADAPTIVE_STEP",   4,                              "atmos",    "Coarse-grid spacing (pixels) for fast_fog_adaptive. 4 = compute 1/16 of pixels then refine. Larger = cheaper base but more refinement at edges.")
FDS_FLAG_FLOAT(fast_fog_adaptive_thresh,"FDS_FAST_FOG_ADAPTIVE_THRESH", 0.06f,                          "atmos",    "Adaptive refine trigger: if the 2x2 coarse fog-amount spread exceeds this (or depth disagrees), recompute the pixel exactly instead of interpolating. Lower = more recompute (sharper, slower).")
FDS_FLAG_FLOAT(fast_fog_inscatter,      "FDS_FAST_FOG_INSCATTER",       0.0f,                           "atmos",    "In-scatter glow: brightness scale for scene lights (omnis/spots) lighting the fog medium, so fog blooms around lamps. Integrated along the fog segment (fast_fog_inscatter_samples points), scaled by fog amount. 0 = off (fog only occludes toward Ambient). Try 0.3-1.0.")
FDS_FLAG_BOOL(fast_fog_inscatter_analytic,"FDS_FAST_FOG_INSCATTER_ANALYTIC",1,                          "atmos",    "Integrate the in-scatter glow in closed form (arctan integral of the 1/dist^2 radial kernel over the fog segment, cone/edge factors at the segment's closest-approach point) instead of point sampling. Matches vol_cone_analytic/vol_halo_analytic. Shadow-casting spots can't be integrated (per-sample shadow tap) so they fall back to fast_fog_inscatter_samples point sampling. Default on; --no-fast_fog_inscatter_analytic forces sampling for all lights.")
FDS_FLAG_INT(fast_fog_inscatter_samples,"FDS_FAST_FOG_INSCATTER_SAMPLES",6,                             "atmos",    "Stratified samples used to integrate in-scatter for lights the analytic path can't handle (shadow-casting spots), or for all lights when --no-fast_fog_inscatter_analytic. 1 = the old single-midpoint sample, which resonates with the lamp's 1/dist^2 near-field and prints a bright disc/shell. >=4 converges to the smooth finite integral. 6 is a good quality/cost balance.")
FDS_FLAG_BOOL(fast_fog_inscatter_jitter,"FDS_FAST_FOG_INSCATTER_JITTER", 0,                             "atmos",    "Per-pixel interleaved-gradient-noise sample-offset for the sampled in-scatter integral. Default OFF: with the analytic path on, the shadowed integral is importance-sampled by the radial CDF so its summand (cutoff*cone * PCF-visibility) is smooth — centered samples are already terrace-free and pattern-free, so jitter only ADDS a visible weave. Turn ON only for the brute-force path (--no-fast_fog_inscatter_analytic), where uniform samples of the 1/dist^2 spike + binary shadow DO terrace without it.")
FDS_FLAG_BOOL(fast_fog_shadow_analytic, "FDS_FAST_FOG_SHADOW_ANALYTIC", 0,                             "atmos",    "Analytic shadowed in-scatter: bisect the shadow map for lit/shadowed transitions, sum the analytic radial integral over lit sub-intervals (cutoff^2*cone pinned per interval at clamp(z*,a,b)). Exact for fully-lit/convex; an approximation in bright partially-shadowed regions, and no faster here (path is compute-bound, not shadow-tap-bound). Experimental A/B; default off.")
FDS_FLAG_BOOL(fast_fog_shadow_earlyout, "FDS_FAST_FOG_SHADOW_EARLYOUT", 1,                             "atmos",    "Fully-lit early-out for the shadowed in-scatter: probe PCF visibility at z* and 5 points across the segment; if all read fully lit, skip the per-sample integral and use the analytic brightness. Wins in LIT-heavy views (most of the cone unoccluded); a wash in shadow-heavy views (the probes just add cost to penumbra pixels that still loop), and can slightly over-brighten a thin shadow that falls between probes (~3 levels). Default on; --no-fast_fog_shadow_earlyout for the exact per-pixel integral everywhere.")
FDS_FLAG_INT(fast_fog_shadow_pcf,       "FDS_FAST_FOG_SHADOW_PCF",      1,                              "atmos",    "PCF radius (shadow-map texels) for the sampled in-scatter shadow tap. 0 = single binary tap (hard edge -> the lit-sample count steps by 1 across neighbours, printing ns horizontal terraces unless ns is huge). 1 = 3x3 box -> fractional visibility -> soft penumbra that reads smooth at low fast_fog_inscatter_samples. 2 = 5x5 (softer/slower). Cost is (2r+1)^2 depth taps per in-scatter sample, so only the shadowed-spot path pays it.")
FDS_FLAG_FLOAT(fast_fog_dither,         "FDS_FAST_FOG_DITHER",          1.0f,                           "atmos",    "Triangular dither amplitude (in 8-bit levels) added to the fog composite to break up the contour banding that 8-bit output quantization gives on smooth low-contrast fog gradients. 0 = off. 1.0 = ~+-1 level, enough to dissolve bands. The banding is NOT from fastPow2 (verified: std::exp bands identically).")

// ─── Cinematic preset ─────────────────────────────────────────────────────
FDS_FLAG_BOOL (cinematic,               "FDS_CINEMATIC",                0,                              "atmos",    "Cinematic preset: each scene turns on HDR + hdr_linear + sane bloom + the filmic post stack (anamorphic, chromatic aberration, vignette, colour grade, film grain) at a PER-SCENE exposure tuned so nothing blows out (bright water scenes get low exposure, dark scenes high). Applied via setDefault in each scene's factory, so any individual --flag you pass still overrides it. Does NOT enable deferred_quarter (greets keeps that to itself). Greets keeps its own hotter HDR/bloom and just gains the post stack.")

// ─── HDR (prototype, docs/fountain_hdr_plan.md) ───────────────────────────
FDS_FLAG_BOOL (hdr,                     "FDS_HDR",                      0,                              "atmos",    "HDR prototype: deferred passes accumulate unclamped radiance into an f32 buffer, then a tonemap pass maps it to the 8-bit framebuffer instead of clamping per-pass (replaces the glowMax soft-knee). Lets additive glow/fog/flash roll off instead of clipping to white. Fountain-first; no-op until the deferred writes are wired (Phase 1).")
FDS_FLAG_FLOAT(hdr_exposure,            "FDS_HDR_EXPOSURE",             1.0f,                           "atmos",    "HDR exposure multiplier applied before the tonemap. 1.0 = neutral; raise to brighten, lower to darken before the highlight roll-off.")
FDS_FLAG_FLOAT(hdr_white,               "FDS_HDR_WHITE",                1.0f,                           "atmos",    "HDR post-tonemap chroma scale: 1.0 = neutral (ACES filmic's own highlight desaturation only); <1 pulls colors toward the tonemapped luminance (less saturated, e.g. 0.8 to tame neon glow); >1 boosts saturation. Applied after the ACES curve.")
FDS_FLAG_FLOAT(hdr_glow_scale,          "FDS_HDR_GLOW_SCALE",           0.25f,                          "atmos",    "HDR auto-compensation: glow inputs tuned against glowMax's cap (fast_fog_inscatter, bolt_flash_peak, cone_strength) run hot once --hdr disables that cap, so in HDR mode they're scaled by this factor. Lets the glowMax-tuned flags Just Work under --hdr instead of hand-dividing each. ~0.25 (=÷4) start; lower if fog/glow still too hot. 1.0 = no compensation.")
FDS_FLAG_BOOL(hdr_glow_softknee,        "FDS_HDR_GLOW_SOFTKNEE",        0,                              "atmos",    "HDR fog in-scatter: the physically-grounded alternative to the flat hdr_glow_scale fudge. Instead of disabling the soft-knee under --hdr and scaling inscatter by a constant (which over-dims faint glow and under-tames hot cores — a scalar can't match the knee's gain curve g=(2x-1)/x²), run the SAME soft-knee in HDR-linear with fast_fog_glow_max as the radiance ceiling: faint glow preserved (gain~1), hot cores rolled off (gain→0), auto-tracking the actual glow level; ACES tonemaps on top. Tune fast_fog_glow_max (the physical ceiling; falls back to 300 if unset) rather than re-tuning a ratio. Affects ONLY the froxel/screen fog in-scatter, NOT volumetric cones (no soft-knee there — they keep hdr_glow_scale). Default off for A/B vs hdr_glow_scale.")
FDS_FLAG_BOOL(hdr_cone_softknee,        "FDS_HDR_CONE_SOFTKNEE",        0,                              "atmos",    "HDR volumetric cone/halo glow: the physically-grounded alternative to scaling cone_strength by hdr_glow_scale. Applies a soft-knee (linear below cone_glow_max/2, asymptote at cone_glow_max, same gain curve g=(2x-1)/x² as the fog knee) to the cone+omni-halo in-scatter at its composite into the linear HDR buffer, so hot shaft cores roll off smoothly toward the ceiling (faint shafts preserved) before ACES, instead of a flat hdr_glow_scale that over-dims faint shafts and under-tames cores. When on, the cone term skips the hdr_glow_scale fudge. Tune cone_glow_max (falls back to 200 if unset). HDR-only; affects cones AND omni halos (they share VolCompositeAdd). Sibling of --hdr-glow-softknee (fog in-scatter). Default off for A/B.")
FDS_FLAG_FLOAT(cone_glow_max,           "FDS_CONE_GLOW_MAX",            0.0f,                           "atmos",    "Radiance ceiling for --hdr-cone-softknee's soft-knee on the volumetric cone+halo glow, in the same linear-radiance units as the rest of the HDR buffer (cones composite UNCLAMPED into g_hdrBuf and ACES rolls off above this). Try ~150-400; lower = more roll-off. 0 = use the 200 fallback when --hdr-cone-softknee is on.")
FDS_FLAG_BOOL (hdr_linear,              "FDS_HDR_LINEAR",               0,                              "atmos",    "HDR Phase 3 Stage A (look experiment): tonemap in LINEAR space. Decodes the accumulated buffer gamma->linear (cheap gamma-2.0: square), applies exposure+ACES in linear, then encodes linear->sRGB (sqrt) on output. Does NOT make the surface lighting itself linear (that's Stage B) -- this just lets you A/B whether linear tonemapping looks better before committing to the hot-kernel rewrite. Off = the original gamma-space ACES. Toggle live via the tune server.")
FDS_FLAG_BOOL (bloom,                   "FDS_BLOOM",                    0,                              "atmos",    "Full-screen HDR bloom: bright-pass the linear radiance buffer (g_hdrBuf, the true unclamped source), blur a downsampled pyramid, and add the glow back BEFORE the tonemap so it rolls off through ACES with everything else. Requires --hdr (no float buffer otherwise). Subsumes the localized disco-ball bloom. Threaded (6x4 tiles). Off = no spatial glow (HDR still rolls highlights off, just doesn't bleed).")
FDS_FLAG_FLOAT(bloom_threshold,         "FDS_BLOOM_THRESHOLD",          200.0f,                         "atmos",    "Bloom bright-pass knee, in the linear-radiance 0-255 scale (255 = reference white; lit surfaces sit near there, lights/flash/disco exceed it). Only radiance above this blooms. Lower = more of the scene glows; raise to restrict bloom to the brightest highlights.")
FDS_FLAG_FLOAT(bloom_intensity,         "FDS_BLOOM_INTENSITY",          0.6f,                           "atmos",    "Bloom add-back strength: the blurred bright-pass is scaled by this before adding into g_hdrBuf. 0 = off (same as --no-bloom), ~0.5-1.0 a natural glow, higher for a dreamy/overblown look.")
FDS_FLAG_FLOAT(hdr_refl_gain,           "FDS_HDR_REFL_GAIN",            2.5f,                           "atmos",    "HDR brightness gain for forward Mat_HdrEmissive surfaces (the disco ball): when their colour is lifted from the 8-bit forward buffer into g_hdrBuf, it's scaled by this so the reflection exceeds 255 and over-blooms (8-bit forward can't otherwise be a true HDR source). 1.0 = no boost (just HDR-correct). Only affects flagged surfaces, so other reflective env is untouched.")
FDS_FLAG_BOOL (anamorphic,              "FDS_ANAMORPHIC",               0,                              "atmos",    "Anamorphic lens streaks (Star Trek 2009 look): bright-pass the linear g_hdrBuf, build a long HORIZONTAL light streak (+ a faint VERTICAL cross) off every hot source via exponential doubling-blur, tint it cool blue-white, and add it back BEFORE the tonemap so it rolls off through ACES. Requires --hdr. Independent of --bloom (does its own bright-pass at bloom_threshold). Threaded.")
FDS_FLAG_FLOAT(anamorphic_intensity,    "FDS_ANAMORPHIC_INTENSITY",     0.5f,                           "atmos",    "Anamorphic streak add-back strength (scales the streak before adding into g_hdrBuf). 0 = off.")
FDS_FLAG_INT  (anamorphic_passes,       "FDS_ANAMORPHIC_PASSES",        6,                              "atmos",    "Horizontal streak length in exponential doubling passes — reach ~2^passes quarter-res px (6 ~ a 256px streak at 1080p). Each pass is 3 taps; cost is log(length).")
FDS_FLAG_FLOAT(anamorphic_decay,        "FDS_ANAMORPHIC_DECAY",         0.85f,                          "atmos",    "Per-pass streak falloff weight (higher = longer, brighter tail). ~0.8-0.9.")
FDS_FLAG_FLOAT(anamorphic_vert,         "FDS_ANAMORPHIC_VERT",          0.25f,                          "atmos",    "Faint vertical cross-streak intensity as a fraction of the horizontal (0 = pure horizontal anamorphic; 0.25 = a subtle JJ lens-array cross). The vertical streak uses 2 fewer doubling passes so it stays shorter than the horizontal.")
FDS_FLAG_BOOL (lens_ghosts,             "FDS_LENS_GHOSTS",              0,                              "atmos",    "Screen-space lens-flare ghosts: a chain of colored discs + a halo ring marching along the line from each bright source through screen-centre, sampled from the linear g_hdrBuf bright-pass and added BEFORE the tonemap. Completes the anamorphic flare. Requires --hdr. Threaded.")
FDS_FLAG_FLOAT(lens_ghost_intensity,    "FDS_LENS_GHOST_INTENSITY",     0.4f,                           "atmos",    "Lens-ghost add-back strength. 0 = off.")
FDS_FLAG_INT  (lens_ghost_count,        "FDS_LENS_GHOST_COUNT",         4,                              "atmos",    "Number of ghost discs along the centre axis.")
FDS_FLAG_FLOAT(lens_ghost_dispersal,    "FDS_LENS_GHOST_DISPERSAL",     0.32f,                          "atmos",    "Ghost spacing as a fraction of the screen toward/through centre (bigger = ghosts spread farther apart).")
FDS_FLAG_FLOAT(lens_ghost_halo,         "FDS_LENS_GHOST_HALO",          0.4f,                           "atmos",    "Halo-ring intensity (the soft circle the ghosts sit on), as a fraction of ghost_intensity. 0 = no halo.")
FDS_FLAG_BOOL (chromatic,               "FDS_CHROMATIC",                0,                              "atmos",    "Chromatic aberration: radial per-channel split (R outward, B inward) that grows toward the frame edge — the lens-glass tell. Post-tonemap on the 8-bit image. Cheap.")
FDS_FLAG_FLOAT(chromatic_amount,        "FDS_CHROMATIC_AMOUNT",         2.5f,                           "atmos",    "Max channel split in pixels at the frame corner (0 at centre). ~1-4 subtle to strong.")
FDS_FLAG_BOOL (vignette,                "FDS_VIGNETTE",                 0,                              "atmos",    "Vignette: darken the frame toward the corners (cinematic focus). Post-tonemap on the 8-bit image.")
FDS_FLAG_FLOAT(vignette_strength,       "FDS_VIGNETTE_STRENGTH",        0.4f,                           "atmos",    "Vignette darkening at the corner (0 = none, 1 = black corners). ~0.3-0.5 natural.")
FDS_FLAG_BOOL (dof,                     "FDS_DOF",                      0,                              "atmos",    "Depth-of-field: circle-of-confusion bokeh blur off the G-buffer depth, applied to the linear g_hdrBuf BEFORE bloom so defocused highlights bloom into discs. Gather blur with a golden-angle disc kernel + scatter-as-gather weighting (no foreground bleed). Requires --hdr. Threaded.")
FDS_FLAG_FLOAT(dof_focus,               "FDS_DOF_FOCUS",                0.0f,                           "atmos",    "Focus-plane distance in view-space z units. 0 (default) = auto-focus on the screen-centre depth each frame.")
FDS_FLAG_FLOAT(dof_range,               "FDS_DOF_RANGE",                0.06f,                          "atmos",    "Depth over which sharpness falls to full blur, as a FRACTION of the scene far-plane (so one value auto-scales across scenes: a small room and an outdoor vista both work). Smaller = shallower depth of field. ~0.03 shallow, ~0.1 gentle.")
FDS_FLAG_FLOAT(dof_max,                 "FDS_DOF_MAX",                  10.0f,                          "atmos",    "Maximum blur radius at full circle-of-confusion, in pixels at a 540p reference height (auto-scaled to the actual resolution so the blur looks the same at 540p and 1080p). 0 = off.")
FDS_FLAG_BOOL (grade,                   "FDS_GRADE",                    0,                              "atmos",    "Colour grade on the final 8-bit image: temperature, contrast, saturation, and a teal-orange split-tone (shadows → teal, highlights → orange — the blockbuster look). Post-tonemap, cheap, works with or without bloom/HDR effects in frame.")
FDS_FLAG_FLOAT(grade_teal_orange,       "FDS_GRADE_TEAL_ORANGE",        0.3f,                           "atmos",    "Teal-orange split-tone strength. 0 = neutral, ~0.3 tasteful, ~0.6 strong cinematic.")
FDS_FLAG_FLOAT(grade_contrast,          "FDS_GRADE_CONTRAST",           1.05f,                          "atmos",    "Contrast around mid-grey. 1 = none, >1 punchier, <1 flatter.")
FDS_FLAG_FLOAT(grade_saturation,        "FDS_GRADE_SATURATION",         1.1f,                           "atmos",    "Saturation. 1 = none, >1 richer, 0 = greyscale.")
FDS_FLAG_FLOAT(grade_temp,              "FDS_GRADE_TEMP",               0.0f,                           "atmos",    "Colour temperature shift. 0 = neutral, + = warmer (more red/less blue), - = cooler. ~±0.3 subtle.")
FDS_FLAG_BOOL (grain,                   "FDS_GRAIN",                    0,                              "atmos",    "Animated film grain: per-pixel luminance noise hashed on x,y,frame and added to the final image. Post-tonemap, cheap.")
FDS_FLAG_FLOAT(grain_strength,          "FDS_GRAIN_STRENGTH",           6.0f,                           "atmos",    "Film-grain amplitude in 8-bit levels (peak ± offset). ~4-10 subtle to coarse.")

// ─── scene-specific ──────────────────────────────────────────────────────
FDS_FLAG_BOOL(skip_cubemap,             "FDS_SKIP_CUBEMAP",             0,                              "city",     "City: skip per-building env-map bake")
FDS_FLAG_BOOL(city_envmap_cache,        "FDS_CITY_ENVMAP_CACHE",        1,                              "city",     "Cache per-building env-map panoramas to Runtime/cache/city_envmap.bin keyed by CITY.FLD + panorama dims. Default on — slashes city bench/PGO init from ~4.8s to ~0.4s. --no-city-envmap-cache forces a fresh bake (and rewrites the cache).")
FDS_FLAG_BOOL(water_ripple,             "FDS_WATER_RIPPLE",             1,                              "city",     "City: animate the water-reflection displacement map with cross-axis travelling ripples (was a frozen static sin/cos warp). The mirrored world below the water surface now moves. --no-water_ripple restores the legacy static warp. Per-frame dispMap rebuild is row-parallel across the pool.")
FDS_FLAG_FLOAT(water_ripple_amp,        "FDS_WATER_RIPPLE_AMP",         30.0f,                          "city",     "Water-ripple displacement amplitude in pixels (peak screen-space offset of the reflection). Higher = choppier; at low HDR exposure the reflection is dark so it needs more amplitude to read. Legacy static warp was ~15.")
FDS_FLAG_FLOAT(water_ripple_speed,      "FDS_WATER_RIPPLE_SPEED",       1.0f,                           "city",     "Water-ripple animation speed. 0 = frozen (but cross-axis organic, unlike the legacy warp).")
FDS_FLAG_FLOAT(water_ripple_scale,      "FDS_WATER_RIPPLE_SCALE",       1.0f,                           "city",     "Water-ripple spatial frequency scale. Larger = tighter, choppier ripples; smaller = broad swells.")
FDS_FLAG_FLOAT(water_scroll_speed,      "FDS_WATER_SCROLL_SPEED",       1.0f,                           "city",     "Water SURFACE-texture scroll speed (the tiled albedo sliding, distinct from the reflection ripple). 1.0 = original rate; scale up for a faster flow, 0 = frozen.")
FDS_FLAG_BOOL (water_bump,              "FDS_WATER_BUMP",               1,                              "city",     "Bump-mapped specular GLINTS on the water surface (distinct from the reflection ripple): an animated WORLD-space ripple normal catches a key light → view-dependent sparkles across the water. Masked on the transparent G-buffer (front == water matID) with opaque-Z occlusion, so it covers all visible water and never paints over foreground geometry. --no-water_bump disables.")
FDS_FLAG_FLOAT(water_bump_strength,     "FDS_WATER_BUMP_STRENGTH",      0.6f,                           "city",     "Water-bump glint brightness (peak add in 0-1 → ×255). 0 = off. ~0.3 subtle shimmer, ~0.8 strong sparkle.")
FDS_FLAG_FLOAT(water_bump_shininess,    "FDS_WATER_BUMP_SHININESS",     14.0f,                          "city",     "Water-bump glint tightness. Higher = smaller, sharper sparkles; lower = broad sheen.")
FDS_FLAG_FLOAT(water_bump_scale,        "FDS_WATER_BUMP_SCALE",         6.0f,                           "city",     "Water-bump normal spatial frequency (independent of the coarse reflection ripple). Higher = finer, denser sparkles; lower = broad coherent sheen.")
FDS_FLAG_BOOL (water_detile,            "FDS_WATER_DETILE",             1,                              "city",     "De-tile the water ALBEDO: warp the water grid's face UVs by a low-frequency function of position at init, so the tiled texture stretches/swirls across the surface instead of repeating as a regular grid. --no-water_detile restores the plain tiling.")
FDS_FLAG_FLOAT(water_detile_amp,        "FDS_WATER_DETILE_AMP",         0.6f,                           "city",     "Water de-tile warp amplitude in UV units (fraction of a texture tile the mapping is displaced; varies across the surface). Bigger = more distortion, but too big smears the texture.")
FDS_FLAG_FLOAT(water_detile_scale,      "FDS_WATER_DETILE_SCALE",       3.5f,                           "city",     "Water de-tile warp spatial frequency. Higher = more, smaller warp cells (breaks local tile repetition); lower = broad swells.")
FDS_FLAG_BOOL (water_procedural,        "FDS_WATER_PROCEDURAL",         0,                              "city",     "Procedural water composite (Stage B): replace the tiled albedo with a deep-water colour mixed with the reflection by a view-angle FRESNEL term (more reflection at grazing, deep colour looking straight down). Coherent with the shared wave field. Off = legacy albedo+reflection blend.")
FDS_FLAG_FLOAT(water_deep_b,            "FDS_WATER_DEEP_B",             58.0f,                          "city",     "Procedural deep-water colour Blue (0-255), seen looking straight down.")
FDS_FLAG_FLOAT(water_deep_g,            "FDS_WATER_DEEP_G",             44.0f,                          "city",     "Procedural deep-water colour Green (0-255).")
FDS_FLAG_FLOAT(water_deep_r,            "FDS_WATER_DEEP_R",             26.0f,                          "city",     "Procedural deep-water colour Red (0-255).")
FDS_FLAG_FLOAT(water_reflectivity,      "FDS_WATER_REFLECTIVITY",       0.9f,                           "city",     "Procedural water max reflection at grazing angle (fresnel peak). 1 = full mirror at the horizon, 0 = no reflection.")
FDS_FLAG_FLOAT(water_fresnel_base,      "FDS_WATER_FRESNEL_BASE",       0.65f,                          "city",     "Procedural water reflection floor looking STRAIGHT DOWN (fresnel base). For this mirror water the reflection underlay IS the see-through, so this is effectively the base transparency: higher = more reflection/transparency at all angles, lower = more opaque deep colour. ~0.65 gives the reflection clear weight; 1 = full mirror everywhere.")
FDS_FLAG_FLOAT(water_albedo_mix,        "FDS_WATER_ALBEDO_MIX",         0.45f,                          "city",     "Procedural water: strength of the generated CAUSTIC texture (bright cell-network lines), modulating the water brightness, sampled per-pixel at a UV WARPED BY THE WAVE FIELD so it ripples with the same waves as the glints/reflection (coherent). 0 = none, ~0.45 visible caustics, higher = stronger.")
FDS_FLAG_FLOAT(water_tex_scale,         "FDS_WATER_TEX_SCALE",          0.06f,                          "city",     "Procedural water caustic tiling: world-units→texel frequency. Higher = smaller/denser caustic cells; lower = larger cells.")
FDS_FLAG_FLOAT(water_tex_warp,          "FDS_WATER_TEX_WARP",           5.0f,                           "city",     "How hard the wave field distorts the water texture's sampling (in texels). Makes the texture ripple/flow WITH the waves & glints; 0 = flat (just tiled), too high = over-churned/funhouse.")
FDS_FLAG_FLOAT(water_tex_flow,          "FDS_WATER_TEX_FLOW",           1.0f,                           "city",     "How fast the caustic texture TRANSLATES with the wave field. 1 = matches the glint scroll velocity (caustics ride the waves), 0 = anchored (warp ripples it in place only), >1 = faster than the glints.")
#if FDS_DEV
FDS_FLAG_BOOL(debug_panorama,           "FDS_DEBUG_PANORAMA",           0,                              "city-dev", "[dev] City: synthesize debug panoramas with gridlines")
FDS_FLAG_BOOL(dump_panorama,            "FDS_DUMP_PANORAMA",            0,                              "city-dev", "[dev] City: dump baked panoramas to PPM")
#endif
FDS_FLAG_BOOL(greets_mat_labels,        "FDS_GREETS_MAT_LABELS",        0,                              "greets",   "Greets: overlay one '<matID>:<name>' label per material at the centroid of its closest-to-camera on-screen face. Diagnostic for picking mirror/effect target materials by name.")
FDS_FLAG_BOOL(greets_stone_tex,         "FDS_GREETS_STONE_TEX",         0,                              "greets",   "Greets: swap the wall ('rooms') + floor ('floor') diffuse to the de-lit 1024 Egyptian sandstone textures (TEXTURES/greets_wall.jpg, greets_floor.jpg). For the normal map, prefers a dedicated AUTHORED tangent-space map (TEXTURES/greets_*_n.png) if present; otherwise Sobel-bakes one from a height map (greets_*_h.png). Off by default for A/B.")
FDS_FLAG_BOOL(greets_nmap_flip_g,       "FDS_GREETS_NMAP_FLIP_G",       0,                              "greets",   "Greets stone-tex: flip the green channel of an AUTHORED normal map (greets_*_n.png) on load. Authored maps come in two conventions — OpenGL (+Y up) and DirectX (+Y down); the engine's tangent-space decode expects one of them. If lit bumps look inverted (mortar grooves bulge out / bricks cave in), toggle this. No effect on the Sobel-baked-from-height path.")
FDS_FLAG_BOOL(greets_tbn_fix,           "FDS_GREETS_TBN_FIX",           1,                              "greets",   "Greets: fix the normal-map relief seam at boundaries between faces of opposite UV handedness (mirrored mapping). The deferred kernel reconstructs the bitangent as a fixed-sign N×T, which is wrong on negative-UV-determinant faces; this splits those faces onto a handedness=-1 material clone so the kernel flips B per pixel (B = TbnHandedness·(N×T)). Default on; the 'rooms' wall has ~92 mirrored faces out of ~196. Off = the legacy seam.")
FDS_FLAG_FLOAT(greets_floor_uv_scale,   "FDS_GREETS_FLOOR_UV_SCALE",    1.5f,                           "greets",   "Greets stone-tex: scale the floor's planar UVs so tiles are this much BIGGER (fewer repetitions). 1.0 = authored size; 1.5 = tiles 1.5x larger. Applied to the floor face UVs after load (the planar projection is baked at FLD load, so this rescales it in code).")
FDS_FLAG_FLOAT(greets_floor_detile,     "FDS_GREETS_FLOOR_DETILE",      0.06f,                          "greets",   "Greets stone-tex: low-frequency world-space UV warp on the floor to break the obvious tile grid (same de-tile trick as city water). Amplitude in UV units; 0 = off. Per shared world position so adjacent faces stay seamless.")
FDS_FLAG_BOOL(greets_mirror,            "FDS_GREETS_MIRROR",            0,                              "greets",   "Greets: build a one-shot world-mirrored clone of every mesh across the teleporter wall plane and hide the wall faces, so the teleporter rectangle reveals a Z-buffer-portal view of the mirrored room. Static-only — dynamic meshes (robot) reflect frozen at init.")
FDS_FLAG_BOOL(greets_mirror_debug_mask, "FDS_GREETS_MIRROR_DEBUG_MASK", 0,                              "greets",   "Greets: after Render(), overlay gb.mirrorId * 64 onto the framebuffer (red/green/blue channels rotated by mirror id) so you can see which pixels each mirror's wall pre-pass actually stamped. Diagnostic for tuning the per-pixel mask path.")
FDS_FLAG_BOOL(greets_mirror_cam,        "FDS_GREETS_MIRROR_CAM",        0,                              "greets",   "Greets: after building mirrors, override the camera to a fixed free-cam pose squarely in front of the teleporter mirror (computed from its wall centroid + plane normal). Lets a snapshot capture the teleporter reflection directly without hunting for a scripted-camera timestamp that happens to face it.")
FDS_FLAG_BOOL(mirrortest_skip_mirror,   "FDS_MIRRORTEST_SKIP_MIRROR",   0,                              "mirror",   "mirrortest snapshot: build the bare floor+wall+mirror+test-object scene WITHOUT invoking BuildMirror or the mask pre-pass. Use to bisect whether the Render() hang is in the mirror layer or in the base scene render path. Run: ./DEMO --deferred --snapshot=mirrortest --mirrortest-skip-mirror")
FDS_FLAG_FLOAT(greets_spot_height,      "FDS_GREETS_SPOT_HEIGHT",       0.0f,                           "greets",   "Greets: override robot spotlight height (0 = scene default)")
FDS_FLAG_BOOL(no_greets_spots,          "FDS_NO_GREETS_SPOTS",          0,                              "greets",   "Greets: skip the code-installed robot spotlights (g_RobotSpot + orbit lights). FLD omnis still load.")
FDS_FLAG_BOOL(greets_omni_shadows,      "FDS_GREETS_OMNI_SHADOWS",      0,                              "greets",   "Greets: mark every FLD-loaded Light_Omni as Omni_CastsShadow|StaticShadow so CubeShadowMaps_Rebuild bakes 6-face shadow cubes for them. Disabled by default — N omnis × 6 faces × shadowMapRes² adds up quickly.")
FDS_FLAG_INT(greets_omni_shadow_res,    "FDS_GREETS_OMNI_SHADOW_RES",   256,                            "greets",   "Greets: per-face cube shadow-map resolution for omnis flagged by --greets-omni-shadows. Should be a power of two (128/256/512/1024). Total memory per omni = 6 × res² × 4 bytes.")
FDS_FLAG_INT(greets_moving_omni_shadow_res, "FDS_GREETS_MOVING_OMNI_SHADOW_RES", 0,                       "greets",   "Greets: separate per-face cube shadow-map resolution for omnis flagged as MOVING (Omni_CastsShadow without Omni_StaticShadow — typically mech-attached). 0 = use --greets-omni-shadow-res. Moving omnis pay full per-frame cube re-bake (no static cache, no lightmap), so dropping their res is the cheapest way to reclaim shadow time when they sit close to the camera.")
FDS_FLAG_INT(greets_piramid_chunk_grid, "FDS_GREETS_PIRAMID_CHUNK_GRID", 8,                              "greets",   "Greets: spatial-grid resolution per axis for Piramid.lwo chunking. Greets's wall mesh is one giant TriMesh (bsphere r≈60) that the cube-face cull can't reject; splitting it at scene init into N³ smaller TriMeshes (most cells empty → ~50-150 chunks in practice) lets mesh-level culling actually fire. 0 = disable chunking.")
FDS_FLAG_BOOL(shadow_cube_face_cull,    "FDS_SHADOW_CUBE_FACE_CULL",    1,                              "shadows",  "Per-cube-face bsphere cull in Transform_Objects: skip meshes whose world-space bsphere doesn't intersect the 90°-FOV pyramid of the cube face being baked. Reuses sphereOutsideSpotCone with a circumscribed cone (half-angle 54.7°, cos ≈ 0.577) to keep the test conservative. Big win for moving omnis with 6 active faces — typically each face sees only ~⅙ of the scene.")
FDS_FLAG_BOOL(shadow_cube_vert_cull,    "FDS_SHADOW_CUBE_VERT_CULL",    0,                              "shadows",  "Per-vertex pyramid cull in the cube-face shadow xform, gated on TriMesh::worldVerts being pre-computed. For meshes that pass the mesh-level cube-face cull but only partially overlap the face pyramid, skip the view matmul for world-space vertices outside. Off by default: in practice (greets chunk grid=8) the mesh-level cull is tight enough that surviving meshes have nearly all verts inside; the per-vertex test cost + un-fused perspective in the survivor path (~36 ops vs 18 ops M34) exceeds the savings. Useful if you have one giant moving mesh that can't be spatially split.")
FDS_FLAG_FLOAT(greets_omni_default_range, "FDS_GREETS_OMNI_DEFAULT_RANGE", 1500.0f,                       "greets",   "Greets: fallback IRange (and rRange) applied to FLD-loaded omnis whose Range spline is 0 (the FLD format omits the envelope when the authoring tool didn't write one — every greets omni hits this case). Set to 0 to leave them at 0, which kills surface lighting + halo + shadow FZP for those omnis.")
FDS_FLAG_FLOAT(greets_mirror_min_area,  "FDS_GREETS_MIRROR_MIN_AREA",   2.0f,                           "greets",   "Greets: minimum total world-space area for a coplanar P_TEXT cluster to become a mirror. Each mirror clones the whole scene + omni set, so small panels are expensive. Measured cluster areas: box edge strips 0.30-0.32, central column panels 0.98-1.00, end screens 3.2-172. Default 2.0 excludes the column panels (perf); 0.5 re-enables them.")
FDS_FLAG_FLOAT(greets_mirror_rtt_min_area, "FDS_GREETS_MIRROR_RTT_MIN_AREA", 1.5f,                        "greets",   "Greets: minimum coplanar P_TEXT cluster area to become a FIRST-ORDER RTT mirror (below the clone threshold). The central column panels (~0.98-1.00 area) + box edge strips (~0.30) are barely-visible half-silvered screens that add little but each cost an RTT slot + the per-frame RTT bake. Default 1.5 drops them (only end-screen CLONES at >=2.0 survive; second-order/recursive RTT is unaffected). Set 0.2 to re-include the columns + strips.")
FDS_FLAG_BOOL(mirror_rtt_probe,         "FDS_MIRROR_RTT_PROBE",         0,                              "greets",   "Per-frame probe for second-order mirror pairs: for every active mirror A whose reflection contains another mirror B's panel on screen, log the projected pixel footprint (= required RTT resolution), the doubly-reflected virtual camera position, and B's panel window extents. Diagnostic groundwork for the order-2 render-to-texture path; no rendering changes.")
FDS_FLAG_BOOL(mirror_rtt,               "FDS_MIRROR_RTT",               0,                              "greets",   "Second-order mirror reflections via render-to-texture: panels of mirror B seen inside mirror A's reflection display a per-frame low-res forward render of the real scene from the doubly-reflected camera, through B's panel window (off-axis projection, near plane at the mirror plane). Up to 2 visible pairs re-rendered per frame, picked by projected footprint area.")
FDS_FLAG_FLOAT(mirror_rtt_alpha,        "FDS_MIRROR_RTT_ALPHA",         0.75f,                          "greets",   "First-order RTT panel blend: panel weight in the transparent kernel's lerp (panel*a + behind*(1-a)). 0.75 = mostly mirror with a hint of see-through; lower is more windowy. 0 falls back to the legacy additive texel + behind/2.")
FDS_FLAG_FLOAT(mirror_rtt_gain,         "FDS_MIRROR_RTT_GAIN",          0.55f,                          "greets",   "First-order RTT reflection gain (reflectance): the mirrored scene is scaled by this before the text composite. The offscreen pass is forward-lit (StaticLighting bake on walls), which runs brighter than the deferred main pass — <1 re-balances, and real mirrors absorb anyway. 1.0 = no attenuation.")
FDS_FLAG_BOOL(greets_disco,             "FDS_GREETS_DISCO",             1,                              "greets",   "Mirrored disco ball hanging in the greets corridor: faceted env-mapped sphere + rotating spotlight dots.")
FDS_FLAG_BOOL(shard_deferred,           "FDS_SHARD_DEFERRED",           0,                              "greets",   "Mirror-shard reflections bake through the DEFERRED kernel (shadowed, lit exactly as the main deferred view) instead of the forward filler. Each shard owns a per-worker G-buffer fanned across the pool (MirrorShatter Slice 6). ~20ms vs ~6ms forward on greets's 238 shards — shadowed quality for the cost. Off → forward bake. FDS_SHARD_REFL_SERIAL forces the legacy serial path either way. Read once at shatter time. Run: ./DEMO --shard-deferred --scene-greets")
FDS_FLAG_FLOAT(mirror_rtt_density,      "FDS_MIRROR_RTT_DENSITY",       256.0f,                         "greets",   "RTT mirror texel density (texels per world unit, pow2-rounded per axis, capped at 512x512). Replaces the old constant 64K budget that gave big panels visibly lower resolution than small ones.")
FDS_FLAG_BOOL(mirror_rtt_adaptive,      "FDS_MIRROR_RTT_ADAPTIVE",      1,                              "greets",   "View-dependent RTT resolution: bake each mirror panel at the pow2 size matching its PROJECTED on-screen footprint (clamped to the density-derived max), instead of a fixed world-size*density texture. A panel seen small/oblique/across-the-room bakes cheap; a panel you're standing in front of keeps full res. Zero visible loss (never more texels than screen pixels) and the dominant greets-central-room ANIM cost (RenderSecondOrderMirrors). Off = legacy fixed size.")
FDS_FLAG_FLOAT(mirror_rtt_adaptive_scale,"FDS_MIRROR_RTT_ADAPTIVE_SCALE", 1.0f,                          "greets",   "Multiplier on the on-screen footprint before pow2-rounding for --mirror-rtt-adaptive. 1.0 = ~1 texel per screen pixel (pow2of already rounds up within 1.5x); raise toward 2 if oblique panels look soft, lower for more savings.")
FDS_FLAG_FLOAT(greets_mirror_tint,      "FDS_GREETS_MIRROR_TINT",       0.0f,                           "greets",   "OPTIONAL cool-silver cast on ALL greets mirrors via ONE composite: out = silver*tint + reflection/2. The half-silvered look is the HALVED WARM reflection (reflection/2); silver is an extra cast on top. tint=0 = dimmed warm reflection, matching the display screens (#2) with no cast; raise for a cool silver cast on the portal (#1, kernel XparBlendAlpha=0 + Lum=tint) and shatter shards (#3, same formula baked into the atlas). LIVE. (Replaces greets_shard_silver / greets_portal_tint.) FDS_TINT_RED=1 swaps silver for red to verify.")
FDS_FLAG_FLOAT(greets_shard_randomness, "FDS_GREETS_SHARD_RANDOMNESS",  1.0f,                           "greets",   "Greets shatter: irregularity of the shard pieces. Scales BOTH the non-uniform grid line spacing (varied shard SIZES) and the per-intersection 2D jitter (irregular SHAPES). 0 = a clean uniform grid; 1 = natural cracked glass; >1 = increasingly chaotic (jitter is capped at ~0.45 of a cell so pieces never cross). Read once at shatter build.")
FDS_FLAG_FLOAT(greets_shard_fall_speed, "FDS_GREETS_SHARD_FALL_SPEED",  1.5f,                           "greets",   "Greets shatter: gravity multiplier on the falling shards. 1.0 = original pace; >1 falls faster (default 1.5 = a bit snappier). Applied per-frame to the downward integration.")
FDS_FLAG_BOOL (greets_shard_lay_flat,   "FDS_GREETS_SHARD_LAY_FLAT",    1,                              "greets",   "Greets shatter: when a shard comes to rest, rotate it to lie FLAT on the floor plane (its face normal -> +Y, with a random yaw) instead of freezing at its tumbled orientation. Correctly aligns the panel normal regardless of the screen's facing (the old fixed-pitch settle assumed a -Z panel and left greets's -X panel standing on edge). 0 = freeze tumbled pose (legacy).")
FDS_FLAG_INT  (greets_shard_res,        "FDS_GREETS_SHARD_RES",         64,                             "greets",   "Greets shatter: per-shard reflection texel resolution (each shard owns one res² cell of a reflection atlas). Rounded up to pow2. Independent of --mirror-rtt-density (that only drives the room mirror RTT panels). Shards are split across as many ≤1024² atlas textures as needed (the block-tiled sampler can't address beyond 1024/axis), so res can exceed the old single-atlas ceiling of 64: 128 = 4x the texels (sharper falling shards) at ~4x the bake + memory. Read once at scene load (prepareReflectionAtlas).")
FDS_FLAG_FLOAT(disco_bloom,             "FDS_DISCO_BLOOM",              1.5f,                           "greets",   "Disco-ball bloom strength: screen-space threshold+blur+add over the ball's projected disc. 0 disables.")
FDS_FLAG_BOOL(mirror_bounce,            "FDS_MIRROR_BOUNCE",            1,                              "greets",   "Mirrors throw beams back into the room: virtual bounce spots at mirrored light positions (volumetric shaft + bounced dot pools). Off = no bounce pool activity.")
FDS_FLAG_FLOAT(mirror_bounce_gain,      "FDS_MIRROR_BOUNCE_GAIN",       0.55f,                          "greets",   "Bounce reflectance: bounce spot intensity = source x gain.")
FDS_FLAG_FLOAT(mirror_bounce_range,     "FDS_MIRROR_BOUNCE_RANGE",      1.6f,                           "greets",   "Bounce range multiplier over the source's range. 1.0 = physical (the surviving stub past the glass is a few units and barely reads); 1.6 gives the reflected shaft a visible body.")
FDS_FLAG_BOOL(mirror_prof,              "FDS_MIRROR_PROF",              0,                              "greets",   "Per-frame mirror-pass timing: accumulate UpdateAllMirrors / StampMirrorMasks / RenderSecondOrderMirrors wall time and print averages every 120 frames (FDS_MIRROR_PROF_EVERY overrides the interval). Also reports avg active mirror count and RTT jobs/frame.")
FDS_FLAG_FLOAT(fountain_particle_omni_pct, "FDS_FOUNTAIN_PARTICLE_OMNI_PCT", 0.0f,                      "fountain", "Fountain: percentage of particles spawning omnis")

// ─── demo / debug ────────────────────────────────────────────────────────
FDS_FLAG_BOOL(skip_to_fountain,         "SKIP_TO_FOUNTAIN",             0,                              "demo",     "Skip Glato + City and jump straight to Fountain")
FDS_FLAG_BOOL(scene_mirrortest,         "FDS_SCENE_MIRRORTEST",         0,                              "demo",     "Run the interactive mirror-test scene instead of the demo sequence. Floor + back wall + reflective panel + a test cube; uses the SceneBuilder API + the planar mirror system. TAB/WASD for free-cam, ESC/Backspace to exit. Run: ./DEMO --scene-mirrortest")
FDS_FLAG_BOOL(scene_greets,             "FDS_SCENE_GREETS",             0,                              "demo",     "Skip Glato/City/Chase/Fountain/Crash and run only the greets scene. Useful for iterating on greets-specific code (mirror system, lightmap bake, text rasterizer) without sitting through the rest of the demo each time. Run: ./DEMO --scene-greets [--greets-mirror]")
FDS_FLAG_BOOL(scene_conetest,           "FDS_SCENE_CONETEST",           0,                              "demo",     "Run the interactive volumetric-cone test scene (single spot over a ground plane) with free-cam, instead of the demo. The rig for tuning cones / fast_fog / in-scatter live. WASD/QE move, arrows look, ESC exit. Run: ./DEMO --scene-conetest --deferred --draw_cones [--fast_fog --fast_fog_blobs ...]")
FDS_FLAG_BOOL(mirrortest_multi_dump,    "FDS_MIRRORTEST_MULTI_DUMP",    0,                              "demo",     "mirrortest one-shot multi-view sanity dump: render the interactive scene from 6 preset camera poses (front, side, high, low, close, far), write each as /tmp/mt_view_N.ppm, then exit. Used to verify the mirror reflection is sane from multiple angles without manual fly-through.")
FDS_FLAG_BOOL(dump_mats,                "FDS_DUMP_MATS",                0,                              "debug",    "Dump material info on load")
