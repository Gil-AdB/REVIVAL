+      goto OUT;
+      // This is in case 100% of trimesh AHEAD of camera. this saves some chks
+      EAhead://Vertex_Loop1(T->Vertex,VEnd,M,&V);
+			for (Vtx=T->Verts;Vtx<VEnd;Vtx++)
