+void Fade_In(DWord *Target,DWord *Source,char Perc)
+{
+  DWord *Tg = Target;
+  char *Src = (char *)Source,*SE = Src + XRes*YRes*4;
+  long r,g,b;
+  while (Src<SE)
+  {
+    b = (((*Src++)*Perc)&0xFF00)>>8;
+    g = (((*Src++)*Perc)&0xFF00);
+    r = (((*Src++)*Perc)&0xFF00)<<8;
+    Src++;
+    *Tg++ = r+g+b;
+	}
+}
