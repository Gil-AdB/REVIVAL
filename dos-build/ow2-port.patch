+  float e;
+
+  e=Q->Y;
+  Q->Y=Q->Z;
+  Q->Z=e;
+}
+
+void SwapYZ(Matrix Mat)
+{
+  Matrix_Form(Mat,Mat[0][0],Mat[0][2],Mat[0][1],
+                  Mat[2][0],Mat[2][2],Mat[2][1],
+                  Mat[1][0],Mat[1][2],Mat[1][1]);
+}
