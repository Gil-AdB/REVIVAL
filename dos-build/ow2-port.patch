+extern "C" void __interrupt __far new_int6(void);
+extern "C" void emmshit(void);
+
+void (__interrupt __far *old_int6)(void);
+
+void Detect_MMX()
+{
+   old_int6 =_dos_getvect(0x6);
+   _dos_setvect(0x6,new_int6);
+  MMXState=1;
+  emmshit();
+   _dos_setvect(0x6,old_int6);
+}
