+DWord DPMI_Free_Memory(void)
+{
+  DWord Buffer[12]; //48 bytes for reserved stuff.
+  union REGS  r;
+  struct SREGS sr;
+
+  memset(&r,0,sizeof(r));
+  memset(&sr,0,sizeof(sr));
+
+  r.x.eax = 0x500;
+  sr.es = FP_SEG(Buffer);
+  r.x.edi = FP_OFF(Buffer); //hey,it's sort of ES:EDI
+  int386x(0x31,&r,&r,&sr);
+
+  return Buffer[0];
+}
