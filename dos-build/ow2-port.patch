+void Flip_DPixel_8(VESA_Surface *VS)
+{
+  long I,J,K;
+  char C;
+  char *DWP = VS->Data;
+  for(J=0;J<YRes;J++)
+    for(I=0;I<XRes;I++)
+    {
+      C = *DWP++;
+      K = (I<<1)+(YOffs[J]<<2);
+      VGAPtr[K] = C;
+      VGAPtr[K+1] = C;
+      K+=XRes<<1;
+      VGAPtr[K] = C;
+      VGAPtr[K+1] = C;
+    }
+}
