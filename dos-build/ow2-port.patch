+// Saves the (R,G,B) intensity inside the Alpha channel.
+void Intensity_Alpha(Image *Img)
+{
+  DWord *Data = Img->Data,*DE = Data + Img->X*Img->Y;
+  DWord C;
+  long R,G,B,A;
+
+  for(;Data<DE;Data++)
+  {
+    C = *Data;
+    R = (C&0x00FF0000)>>16;
+    G = (C&0x0000FF00)>>8;
+    B = C&0x000000FF;
+    A = ((long)((sqrt(R*R+G*G+B*B)*255.0)/443.5))<<24;
+
+    // Apply intensity value to alpha channel:
+    *Data &= 0x00FFFFFF;
+    *Data += A;
+  }
+}
