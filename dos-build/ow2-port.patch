+// Compute The neccesity for UV-Wrapping Flags for Trimesh T,and
+// removes them if neccesary.
+// Only useful for 3DS origined Scenes.
+void Compute_Lighting_Flag(TriMesh *T)
+{
+  Face *F,*FEnd = T->Faces+T->FIndex;
+  char bit=0;
