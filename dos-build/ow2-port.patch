+char Check_Texture_Memory_Range(Scene *Sc)
+{
+  TriMesh *T;
+  Face *F,*FE;
+  Material *M;
+  Material *Ptr;
+  for(T=Sc->TriMeshHead;T;T=T->Next)
+  {
+    F = T->Faces;
+    FE = F + T->FIndex;
+    for(;F<FE;F++)
+    {
+      Ptr = F->Txtr;
+      if (!Ptr) continue;
+      for(M=MatLib;M;M=M->Next)
+        if (M==Ptr)
