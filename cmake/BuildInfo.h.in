// Source template: cmake/BuildInfo.h.in
//
// Every string here is FIXED LENGTH by construction (40-char SHA, 20-char
// ISO-8601 stamp). That is deliberate: this tree has measured cases where
// 24 bytes of inert padding moved a tick by 1.21%% (commit 3cff1085), so a
// baked constant whose LENGTH varied per commit would inject a code-placement
// confound into every perf comparison. A fixed-length constant cannot.
#ifndef FDS_BUILD_INFO_H_INCLUDED
#define FDS_BUILD_INFO_H_INCLUDED

// Full 40-hex git HEAD of the source tree at cmake-configure time, or
// "0000000000000000000000000000000000000000" when git could not be queried.
#define FDS_BUILD_GIT_SHA      "@FDS_BUILD_GIT_SHA@"
// 1 when `git status --porcelain --untracked-files=no` was non-empty at
// configure time (TRACKED files modified) — the SHA alone does not describe
// the source the binary was built from.
#define FDS_BUILD_GIT_DIRTY    @FDS_BUILD_GIT_DIRTY@
// Branch name at configure time ("HEAD" when detached).
#define FDS_BUILD_GIT_BRANCH   "@FDS_BUILD_GIT_BRANCH@"
// UTC ISO-8601 (second resolution) of the cmake configure that produced this
// header. NOT the link time — for that the runtime stats argv[0]'s mtime.
#define FDS_BUILD_CONFIGURED   "@FDS_BUILD_CONFIGURED@"
// Absolute path of the source tree / build tree this binary was configured from
// (a worktree campaign runs many trees at once; "which one?" is provenance).
#define FDS_BUILD_SOURCE_DIR   "@FDS_BUILD_SOURCE_DIR@"
#define FDS_BUILD_BINARY_DIR   "@FDS_BUILD_BINARY_DIR@"
#define FDS_BUILD_TYPE         "@FDS_BUILD_TYPE@"

#endif // FDS_BUILD_INFO_H_INCLUDED
