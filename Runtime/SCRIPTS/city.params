# City — per-scene scripted parameters (see docs/PARAM_SCRIPTS.md).
# Hot-reloads on save; CLI-set flags always win over lines here.

# Perf policy: coarse froxel grid — temporal supersampling dissolves it
# (verified pixel-identical stills vs 256x144x64); fog cost 71.6->33ms.
fast_fog_froxel_x = 128
fast_fog_froxel_y = 72
fast_fog_froxel_z = 48

# Fog look (user-tuned 2026-06-10): metaball overlap field.
# NOTE blob_overlap is capped at 1.5 by the 3x3x3 neighborhood search.
fast_fog            = 1
fast_fog_blobs      = 1
fast_fog_worley     = 1
fast_fog_density    = 14
fast_fog_bottom     = -400
fast_fog_top        = 420
fast_fog_blob_overlap = 3
fast_fog_worley_thresh = 2.0
fast_fog_cell       = 500
fast_fog_inscatter  = 4
fast_fog_glow_max   = 250
