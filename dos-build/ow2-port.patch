+struct VtxLoop
+{
+  Vertex *Data;
+  VtxLoop *Next,*Prev;
+};
+
+void Advanced_Flat_32(Vertex *A,Vertex *B,Vertex *C)
+{
+  // Vertex Loop.
+  VtxLoop *VL = new VtxLoop;
+  VL->Data = A;
+  VL->Next = new VtxLoop;
+  VL->Next->Prev = VL;
+  VL=VL->Next;
+  VL->Data = B;
+  VL->Next = new VtxLoop;
+  VL->Next->Prev = VL;
+  VL=VL->Next;
+  VL->Data = C;
+  VL->Next = VL->Prev->Prev;
+  VL->Next->Prev = VL;
+  VL = VL->Next;
+}
