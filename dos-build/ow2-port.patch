+ @@InnerLoop:
+		mov   eax, [edi]
+		add   edx, [dv]                 ; update v
+		and   eax,0fefefefeh
+		add   ecx, [du]                 ; update u
+		add   eax, [esi+ebx*4]          ; get pixel from aligned texture map (oh sheloh)
+		mov   bl, ch
+		shr   eax,1
+		mov   [edi], eax                ; plot pixel
+		mov   bh, dh
+		add   edi,4
+		dec   ebp
+ jnz   @@InnerLoop
+
+mov eax,[u1]
+mov ecx,[v1]
+mov [u0],eax
+mov [v0],ecx
+
+FMUL dword ptr [SixtyFive]
+mov eax,[XWidth]
+FLD ST(0)
+FMUL ST(0),ST(4)
+FISTP dword ptr [u1]
+FMUL ST(0),ST(2)
+FISTP dword ptr [v1]
+
+cmp eax,0
+jg InnerOuterLoop
+FFREE ST(0)
+FFREE ST(1)
+FFREE ST(2)
+FFREE ST(3)
+FFREE ST(4)
+FFREE ST(5)
+
+;Inner Loop End Here
+
+UpdateValues:
+mov eax,[ScanLine]
+mov ebx,[Left_Section_Height]
+add eax,1280
+dec ebx
+mov [ScanLine],eax
+mov [Left_Section_Height],ebx
+jg @@Update_Left_UVXZ
+mov ebx,[Left_Section]
+dec ebx
+jle TextureEnd
+mov [Left_Section],ebx
+call CalcLeftSection
+cmp ebx,0
