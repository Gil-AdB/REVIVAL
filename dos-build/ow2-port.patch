+}
+
+void Read(void *Ptr,DWord Size)
+{
+  fread(Ptr,1,Size,IN_3DS);
+}
+
+void ReadASCIIZ(char **s)
+{
+  int a=0;
+  char Temp[256];
+
+  do Read(Temp+a,1); while (Temp[a++]);
+  *s=strdup(Temp);
+}
+
+
+void SwapYZ(Vector *Vec)
+{
+  float e;
+
+  e=Vec->Y;
+  Vec->Y=Vec->Z;
+  Vec->Z=e;
