+parm [ESI] [EDX] [EDI]\
+modify exact [8087];
+*/
+
+void FPU_LPrecision(void);
+#pragma aux FPU_LPrecision=\
+"   FNStCW  [OldFPUCW]            " \
+"   Mov     ax,[OldFPUCW]         " \
+"   And     eax,1111101111111111b " \
+"   Or      eax,0000100000000000b " \
+"   And     eax,64767             " \
+"   Mov     [FPUCW],ax        " \
+"   FLdCW   [FPUCW]           " \
+modify exact [eax 8087];
+
+void FPU_NormalState(void);
+#pragma aux FPU_NormalState=\
+"   FLdCW   [OldFPUCW]"\
