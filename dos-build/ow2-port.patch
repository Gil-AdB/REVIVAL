+						//Color=(Kd*Dot/*+Ks*(Dot*Dot*Dot+Dot2)*0.5f*/)*rLen*rLen;
+							Color=(Dot*(Kd+Ks*Dot*Dot)*0.5f)*O->IRange*rLen*rLen*O->ISize;
+							Vtx->LR += O->L.R * Color;
+							Vtx->LG += O->L.G * Color;
+							Vtx->LB += O->L.B * Color;
+							}
+					}
+				}
+			}
+
+		// Saturation.
