+void DPMI_RecDestroy(Module_MB *Target)
+{
+  if (Target->Child) DPMI_RecDestroy(Target->Child);
+  if (Target->Brother) DPMI_RecDestroy(Target->Brother);
+  DPMI_Destroy(Target);
+}
