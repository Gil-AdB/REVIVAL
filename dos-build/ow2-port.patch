+// weakens Texture intensity by 1/2.
+void Darken_Texture(Texture *T)
+{
+  long I;
+  Word *W;
+  DWord *DW;
+  switch(T->BPP)
+  {
+    case 8: return;
+    case 15: break; //printf("Go get a life, or something.\n"); break;
+    case 16:
+      W = (Word *)T->Data;
+      for(I=0;I<65536;I++)
+      {
+        *W >>= 1;
+        *W &= 0x7BEF;
+        W++;
+      }
+    break;
+    case 32:
+      DW = (DWord *)T->Data;
+      for(I=0;I<65536;I++)
+      {
+        *DW >>= 1;
+        *DW &= 0x7F7F7F7F;
+        DW++;
+      }
+    break;
+  }
+}
