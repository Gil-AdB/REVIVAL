+		Cross_Product(&OmitDer,&X,&Y);
+
+		Spwn = 12;
+//		Spwn = 0;
+		while(Spwn--)
+		{
+			// search for a place to insert
+			for(P=Sc->Pcl+FntOuterPcls+I*FntInnerPcls,PE=P+FntInnerPcls;P<PE;P++)
