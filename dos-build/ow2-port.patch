+mov ebp,ecx
+mov [Middle],esi
+mov [Bottom],edi
+mov [Left_Array],edi
+mov [Left_Array+4],esi
+mov [Left_Array+8],ecx
+mov [Left_Section],2
+
+mov [Right_Array],edi
+mov [Right_Array+4],ecx
+mov [Right_Section],1
+
+call CalcRightSection
