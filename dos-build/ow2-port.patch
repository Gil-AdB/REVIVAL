+mov [Right_Array],edi
+mov [Right_Array+4],esi
+mov [Right_Array+8],ecx
+mov [Right_Section],2
+
+mov [Left_Array],edi
+mov [Left_Array+4],ecx
+mov [Left_Section],1
+
+call CalcLeftSection
+cmp ebx,0
