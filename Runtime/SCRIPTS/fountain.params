# Fountain — lightning look knobs (hot-reloads; tune at localhost:8666, or
# pause P inside a strike and scrub F1/F2). Bolts are textured quads now.
bolt_width = 1.0    # quad width (thin=0.6, fat=1.8)
bolt_kink  = 0.30   # texture jaggedness (re-bakes on change: 0.18 smooth..0.4 wild)
bolt_seg   = 1.0    # brightness (<1 dim, >1 hot)
