+void Draw_Line_8Bit(Vertex *V1,Vertex *V2)
+{
+  char C=64;
+  long D;
+  long Dx,Dy;
+  long Ai,Bi,Xi,Yi;
+  long Offs;
+  long X1,Y1,X2,Y2;
+  char *Ptr = VPage;
+  char *End;
+
+  X1=V1->PX+0.5; Y1=V1->PY+0.5;
+  X2=V2->PX+0.5; Y2=V2->PY+0.5;
+
+  if (X1<=X2)
+  {
+    Xi = 1;
+    Dx = X2-X1;
+  } else {
+    Xi = -1;
+    Dx = X1-X2;
+  }
+
+  if (Y1<=Y2) {
+    Yi = XRes;
+    Dy = Y2-Y1;
+  } else {
+    Yi = -XRes;
+    Dy = Y1-Y2;
+  }
+  Ptr=VPage+X1+YOffs[Y1];
+  End=VPage+X2+YOffs[Y2];
+  *Ptr = C;
+
+  if (Dx > Dy) {
+    Ai = Dy-Dx<<1;
+    Bi = Dy<<1;
+    D = Bi-Dx;
+    while (Ptr != End) {
+      if (D >= 0) {
+        Ptr += Yi;
+        D += Ai;
+      } else D = D + Bi;
+      Ptr += Xi;
+      *Ptr = C;
+    }
+  } else {
+    Ai = Dx-Dy<<1;
+    Bi = Dx<<1;
+    D = Bi-Dy;
+    while (Ptr != End) {
+      if (D >= 0) {
+        Ptr += Xi;
+        D += Ai;
+      } else D += Bi;
+      Ptr += Yi;
+      *Ptr = C;
+    }
+  }
+}
