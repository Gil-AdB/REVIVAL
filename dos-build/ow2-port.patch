+
+	for(T=Sc->TriMeshHead;T;T=T->Next)
+	{
+		if (T->Flags&Tri_Invisible) continue;
+		if (T->Flags&Tri_Noshading) continue;
+
+		VEnd=T->Verts+T->VIndex;
