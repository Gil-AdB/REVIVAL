+@@NoOver16:
+mov [dv],edx
+mov [du],esi
+mov ebx,0
+mov esi,[BitMap]
+mov [Xwidth],eax
+mov ecx,[u0]
+mov edx,[v0]
+;sar ecx,8
+;sar edx,8
+mov   bl, ch
+mov   bh, dh
+
+
+;@@InnerLoop:
+;		mov   eax, [edi]
+;		add   edx, [dv]                 ; update v
