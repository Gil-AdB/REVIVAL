+        Vtx->REU=Vtx->EU*Vtx->RZ;
+        Vtx->EV=128.0+127.0*(Vtx->N.X*IM[1][0]+Vtx->N.Y*IM[1][1]+Vtx->N.Z*IM[1][2]);
+        Vtx->REV=Vtx->EV*Vtx->RZ;
