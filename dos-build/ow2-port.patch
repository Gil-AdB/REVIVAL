+		// ready
+
+
+		// aprioric Offset Vector.
+		MatrixTXVector(T->RotMat,&U,&AP);
+		// ready
+		// Bounding Sphere Elimination test Begins.
+		W2 = (Vector *)(&T->RotMat);
+		L2 = Dot_Product(W2,W2);
+		if ((L1 = Dot_Product(W2+1,W2+1))>L2) L2=L1;
