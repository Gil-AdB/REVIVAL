diff --color -ruN --exclude=_build --exclude=*.o --exclude=*.EXE --exclude=Source Original/dos-rev/FDS/SOURCE/DPMI/STUPDPMI.CPP rev-build/FDS/SOURCE/DPMI/STUPDPMI.CPP
