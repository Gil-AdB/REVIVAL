+
+				c=-Radius-Origin1.Y;
+				d=Direction1.Y;
+				if (bb==0) X1=0;
+				else
+				{
+					X1=a/bb;
+					X2=c/d;
+				}
+				Vector_SelfScale(&Direction1,X1);
