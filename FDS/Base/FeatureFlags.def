// Single source of truth for FDS feature flags.
//
// Three macros, each with the same signature:
//   FDS_FLAG_BOOL (NAME, ENV, DEFAULT, CATEGORY, HELP)
//   FDS_FLAG_FLOAT(NAME, ENV, DEFAULT, CATEGORY, HELP)
//   FDS_FLAG_INT  (NAME, ENV, DEFAULT, CATEGORY, HELP)
//
// NAME    — C identifier; also the CLI form ("--<name>" / "--no-<name>" / "--<name>=value").
// ENV     — environment variable name (existing FDS_* names preserved).
// DEFAULT — compile-time default. Some defaults reference macros (FDS_*_DEFAULT_ON)
//           so the WASM build can flip them via -DFDS_DEFERRED_DEFAULT_ON=1.
// CATEGORY — short string used to group output of --help.
// HELP    — one-line description shown in --help.
//
// Adding a flag is a single line in this file.

// ─── engine ──────────────────────────────────────────────────────────────
FDS_FLAG_BOOL(param_scripts,            "FDS_PARAM_SCRIPTS",            1,                              "engine",   "Per-scene scripted parameters: load SCRIPTS/<scene>.params (relative to CWD) at scene start, apply its FeatureFlags values each frame (time-keyed lines lerp over the scene Timer), hot-reload on file change. CLI/env-set flags always win over the script. See docs/PARAM_SCRIPTS.md.")
FDS_FLAG_BOOL(warn_unknown_flags,       "FDS_WARN_UNKNOWN_FLAGS",       1,                              "engine",   "Warn on stderr ([FLAGS] unknown flag '--foo' (ignored)) when a CLI / flags-file token matches no registered flag — catches typos like --fast-fog-blob (for fast_fog_blobs) that were silently dropped before. Tokens owned by the other argv parsers (--snapshot/--bench/--out/--material-import*/--print-completion) are exempt. Parse-order caveat: --no-warn-unknown-flags silences only tokens AFTER it; use FDS_WARN_UNKNOWN_FLAGS=0 to silence a whole run from scripts.")

FDS_FLAG_BOOL(profiler,                 "FDS_PROFILER",                 0,                              "engine",   "On-screen profiler overlay (per-section ms, FPS, polys/Mpx). Runtime equivalent of rev.cfg's ProfilerEnable (the cfg seeds this flag; CLI/script/tune-console can override either way, per frame).")
FDS_FLAG_BOOL(tune_server,              "FDS_TUNE_SERVER",              1,                              "engine",   "Live tuning console: embedded HTTP server (localhost only) serving a knob page over every FeatureFlag. Open http://localhost:<tune_port> while the demo runs; changes apply immediately with CLI precedence (param scripts yield); release buttons hand knobs back; copy buttons export CLI/.params lines.")
FDS_FLAG_INT(tune_port,                 "FDS_TUNE_PORT",                8666,                           "engine",   "Live tuning console port (see tune_server).")

// ─── deferred pipeline ───────────────────────────────────────────────────
FDS_FLAG_BOOL(deferred,                 "FDS_DEFERRED",                 FDS_DEFERRED_DEFAULT_ON,        "deferred", "Deferred G-buffer pipeline")
FDS_FLAG_BOOL(spot_cone_cull,           "FDS_SPOT_CONE_CULL",           1,                              "deferred", "Tile-vs-cone culling for spot lights in the per-tile light lists + volumetric cone pass. Range-sphere culling alone puts a narrow spot (disco beams: 4.5 deg, range 38) in nearly every tile while it lights almost none of it.")
FDS_FLAG_BOOL(cone_fine_tiles,          "FDS_CONE_FINE_TILES",          1,                              "deferred", "Volumetric cone pass uses the 12x8 lighting grid (96 tiles) instead of the coarse 6x4 (24). Same per-pixel work (byte-identical output — verified on conetest), but the cone-heavy tiles (disco/beam region) spread across 4x more work-stealing tasks -> less idle at the pass barrier (~8% off the greets central-room frame). HDR-safe (separate pass, runs after activation). Default on; set 0 for the legacy coarse 6x4.")
FDS_FLAG_BOOL(deferred_zcull,           "FDS_DEFERRED_ZCULL",           1,                              "deferred", "Cull G-buffer ROP writes against existing Z (default on)")
FDS_FLAG_BOOL(deferred_vec,             "FDS_DEFERRED_VEC",             FDS_DEFERRED_VEC_DEFAULT,       "deferred", "SIMD (8-omni) lighting tile kernel. Default ON for x86 (native AVX2), OFF for arm64 (neutral-to-slower via simde). Vec spec now respects cube-shadow+cone; still omits 2D spot-shadow maps + mirror-clone shadows.")
FDS_FLAG_BOOL(deferred_vec_force,       "FDS_DEFERRED_VEC_FORCE",       0,                              "deferred", "[test] Force the vec (SIMD) per-light path even for normal-mapped / AO-mapped pixels that normally divert to scalar. Loses the nmap perturbation (uses geometric N) — COST MEASUREMENT ONLY, lets the vec path run on heavy-light scenes like greets to A/B scalar-vs-vec (esp. with --pbr). Requires FDS_DEFERRED_VEC=1.")
FDS_FLAG_BOOL(deferred_outer_vec,       "FDS_DEFERRED_OUTER_VEC",       0,                              "deferred", "Outer-vec kernel (8 px x 1 omni); when unset, falls back to Scene::PreferOuterVec")
FDS_FLAG_BOOL(deferred_checkerboard,    "FDS_DEFERRED_CHECKERBOARD",    0,                              "deferred", "Half-rate lighting on a checkerboard pattern")
FDS_FLAG_BOOL(deferred_quarter,         "FDS_DEFERRED_QUARTER",         0,                              "deferred", "Quarter-rate lighting (one of every 2x2 pixels)")
FDS_FLAG_BOOL(deferred_no_spec,         "FDS_DEFERRED_NO_SPEC",         0,                              "deferred", "Skip specular term in tile kernel")
FDS_FLAG_BOOL(quarter_tex_sharp,        "FDS_QUARTER_TEX_SHARP",        1,                              "deferred", "C: in the quarter/checker fill, reconstruct each neighbour's LIGHTING (final / its own texel) and re-apply THIS pixel's own texel, instead of averaging final colours — keeps far-floor texture detail sharp under --deferred_quarter/--deferred_checkerboard instead of mushing it. LDR + HDR paths, both fills. Neighbours whose texel ratio exceeds 4 are excluded (trust region — the divide-out explodes on high-contrast textures, e.g. LED dots on black).")
FDS_FLAG_BOOL(pbr,                      "FDS_PBR",                      0,                              "deferred", "[test] Cook-Torrance microfacet specular (GGX NDF + Smith-Schlick geometry + Schlick Fresnel), SIMD 8-lights-wide, replacing Blinn-Phong in the vec spec path. Cost/quality probe — only affects pixels that take the vec path (no normal map). F0=0.04 dielectric.")
FDS_FLAG_FLOAT(pbr_roughness,           "FDS_PBR_ROUGHNESS",            0.0f,                           "deferred", "[test] Fixed roughness for --pbr (0..1). 0 = derive per-material from Glossiness (roughness=sqrt(2/(gloss+2))).")
FDS_FLAG_BOOL(deferred_unified_tbr,     "FDS_DEFERRED_UNIFIED_TBR",     1,                              "deferred", "Unified transparent + particle TBR. Default on — scenes without a TBR (city, greets) fall through to the legacy peel via the SBufferHead/NumTiles check in deferredUnifiedTbrEnabled().")
FDS_FLAG_INT  (xpar_peel_passes,        "FDS_XPAR_PEEL_PASSES",         1,                              "deferred", "Transparent depth-peel passes PER SIDE (front and back each), so total stacked layers = 2x this. Each pass peels one fragment farther than the last via a per-pixel peel floor, then composites it — fixes >2 overlapping transparents (nested fountain glass orbs sharing one mesh, stacked greets panels) that the single front/back peel drops. 1 = legacy 2-deep (byte-identical). Costs one extra transparent raster+composite pass per (mesh/clump, side) per increment; only transparent area pays.")
FDS_FLAG_BOOL(deferred_gloss_stats,     "FDS_DEFERRED_GLOSS_STATS",     0,                              "deferred", "Dump per-frame glossiness histogram")
FDS_FLAG_BOOL(deferred_tile_stats,      "FDS_DEFERRED_TILE_STATS",      0,                              "deferred", "Dump per-tile lighting cost stats")
FDS_FLAG_FLOAT(deferred_max_range,      "FDS_DEFERRED_MAX_RANGE",       0.0f,                           "deferred", "Optional Range cap used for culling only (0 = disabled)")
FDS_FLAG_BOOL(env_brdf_analytic,        "FDS_ENV_BRDF_ANALYTIC",        0,                              "deferred", "Analytic split-sum env-BRDF (Karis 'Mobile' SIGGRAPH-2014 polynomial fit to the pre-integrated GGX LUT) for the deferred env-specular reflection weight in EnvSpecComposeScalar (greets primary; city OuterVec scalar-fallback lanes). OFF (default) keeps the ad-hoc f90=1-rough Schlick weight (ek=fres*envReflGain), byte-identical. ON replaces it with ek=(f0*A+B)*envReflGain so rough reflections carry the roughness-dependent grazing scale+bias the split-sum requires (energy-correct). Disengages the city glass EnvComposeCityVec8 fast path (routes those lanes to the scalar compose, like --env_ssr) so the analytic form is used everywhere without an AVX2 exp2 reimpl. Needs --env_refl.")
FDS_FLAG_BOOL(sh_ambient,               "FDS_SH_AMBIENT",               0,                              "deferred", "L2 spherical-harmonic irradiance ambient: replaces the flat scalar Sc->Ambient constant in the deferred surface kernel with a 9-coefficient (27-float) RGB SH irradiance evaluated per-pixel along the shading normal (~9 FMAs/channel, NO texture read). Gives directional colored fill — sky tint from above, ground bounce from below — instead of one flat number, attacking the dark/flat look. At first use SHAmbient_EnsureBaked projects a scene-center environment cube (six faces rendered through the same deferred pipeline the env-reflection probes use) into the coefficients, A_l/pi folded in so a uniform environment evaluates back to its own color (magnitude-comparable to the flat ambient it replaces; SH ringing clamped >=0). The ambient still rides the material Diffuse * albedo multiply and any AO term, exactly like the flat path. OFF (default) is byte-identical to the flat-constant behavior. Applies to the OPAQUE kernel (scalar wave-1 + OuterVec vec-fill and scalar-fallback); transparent surfaces keep the flat ambient. One-shot bake per scene is nondeterministic on greets (shared env-bake root cause) so gate md5 pins with the flag OFF.")
FDS_FLAG_BOOL(diffuse_energy,           "FDS_DIFFUSE_ENERGY",           0,                              "deferred", "(1-F) diffuse energy conservation: scale the deferred DIFFUSE accumulator by (1 - fres) at the combine, where fres is the SAME per-pixel Schlick Fresnel the env-specular reflection already computed (EnvSpecComposeScalar / EnvComposeCityVec8). Light that reflects specularly (the Fresnel term F) cannot also diffuse, so the canonical dielectric BRDF weights diffuse by (1-F); the engine already scales diffuse by (1-metalness) but skipped (1-F), double-counting at grazing angles (full diffuse AND a strong Fresnel reflection). Fix darkens diffuse subtly at glancing edges (less blown-out grazing highlights) on reflective dielectrics. Only pixels with an env-reflection term (Reflection>0 / metal) pay — pixels with no reflection have no F and are unchanged. Applies to the OPAQUE kernel (scalar wave-1 = greets/fountain; OuterVec vec-fill + both scalar-fallback lanes = city glass); transparent surfaces carry no env term so keep full diffuse. OFF (default) is byte-identical. Needs --env_refl for anything to change.")
FDS_FLAG_BOOL(pbr_multiscatter,         "FDS_PBR_MULTISCATTER",         0,                              "deferred", "Multi-scatter energy compensation (Fdez-Aguera 2019) for the env-specular reflection. The split-sum env-BRDF (--env_brdf_analytic) is SINGLE-scatter only — it drops the energy returned by repeated microfacet bounces, so rough metals read too dark. Adds it back from the A,B split-sum terms --env_brdf_analytic ALREADY computes in EnvSpecComposeScalar (a few extra ALU ops on reflective pixels only, NO new gather): Ess=A+B (single-scatter energy), Favg=F0+(1-F0)/21 (avg Fresnel), Fms=Favg*Ess/(1-Favg*(1-Ess)) (multi-scatter multiplier), then specular *= 1 + Fms*(1-Ess)/Ess. DEPENDS ON --env_brdf_analytic: it needs the A,B terms, so with --env_brdf_analytic OFF this flag is a NO-OP (the ad-hoc Schlick weight computes no A,B). Only the env-specular term is brightened; the (1-F) diffuse Fresnel handed to --diffuse_energy is left at single-scatter. Applies to the OPAQUE kernel scalar env-compose (--env_brdf_analytic already routes city glass off the OuterVec fast path to this scalar compose). OFF (default) is byte-identical. Needs --env_refl + --env_brdf_analytic to change anything.")

// ─── shadows ─────────────────────────────────────────────────────────────
FDS_FLAG_BOOL(shadows,                  "FDS_SHADOWS",                  FDS_SHADOWS_DEFAULT_ON,         "shadows",  "Shadow mapping (requires deferred)")
FDS_FLAG_BOOL(shadow_polyid,            "FDS_SHADOW_POLYID",            FDS_SHADOW_POLYID_DEFAULT_ON,   "shadows",  "Use PolyId equality test instead of depth comparison")
FDS_FLAG_BOOL(shadow_polyid_no_pcf,     "FDS_SHADOW_POLYID_NO_PCF",     0,                              "shadows",  "Disable 2x2 PCF for the PolyId cube path — use a single nearest-neighbor tap instead. Diagnostic: lets you see how much of the intra-mesh material-boundary darkening comes from PCF blurring the artifact across 4 taps vs being intrinsic to the matID-vs-receiver identity test. With PCF the artifact spreads ~2 px; without PCF it shrinks to a 1 px sharp transition (but doesn't go away).")
FDS_FLAG_BOOL(shadow_backface_cull,     "FDS_SHADOW_BACKFACE_CULL",     0,                              "shadows",  "Cull back-facing tris from shadow maps")
FDS_FLAG_BOOL(shadow_validate,          "FDS_SHADOW_VALIDATE",          0,                              "shadows",  "Capture clipper outputs outside the input triangle hull")
FDS_FLAG_BOOL(shadow_prof,              "FDS_SHADOW_PROF",              0,                              "shadows",  "Per-light shadow timing")
FDS_FLAG_BOOL(shadow_bake_time,         "FDS_SHADOW_BAKE_TIME",         0,                              "shadows",  "Per-frame total wall-clock of the DYNAMIC shadow-map bake stage (Render_DeferredShadowMaps in a per-frame mode; the init StaticOnce bake is excluded). One [SHADOW-BAKE] line averaged over FDS_SHADOW_PROF_INTERVAL frames (default 60). Coarser than --shadow-prof (which splits xform/raster per light); use this for the single 'how long is the dynamic bake' number.")
FDS_FLAG_BOOL(shadow_prof_cache,        "FDS_SHADOW_PROF_CACHE",        0,                              "shadows",  "Per-frame shadow-sample cache-line transition stats")
FDS_FLAG_BOOL(shadow_cone_cull,         "FDS_SHADOW_CONE_CULL",         0,                              "shadows",  "Mesh-bsphere-vs-spot-cone cull during shadow-pass Transform_Objects")
FDS_FLAG_BOOL(shadow_skip_animated,     "FDS_SHADOW_SKIP_ANIMATED",     0,                              "shadows",  "Static shadow bake: skip meshes whose Pos spline has more than one key. Off by default — many scenes (greets) have *every* mesh animated, so skipping would leave shadow maps empty. Enable when the scene has real static occluders + a separate dynamic pass for moving meshes.")
FDS_FLAG_BOOL(shadow_dynamic,           "FDS_SHADOW_DYNAMIC",           0,                              "shadows",  "Per-frame dynamic-mesh shadow pass. For each static omni, re-renders only animated meshes into a parallel dynamic shadow buffer; lighting kernel samples min(static, dynamic). Pair with --shadow-skip-animated so the static bake is dynamic-mesh-free. Off by default — costs an extra Transform_Objects + raster per static omni per frame.")
FDS_FLAG_FLOAT(shadow_fzp_mult,         "FDS_SHADOW_FZP_MULT",          3.0f,                           "shadows",  "Shadow camera FZP multiplier over light IRange")
FDS_FLAG_BOOL(shadow_gbuffer_overlap,   "FDS_SHADOW_GBUFFER_OVERLAP",   0,                              "shadows",  "Stage A: run the per-frame dynamic shadow bake (Render_DeferredShadowMaps) on its own orchestrator thread concurrently with the gbuffer fill, joining before deferred lighting. Off by default — validate with FDS_THREADS=1 byte-identity + the 12-concurrent-bench STEADY-count (TSan-blind race class) before defaulting on. See docs/THREADING_OVERLAP_PLAN.md.")
FDS_FLAG_BOOL(vertex_light_parallel,   "FDS_VERTEX_LIGHT_PARALLEL",    1,                              "render",   "Fan the forward per-vertex Lighting() pass across the thread pool, one task per mesh (writes are per-mesh Verts -> disjoint; math untouched -> byte-identical to serial). The pool is parked during the scene tick, so this is free parallelism (~1 ms serial on greets). --no-vertex_light_parallel restores the serial walk.")
FDS_FLAG_BOOL(bake_tick_overlap,       "FDS_BAKE_TICK_OVERLAP",        0,                              "shadows",  "Dispatch the per-frame dynamic shadow bake BEFORE the serial tick chunk (main Transform + vertex Lighting + Radix) instead of after it, joining before Render — the bake's pool tasks run while the tick thread does its serial work (complementary resources, unlike Stage A's pool-vs-pool overlap which measured net-negative). Skipped while the mirror shatter is active (fresh shard meshes would race their first VertexScratch clone-init copy) and for the first frames (clone warmup). Mutually exclusive with --shadow-gbuffer-overlap. Default off pending the concurrent-bench STEADY validation (TSan-blind race neighborhood).")
#if FDS_DEV
FDS_FLAG_BOOL(dump_shadowmap,           "FDS_DUMP_SHADOWMAP",           0,                              "shadows-dev", "[dev] Dump shadow map to PGM on first frame")
#endif
FDS_FLAG_INT(shadow_bias,               "FDS_SHADOW_BIAS",              512,                            "shadows",  "Constant Z bias for shadow comparison")
FDS_FLAG_INT(shadow_slope_bias,         "FDS_SHADOW_SLOPE_BIAS",        1024,                           "shadows",  "Slope-scale Z bias for shadow comparison")
FDS_FLAG_BOOL(shadow_lightmap,          "FDS_SHADOW_LIGHTMAP",          0,                              "shadows",  "Pre-bake per-face shadow factor for static omnis into TriMesh::staticShadowLM at scene init; deferred kernel reads the lightmap instead of doing a per-pixel cube-shadow tap on static meshes. Off by default — bake is opt-in until kernel hookup ships.")
FDS_FLAG_INT(shadow_lightmap_res,       "FDS_SHADOW_LIGHTMAP_RES",      16,                             "shadows",  "Per-face lightmap edge length N (atlas is N×N per face). Defaults to 16 → 256 texels/face/omni. Powers of two recommended.")
FDS_FLAG_INT(shadow_lightmap_viz,       "FDS_SHADOW_LIGHTMAP_VIZ",      0,                              "shadows",  "Debug viz mode: render lightmap data instead of normal lighting. 0 = off; 1 = lightmap meshLMId (greyscale, 0=red); 2 = faceIdx (color hash); 3 = bary s (red→green); 4 = bary t (red→blue); 5 = lightmap factor for omni 0 nearest-neighbor (greyscale); 9 = bary world delta: |interp(F.A/B/C->Pos, runtime bary) - pixel world from depth|. Green ≤0.1, yellow ≤0.5, orange ≤1.0, red >1.0. Tests whether bary points to the pixel's actual 3D position on F's plane.")
FDS_FLAG_BOOL(shadow_lightmap_recompute_bake, "FDS_SHADOW_LIGHTMAP_RECOMPUTE_BAKE", 0,                    "shadows",  "Debug: in resolveCubeAtten, skip the atlas bilinear lookup and call SampleStaticCubeAtWorld(pixelWorldPos) per pixel — same code the bake uses. Verifies the bake function matches CubeShadow_Sample. (Has been bit-perfect since the depth-compare bake landed.)")
FDS_FLAG_BOOL(shadow_lightmap_recompute_at_bary, "FDS_SHADOW_LIGHTMAP_RECOMPUTE_AT_BARY", 0,               "shadows",  "Debug: same as --shadow-lightmap-recompute-bake but sample at the world position the RUNTIME-STORED bary points to (interpolate face A/B/C world from the stamped sB/tB), not at the rendered pixel's world position. Mismatch with recompute-bake means the runtime bary doesn't correspond to the pixel's actual world position.")
FDS_FLAG_BOOL(shadow_lightmap_nearest,  "FDS_SHADOW_LIGHTMAP_NEAREST",  0,                              "shadows",  "Debug: use sampleNearest instead of sampleBilinear for the per-face atlas lookup. Helps separate bilinear cross-edge blend artifacts (then nearest gives crisp blocky shadow) from atlas-content artifacts (then nearest shows the same shape just sharper).")
FDS_FLAG_BOOL(shadow_lightmap_planar,   "FDS_SHADOW_LIGHTMAP_PLANAR",   0,                              "shadows",  "Bake + sample the per-face atlas in a world-axis-aligned planar projection (Quake/idTech trick) instead of the per-triangle (B-A, C-A) bary basis. Eliminates the sheared-lattice zig-zag on shadow edges that hits the bary atlas when the face isn't right-isoceles with axis-aligned legs. Picks the projection plane from the face's dominant cardinal axis (max |N.x/y/z|). Runtime sampler uses the pixel's world position instead of stamped bary.")

// ─── SoA vertex refactor (Phase 1+) ──────────────────────────────────────
FDS_FLAG_BOOL(soa_verify,               "FDS_SOA_VERIFY",               0,                              "soa",      "Verification: in Transform_Objects, after per-vertex transform, assert that the AoS-written and SoA-written values match bit-for-bit. ~free when off; quadratic-ish cost per vert when on. Default off; turn on during migration to catch drift between AoS and SoA write paths.")

// ─── rasterizer ──────────────────────────────────────────────────────────
FDS_FLAG_BOOL(rast_full_store,          "FDS_RAST_FULL_STORE",          1,                              "raster",   "When all 8 lanes of a tile row pass edge+Z, take a vector-store fast path. Mekalele: one wide store per G-buffer plane (normal/tangent/lightmapST/lightmapMF/shadowMatID) instead of an 8-lane scatter. ShadowBarry: direct compressed-Z store + broadcast polyId store instead of blendv RMW + per-lane scatter.")
FDS_FLAG_BOOL(rast_inside_template,     "FDS_RAST_INSIDE_TEMPLATE",     1,                              "raster",   "Mekalele rasterizer: dispatch apply_exact<true> for tiles the dispatcher proves are fully inside the triangle (conservative min_a/b/c test), eliding the per-row edge mask.")

// ─── sort ────────────────────────────────────────────────────────────────
FDS_FLAG_BOOL(no_sort,                  "FDS_NO_SORT",                  0,                              "sort",     "Bypass Radix_SortingASM — dispatch FList in transform order (correctness depends on the rasterizer being order-independent)")
FDS_FLAG_BOOL(tile_bbox_cull,           "FDS_TILE_BBOX_CULL",           1,                              "sort",     "S2/B5 per-tile face pre-reject: at FList-build time stamp each face's projected screen bbox into its FListEntry; the per-tile rasterizer walk (RenderInnerMekalele/RenderInner) 4-compare-rejects faces whose bbox misses the tile rect BEFORE dereferencing the Face — a rejected face costs only the sequential FListEntry read (skips the 3 scattered Vertex flag loads + the clipper entry). PURE reject (the clipper already clips to the tile → byte-identical output; near-plane-straddling faces keep the cover-all sentinel and are never rejected). Default ON; --no-tile_bbox_cull restores the un-culled walk for A/B + the byte-null baseline. General win at the 400k-poly poses (city/chase/displaced greets); scales with face count.")

// ─── transparency ────────────────────────────────────────────────────────
FDS_FLAG_BOOL(no_quad_sort,             "FDS_NO_QUAD_SORT",             0,                              "xpar",     "Skip quad reorder during sort")
FDS_FLAG_BOOL(xpar_force_twosided,      "FDS_XPAR_FORCE_TWOSIDED",      0,                              "xpar",     "Force transparent fills to be two-sided")
FDS_FLAG_BOOL(no_xpar_frontback,        "FDS_NO_XPAR_FRONTBACK",        0,                              "xpar",     "Skip front/back separation for two-sided xpar")
FDS_FLAG_BOOL(no_xpar_objgroup,         "FDS_NO_XPAR_OBJGROUP",         0,                              "xpar",     "Skip per-object grouping of xpar faces")
FDS_FLAG_BOOL(xpar_light_all,           "FDS_XPAR_LIGHT_ALL",           0,                              "xpar",     "Run every omni on every xpar pixel (vs per-strip)")
// ── screen-space refraction for transparent glass ──
FDS_FLAG_FLOAT(glass_refract,           "FDS_GLASS_REFRACT",            0.0f,                           "xpar",     "Screen-space refraction for transparent glass: warp the opaque background behind a transparent surface by the surface relief. Per glass pixel the transparent kernel Snell-refracts the view ray through the (normal-map-perturbed) surface normal and samples the ALREADY-COMPOSITED opaque scene (VPage, or g_hdrBuf under --hdr — whichever the peel writes) at the refracted ray's screen projection instead of straight through. 0 = OFF (byte-identical, zero cost). Value = offset strength (1 ~= the physical angular bend, >1 exaggerates the warp). Fresnel-weighted (more refraction head-on, less at grazing). Needs a transparent surface (Transparency>0 / XparBlendAlpha); relief comes from the material NormalMap sampled via an on-the-fly tangent (no NormalMap -> flat facets refract uniformly). Water (city) and mirror-mask walls (XparBlendAlpha<0) are skipped.")
FDS_FLAG_FLOAT(glass_refract_ior,       "FDS_GLASS_REFRACT_IOR",        1.5f,                           "xpar",     "glass_refract index of refraction for the Snell bend (air=1.0). 1.5 ~= glass; higher bends the refracted ray more. Also sets the Schlick Fresnel F0 = ((ior-1)/(ior+1))^2 that weights refraction vs grazing reflection (the offset is scaled by 1-Fresnel).")
FDS_FLAG_FLOAT(glass_refract_max,       "FDS_GLASS_REFRACT_MAX",        48.0f,                          "xpar",     "glass_refract maximum background sample offset in PIXELS (per-axis clamp), so strong relief or a high IOR can't sample wildly off the glass. Scale with resolution.")
FDS_FLAG_FLOAT(glass_refract_rough_blur,"FDS_GLASS_REFRACT_ROUGH_BLUR", 0.0f,                           "xpar",     "glass_refract frosted-glass blur: radius in PIXELS of a 5-tap plus-shaped blur of the refracted background fetch, scaled per pixel by the material RoughnessMap (white = rough = blurrier). 0 = sharp refraction (single tap). Needs glass_refract>0.")
FDS_FLAG_BOOL(glass_test,               "FDS_GLASS_TEST",               0,                              "xpar",     "[test] Configure the fountain's central 'mizraka glass' sphere and the spire orbs ('f_sphere'/'in shpere') as relief glass at scene init (bakes a relief normal map from each material's OWN diffuse via BakeNormalMapFromDiffuse, so it shares the diffuse's dimensions + swizzle) so --glass_refract has a normal-mapped transparent surface with the fountain scene behind it to warp. Default OFF (materials byte-unchanged). Fountain scene only.")
FDS_FLAG_BOOL(xpar_pbr,                 "FDS_XPAR_PBR",                 0,                              "xpar",     "PBR shading for TRANSPARENT surfaces: the transparent lighting kernel applies the material's full PBR stack like the opaque kernel does, so 'material X at 50%% transparency' keeps X's look instead of degrading to a flat transparent texture. Per pixel (when the material carries the map): NormalMap perturbs the shading normal for ambient/diffuse/specular (Mikkelsen on-the-fly tangent — the xpar G-buffer has no tangent plane; same LOD fade as opaque), AoMap / albedo-alpha AO attenuates the ambient term (x --ao_map_strength x Material::AoStrength), RoughnessMap modulates specular intensity (x --roughness_strength), MetallicMap kills diffuse + tints specular by the albedo (env-reflection for transparent metals is NOT wired — no env term in the xpar composite). Only the LIT inputs change; the alpha/additive blend math is untouched. Respects the same map gates as opaque (--no-nmap/--ao_map/--roughness_map/--metal_map). Water and HDR-mirror panels keep their dedicated paths. Default OFF = byte-identical.")
#if FDS_DEV
FDS_FLAG_BOOL(debug_xpar_ids,           "FDS_DEBUG_XPAR_IDS",           0,                              "xpar-dev", "[dev] Colorize transparent fills by object id")
FDS_FLAG_FLOAT(debug_xpar_min_area,     "FDS_DEBUG_XPAR_MIN_AREA",      0.0f,                           "xpar-dev", "[dev] Min triangle area for xpar debug coloring")
#endif

// ─── profiling ablation gates ────────────────────────────────────────────
FDS_FLAG_BOOL(prof_no_tex,              "FDS_PROF_NO_TEX",              0,                              "prof",     "Skip texture sample in deferred kernel")
FDS_FLAG_BOOL(prof_no_lights,           "FDS_PROF_NO_LIGHTS",           0,                              "prof",     "Skip omni loop in deferred kernel")
FDS_FLAG_BOOL(prof_no_spec,             "FDS_PROF_NO_SPEC",             0,                              "prof",     "Skip specular in deferred kernel")
FDS_FLAG_BOOL(prof_no_fog,              "FDS_PROF_NO_FOG",              0,                              "prof",     "Skip fog pass")
FDS_FLAG_BOOL(prof_no_cube_tap,         "FDS_PROF_NO_CUBE_TAP",         0,                              "prof",     "Diagnostic: skip the per-pixel cube-shadow tap in the deferred lighting kernel — resolveCubeAtten short-circuits to 1.0 (fully lit). Lets you measure how much of the receiver-side shadow cost is the tap itself vs the surrounding lighting math. Does NOT skip the shadow render (cube bake); only the runtime sample.")
FDS_FLAG_FLOAT(quarter_normal_cos,      "FDS_QUARTER_NORMAL_COS",       0.95f,                          "deferred", "Quarter-rate fill: minimum dot(N_center, N_neighbor) for the neighbor's shaded value to be averaged in. Wave-2 currently only checks matID equality; that misses curved surfaces (same hull material, different normals → different shading) and creates the cartoonish look on the robot. Threshold ~0.95 ≈ 18°. Lower → softer (more averaging, more artifacts). Set to 0 to disable the check entirely (legacy behavior).")
FDS_FLAG_FLOAT(quarter_z_jump,          "FDS_QUARTER_Z_JUMP",           0.04f,                          "deferred", "Quarter-rate fill: maximum |zEnc_center - zEnc_neighbor| / zEnc_center accepted before falling back to full shading. Detects silhouettes / material creases (which produce sharp depth steps even when both sides share matID and normal). Default 0.04 ≈ 4% relative depth change. 0 disables the check.")
FDS_FLAG_INT(nmap_lod_fade_start,       "FDS_NMAP_LOD_FADE_START",      2,                              "deferred", "Normal map LOD fade: the miplevel at which bump strength FIRES — at this mip the bump is already scaled by (1 - step). Below this mip, full bump (1.0). Above, drops by step per mip until 0. At distance the texture mip chain averages cleanly, but the normal map's per-mip averaged direction has shorter length → bump becomes high-frequency lighting noise. Set to a very high value (e.g. 16) to disable the fade. Use --nmap-lod-fade-start=0 --nmap-lod-fade-step=1 to fully disable the bump everywhere (useful to verify the path is firing).")
FDS_FLAG_FLOAT(nmap_lod_fade_step,      "FDS_NMAP_LOD_FADE_STEP",       0.33f,                          "deferred", "Normal map LOD fade rate per miplevel past --nmap-lod-fade-start. 0.33 → bump fades to zero over 3 mip levels. Lower = gentler fade.")

// ─── normals / textures ──────────────────────────────────────────────────
FDS_FLAG_BOOL(surf_smoothing_authored,  "FDS_SURF_SMOOTHING_AUTHORED",  0,                              "render",   "Honor the AUTHORED per-surface smoothing angle when MakeFacesIndependent rebuilds vertex normals, instead of the hardcoded global 30 deg crease + 'momy' special-case. Each surface's Material::MaxSmoothingAngle (radians, loaded from the LWO/FLD) is used as its smoothing threshold when its Surf_Smoothing flag is set (else that surface stays faceted). Averaging is restricted to the surface's own faces (a material boundary is always a hard edge, matching LightWave). Off by default (byte-identical to the legacy look, which relies on the 30 deg art choice). A per-surface sidecar 'surface|smoothAngle|value' override always wins over this. Greets/City/Crash authored ~89 deg on most surfaces, so turning this on makes the demo much smoother.")
FDS_FLAG_INT(texture_filter,            "FDS_TEXTURE_FILTER",           0,                              "render",   "Deferred opaque (city buildings) texture filtering. 0 = point sample (default; byte-identical to legacy — the G-buffer packs a 20-bit integer swizzled texel address so the lighting kernel point-samples at texel granularity → full-facade texture crawl as surfaces pan sub-texel). 1 = bilinear, 2 = trilinear. When >0 the Mekalele rasterizer samples the diffuse texel with the UV FRACTION (only present at raster time) and writes the FILTERED BGRA color to a new G-buffer albedo plane; the deferred kernel reads that instead of chasing the packed texel. Metal/rough/AO/normal maps stay point-sampled. Forward (glass/water/additive TheOtherBarry) path is out of scope — unaffected.")
FDS_FLAG_BOOL(no_nmap,                  "FDS_NO_NMAP",                  0,                              "nmap",     "Force flat normals everywhere")
FDS_FLAG_FLOAT(nmap_strength,           "FDS_NMAP_STRENGTH",            1.5f,                           "nmap",     "Sobel-bake strength: higher = more pronounced bump")
FDS_FLAG_INT(nmap_blur,                 "FDS_NMAP_BLUR",                4,                              "nmap",     "Box-blur passes (3x3) applied to luminance before Sobel (0 = no blur)")
// ─── per-material AO map (PBR) ────────────────────────────────────────────
FDS_FLAG_BOOL(ao_map,                   "FDS_AO_MAP",                   1,                              "ao",       "Enable per-material AO map sampling (Material::AoMap), multiplied into the deferred ambient term (direct light is shadow-occluded, not AO'd). Composes with screen-space SSAO/GTAO.")
FDS_FLAG_FLOAT(ao_map_strength,         "FDS_AO_MAP_STRENGTH",          2.0f,                           "ao",       "AO map strength: ao' = 1 - strength*(1-ao). 0 = no occlusion, 1 = full map, >1 = exaggerated. Multiplied per material by Material::AoStrength (editor 'aoStrength').")
FDS_FLAG_BOOL(ao_direct,                "FDS_AO_DIRECT",                0,                              "ao",       "S4b: apply the AO map to DIRECT diffuse light too, not just ambient (docs/OPTIMIZATION_BACKLOG.md S4b). Default OFF keeps the canonical AO-on-indirect-only behavior (byte-identical). ON MOVES the AO multiply from the ambient-only term to the FINAL combined diffuse (ambient + direct diffuse) after the per-light loop, using ao_direct_strength as its dial (specular is NOT AO'd — it's a highlight). This is a static, acne-free stand-in for the per-block mortar SELF-SHADOW that the single-shadow-id collapse (the greets displaced-stone acne fix) removed: without it the disco light rakes straight into the recessed mortar grooves and the blocks read flat (light 'bleeding' between stones). Applies to the OPAQUE kernel (scalar wave-1 = greets/fountain + the vec inner loop, which rejoin before the combine; the quarter/checker fill inherits it via the reconstructed lit seeds). Needs a material with AO available (Mat_AoInAlpha albedo-alpha, or an AoMap) + --ao_map on.")
FDS_FLAG_FLOAT(ao_direct_strength,      "FDS_AO_DIRECT_STRENGTH",       1.0f,                           "ao",       "S4b (--ao_direct): strength dial for the AO applied to the FINAL combined diffuse: ao' = 1 - ao_direct_strength * Material::AoStrength * (1 - ao). Kept SEPARATE from ao_map_strength (the ambient-only dial, default 2.0) so the direct-light groove darkening is a distinct look call. Because --ao_direct MOVES the single AO multiply here (ambient is no longer occluded at its own step), this dial governs the occlusion of BOTH the ambient and the direct diffuse: 0 = the moved multiply is identity (no AO on either — so don't run --ao_direct at 0, just leave it off), 1 = full map, >1 = exaggerated. Only read when --ao_direct is on.")
FDS_FLAG_INT(nmap_viz,                  "FDS_NMAP_VIZ",                 0,                              "parallax", "Normal debug viz (deferred, post-tonemap): 0 = off; 1 = G-buffer geometric normal as RGB (n*0.5+0.5); 2 = final shaded normal with the material's normal map applied through the TBN (what lighting actually uses — flipped-G conventions show as inverted relief here); 3 = raw normal-map texel RGB at the pixel's sampled UV (no map → dim gray).")
FDS_FLAG_BOOL(env_refl,                 "FDS_ENV_REFL",                 0,                              "parallax", "Deferred env-specular reflection: materials with Reflection > 0 add an equirect-panorama sample along the per-pixel reflected view direction (specular IBL tier). The panorama is baked ONCE per scene from the camera position at first use (EnvReflection_EnsureBaked — a static approximation, not a live RTT) and attenuated by the roughness map like the analytic highlight. Materials with Reflection == 0 pay nothing.")
FDS_FLAG_FLOAT(env_refl_gain,           "FDS_ENV_REFL_GAIN",            1.0f,                           "parallax", "Env-reflection intensity multiplier on top of the material's Reflection percentage.")
FDS_FLAG_BOOL(metal_map,                "FDS_METAL_MAP",                1,                              "parallax", "Per-material metalness map (Material::MetallicMap): metal pixels lose diffuse, tint their specular + env reflection by the albedo, and reflect at near-full strength (F0→1). Needs --env_refl for the reflection part to show. --no-metal_map disables sampling (map still loads).")
FDS_FLAG_INT(env_refl_res,              "FDS_ENV_REFL_RES",             512,                            "parallax", "Env-reflection panorama resolution (square equirect, clamped 64-1024; cube faces render at half this). Superseded by env_bake_res when THAT is set explicitly. Applies to NEW bakes — rebake (editor button / EnvReflection_Invalidate) to change existing ones. Memory ~res²×4×1.33 per reflective surface.")
FDS_FLAG_INT(env_bake_res,              "FDS_ENV_BAKE_RES",             256,                            "parallax", "Env-reflection bake FACE resolution: per-face pixels of the deferred per-surface probe stores (auto-baked probes AND the city per-building registered stores; legacy equirect stores bake at 2x this). Power of two in 64..1024 — other values are clamped/rounded down with a stderr note (the mip chain + shift-indexed samplers need halvable dims). Default 256 = today's effective size; only an EXPLICIT set (CLI/env) overrides — unset keeps the legacy env_refl_res/2 sizing and the city stores' caller-chosen 256, byte-identical. City building stores cap at their 512² source bake. Applies to NEW bakes — rebake to change existing ones. Memory ~6×res²×4×1.33 per store.")
FDS_FLAG_INT(env_refl_scene_mode,       "FDS_ENV_REFL_SCENE_MODE",      0,                              "parallax", "LIVE/CLI override of the scene-wide env-reflection default (-1 none / 0 auto / 1 all) for materials whose per-surface envRefl is 0 (auto). The AUTHORED value lives in the FLD scene header (LWS 'FdsSceneEnvRefl' via tools/lwsread; Scene::EnvReflSceneMode); this flag wins over it only when EXPLICITLY set (CLI/env/editor). Per-surface envRefl +-1 always wins over both; the env_refl master switch still gates the whole env pass. 1 = every auto material bakes/publishes a probe, -1 = none do.")
FDS_FLAG_INT(env_bake_res_scene,        "FDS_ENV_BAKE_RES_SCENE",       0,                              "parallax", "LIVE/CLI override of the scene-wide default env-probe bake FACE resolution (pow2 64..1024, 0 = unset). The AUTHORED value lives in the FLD scene header (LWS 'FdsSceneEnvBakeRes'; Scene::EnvBakeResScene). Full sizing chain (envBakeResOverride): per-surface envBakeRes > explicit --env-bake-res > THIS flag when explicitly set > FLD scene header value > legacy env_refl_res/2 sizing. Applies to NEW bakes - rebake to change existing ones.")
FDS_FLAG_INT(env_bake_res_cap,          "FDS_ENV_BAKE_RES_CAP",         0,                              "parallax", "SAFETY CEILING on the per-probe env-bake FACE resolution (pow2 64..1024; 0 = no cap). Applied AFTER the whole sizing chain so a per-surface/scene/global wish larger than this is clamped DOWN at bake time — the store records the capped size and every consumer reads its own dims, so mixed-res stores still coexist. Exists for the 4GB wasm editor: greets sits near the ceiling and a full re-bake of every reflective surface at 512+ can spike a probe's transient (color+Z16+6 faces ~= 30*res^2 bytes) past 4GB -> 'memory access out of bounds'. Under __EMSCRIPTEN__ this defaults to 256 (~2MB/probe) even when unset; native defaults to 0 (uncapped) so the pinned baselines stay byte-identical, but --env-bake-res-cap can force it natively for testing.")
FDS_FLAG_INT(env_refl_viz,              "FDS_ENV_REFL_VIZ",             0,                              "parallax", "Env-reflection pano viewer: blit the Nth (1-based) baked panorama over the top-right corner, post-tonemap. 0 = off. Beyond-count clamps to the last pano.")
FDS_FLAG_BOOL(env_bake_fix,             "FDS_ENV_BAKE_FIX",             0,                              "parallax", "FIXED env-reflection auto-bake (EnvReflection_FramePrep probes): per-face projection actually published (legacy rendered every cube face with the MAIN camera's FOVX on the small bake surface — a few-degree telephoto sliver instead of a 90-degree face, i.e. mostly-void panos), FACE-level self-exclusion instead of whole-mesh (greets merges momy + the whole room into one TriMesh; the mesh skip emptied the probe), multi-instance exclusion radius (sibling statues stay visible in each other's probes), metal-without-store neutralization during bakes (siblings no longer bake black), and stale main-view mirror-mask neutralization. Default OFF to keep the pinned city baseline byte-identical (city vehicle glass probes bake through this path); the EDITOR always enables it, and importing a metallic map / a sidecar map auto-defaults it on.")
FDS_FLAG_BOOL(env_cube,                 "FDS_ENV_CUBE",                 1,                              "parallax", "Environment maps as six PADDED cube faces with a trig-free dominant-axis lookup (FDS/RENDER/EnvCube.h), replacing the equirect panorama in BOTH env consumers (deferred per-pixel --env_refl and the forward per-vertex reflective path CITY uses). Sharper reflections (no pole waste / stitch resample), no wrap seam, cheaper lookup (no atan2/asin). Default ON since slice D (validated: gates + flag-off pins byte-identical, no seams, bench <= equirect); --no-env_cube restores the equirect path bit-identical. Set FDS_ENV_CUBE_SELFTEST=1 to run the convention round-trip self-test at startup.")
FDS_FLAG_BOOL(city_env_pixel,           "FDS_CITY_ENV_PIXEL",           0,                              "parallax", "EXPERIMENT: city windows reflect PER PIXEL through the deferred kernel instead of the forward per-vertex TEXTURETEXTURE filler. Window faces skip Face_Reflective, so they enter the G-buffer with their per-building cloned matID; the deferred env-specular compose (--env_refl required) samples the cube store EnvReflection_FramePrep auto-bakes for each windows material — per-pixel reflected directions (no vertex interpolation, nothing to pop) + AABB parallax correction + roughness mips + Fresnel. Skips the per-building forward face bake entirely (city init faster; no city_envmap*.bin needed). Look differs from the legacy half-add composite by design.")
FDS_FLAG_FLOAT(env_sphere_parallax,     "FDS_ENV_SPHERE_PARALLAX",      0.0f,                           "parallax", "Sphere-proxy parallax for centroid-anchored direction-only env stores (city noParallax): intersect the reflected ray FROM THE PIXEL with a sphere of this radius (world units) around the bake point, look up toward the hit. Positional reflections everywhere — low pixels see LOW content (neighbor bases, waterline) — with zero seams by construction (a sphere has no edges, unlike the whole-city AABB that banded, and no horizon blend, unlike the plane fake that tore). 0 = off. Try 1500-4000 in city (street-canyon scale); larger = weaker correction.")
FDS_FLAG_INT  (env_ssr,                 "FDS_ENV_SSR",                  0,                              "parallax", "Short-range SCREEN-SPACE reflection for the deferred env compose (city glass): max march steps (spike default 8; 0 = off). Fills the self-reflections the centroid-anchored cube stores miss (a building's own ledges/wings — the bakes exclude the own building). Marches the reflected VIEW ray a few steps against the depth buffer; on a hit, blends the PREVIOUS-FRAME color (1-frame-stale — sampling live VPage races the concurrent tile writes) into the cube result BEFORE Fresnel, so the hit rides the same Fresnel/roughness/metal weighting. The sphere-corrected cube stays as fallback (SSR wins on hit, fades to the cube at every failure mode). Needs --env_refl (+ --city_env_pixel for city glass). Scalar-only compose while on (disengages the OuterVec env fast path). Requires renderFrame's prev-frame copy (~0.5-1ms).")
FDS_FLAG_FLOAT(env_ssr_stride,          "FDS_ENV_SSR_STRIDE",           4.0f,                           "parallax", "env_ssr: screen-space pixels advanced per march step (short-range by design — total reach = env_ssr steps * this). A constant view-space dt is derived from the projected ray gradient at t=0 so each step advances ~this many px.")
FDS_FLAG_FLOAT(env_ssr_thick,           "FDS_ENV_SSR_THICK",            40.0f,                          "parallax", "env_ssr: depth thickness (world/view units) for hit acceptance — a hit counts when the ray passes behind the stored surface by less than this. Also the continuous thickness fade: the SSR contribution ramps to zero as the crossing depth approaches this, so the hit boundary never seams.")
FDS_FLAG_FLOAT(city_env_f0,             "FDS_CITY_ENV_F0",              60.0f,                          "parallax", "city_env_pixel: window glass F0 as a Reflection percent (Fresnel base at normal incidence; grazing still pulls toward 1). 40 ~= the authored half-add energy; raise for mirror glass, lower for subtle.")
FDS_FLAG_FLOAT(city_env_lum,            "FDS_CITY_ENV_LUM",             0.45f,                          "parallax", "city_env_pixel: window glass emissive Luminosity (the texture base the reflection rides on). 0.45 ~= the authored texel*ambient brightness; the glass takes NO per-pixel dynamic lighting by design (the sweeping searchlight pools were the scripted-cam jumping).")
FDS_FLAG_FLOAT(city_env_gloss,          "FDS_CITY_ENV_GLOSS",           24.0f,                          "parallax", "city_env_pixel: window glass Glossiness -> reflection mip depth (rough = sqrt(2/(gloss+2)), mip = rough*3). THE dancing-vs-sharpness dial: at ~17-20 fps the world steps several units per displayed frame, and sharp store content on glass strobes (temporal aliasing — no history buffer to filter with). Lower = deeper mip = frostier + calmer (24 ~= mip 1.3, 64px-tier content); raise toward 96 for sharp mirror glass if the strobing is acceptable.")
FDS_FLAG_BOOL(env_live_water,           "FDS_ENV_LIVE_WATER",           0,                              "parallax", "LIVE water in the baked env reflections (city windows): env-sample directions that hit the water plane (ray from the store's bake point, below horizon, inside the water extent) are perturbed by the SAME animated wave-slope field the main-view reflection ripple uses (pwater::WaveSlope, same clock/scale), so the frozen mirror content in window reflections undulates in sync with the live water. Applies to BOTH consumers: the forward per-vertex reflective path (Transform.cpp) and the deferred env-specular compose (scalar + OuterVec lane fetch). Static-bake content itself is untouched — this warps the lookup, exactly like the main view's dispMap ripple warps the RTT. No-ops when water_ripple is off or the scene never publishes a water plane (only CITY does).")
FDS_FLAG_FLOAT(env_live_water_amp,      "FDS_ENV_LIVE_WATER_AMP",       0.10f,                          "parallax", "env_live_water direction-perturb amplitude: lookup dir += amp * waveSlope (slope range ~±2). 0.1 = a few degrees of wobble, comparable to the main-view ripple; higher = choppier reflected water.")
FDS_FLAG_BOOL(env_live_water_shade,     "FDS_ENV_LIVE_WATER_SHADE",     1,                              "parallax", "env_live_water: ALSO bake the city probes' water region as PROCEDURAL water instead of the static authored texture. The default bake composites the water mesh's static albedo over the mirrored world — dead against a --water_procedural main view. When env_live_water is on AND the city's procedural water is effective (water_procedural / sidecar tri-state), the bake hides the water mesh (pure mirrored underlay) and re-shades every unoccluded water-plane texel with the main view's formula: deep*(1-F) + underlay*F fresnel + the caustic-cell modulation (wave clock frozen at 0 — the sample-time perturb supplies motion). Both env consumers inherit (sheets + deferred stores derive from the same faces). The cube cache is BYPASSED for these bakes (fresh ~4s init; the on-disk cache stays the pristine static bake). --no-env_live_water_shade = perturb-only on the static bake.")
FDS_FLAG_BOOL(env_dynamic,              "FDS_ENV_DYNAMIC",              0,                              "parallax", "Live DYNAMIC-mesh env reflections (ENVDYN Workstream A, docs/ENVDYN_DISPLACEMENT_PLAN.md): the moving mech (and future movers) rendered LIVE into the env-reflection probes the user FLAGS via the per-surface 'dynamic env' editor checkbox (Material::EnvDynamic / RVSF bit 0x400). Each frame, before the main Transform, an overlay pass re-renders ONLY the dynamic meshes into each flagged probe's touched cube faces and composites them over the probe's retained static capture (A2), so the mech appears in the reflection instead of being structurally absent. Gated by a per-probe camera-frustum owner gate + mech-bsphere / padded-face-pyramid relevance cull (Foundation F). OFF (default) = byte-null: no flagged probes touched, no overlay runs. Needs --env_refl + --env_cube (default on). Overlay shading samples other probes' STATIC content only (no 2nd-bounce mech).")
FDS_FLAG_INT(env_dynamic_budget,        "FDS_ENV_DYNAMIC_BUDGET",       2,                              "parallax", "env_dynamic: max flagged probes refreshed by the dynamic-mesh overlay per frame (round-robin when more are relevant). Each touched probe costs one dynamic-only Transform + deferred raster/shade per touched cube face (typically 1-2 faces) + a per-face mip refilter. Lower to cap the per-frame overlay cost; 0 disables the overlay (like --no-env_dynamic).")
FDS_FLAG_BOOL(draw_aabbs,               "FDS_DRAW_AABBS",               0,                              "cull",     "DEBUG overlay (Foundation F, docs/ENVDYN_DISPLACEMENT_PLAN.md): draw every TriMesh's world-space AABB as a wireframe over the final frame (post-tonemap), projected through the main camera. GREEN = static mesh (box computed once, post first transform), YELLOW = dynamic mesh (isDynamicForBake — box recomputed each frame by transforming the cached model-space AABB corners into world space), dim RED = mesh whose AABB the main-camera 6-plane frustum test rejects. For eyeballing the world-AABB build + frustum-vs-AABB reject that gates the dynamic env-reflection overlay (Workstream A). Off by default; when off, WorldAabb_UpdateScene is never called and nothing is drawn (byte-null).")
FDS_FLAG_BOOL(parallax,                 "FDS_PARALLAX",                 1,                              "parallax", "Per-material PARALLAX (offset) mapping from Material::HeightMap. In the Mekalele G-buffer pass, the per-pixel UV is nudged along the tangent-space view direction by the sampled height before the texel pack, so albedo/normal/AO all sample the parallax-shifted texel — fakes surface depth (mortar joints, cobbles) with NO added geometry and no silhouette change. Off by default; needs a HeightMap on the material. Adds a height texture gather to the rasterizer's hot loop (the only pass with the smooth float UV).")
FDS_FLAG_BOOL (nmap_16bit,              "FDS_NMAP_16BIT",               1,                              "parallax", "Pack normal maps to 16-bit RG (X,Y; Z reconstructed in-shader as √(1-x²-y²)) instead of 32-bit BGRA — HALF the normal-map memory + cache, visually equivalent (RG are the same 8-bit values; a unit normal's Z is determined by X,Y). The deferred kernel's decode branches on the texture's BPP, so 32-bit normals are byte-unchanged. Off by default; greets converts its authored stone normals via MakeNormal16 when on. The variable-texel-size win generalized from the 8-bit parallax height to normals.")
FDS_FLAG_BOOL (roughness_map,           "FDS_ROUGHNESS_MAP",            1,                              "parallax", "Per-material roughness map (Material::RoughnessMap): modulate per-pixel SPECULAR INTENSITY by the map (white=rough→dimmer highlight) so highlights break up across the surface (matte mortar vs glinty stone) instead of a uniform sheen. Cheap tier — intensity only, keeps the compile-time gloss exponent (no per-pixel pow). One 8-bit gather in the deferred kernel, only where the material has a roughness map AND specular is active. --no-roughness_map disables.")
FDS_FLAG_FLOAT(roughness_strength,      "FDS_ROUGHNESS_STRENGTH",       1.0f,                           "parallax", "Roughness map strength: specMul = 1 - strength*roughness. 0 = ignore the map (uniform spec), 1 = full map, >1 = exaggerated matte/gloss contrast.")
FDS_FLAG_FLOAT(parallax_strength,       "FDS_PARALLAX_STRENGTH",        0.3f,                           "parallax", "Parallax UV-offset scale (UV units at (height-0.5)×grazing). Offset = (h-0.5)*strength*tangentViewXY. Geometry/angle dependent: ~0.04 was sub-texel (invisible) on the greets wall at the test pose; ~0.15-0.4 reads as stone relief; too high smears/swims at grazing (offset parallax has no self-occlusion to mask the stretch). TUNE LIVE on a clean wall — greets snapshot frames are washed out by god-rays/bloom.")
FDS_FLAG_BOOL(pom_viz,                  "FDS_POM_VIZ",                  0,                              "parallax", "Parallax debug viz: materials with a HeightMap render the HEIGHT FIELD (grayscale, sampled at the final post-march UV) instead of their albedo — the parallax result made directly visible: block domes, mortar cuts, and any march terracing/step-banding show as terraces in the gray. Needs --texture_filter>=1 (rides the filtered-albedo path). Lighting still applies, so view in a plainly-lit pose. Run: ./DEMO --deferred --texture_filter --pom_viz [--parallax_pom ...]")
FDS_FLAG_INT  (parallax_pom,            "FDS_PARALLAX_POM",             8,                              "parallax", "Parallax OCCLUSION mapping step count (docs/HEIGHTMAP_POM_PLAN.md). 0 = off (single-shift, byte-identical). N>0 = N-step occlusion march that records the first ray/height-field CROSSING, anchoring relief to the true surface depth (self-occluding, NO swim like single-shift's float). DEFAULT drives the NAIVE linear march (N uniform steps, first rayH<=Hs crossing). N is the whole tap budget, so low N is coarse: measured on greets@t=5780, naive-8 lands ~32 texels (strength 0.3) to ~108 texels (strength 1.0) from the true crossing — cheap but under-converged. --parallax_pom_cone selects the CONE march instead (relaxed cone-step to BRACKET the crossing + binary-search refine to LAND on it; --parallax_pom_relax widens the steps, --parallax_pom_refine sets the bisection count). The cone converges to the true crossing sub-texel in ~8 cone taps (median ~1 texel at strength 0.3) — far fewer than the naive ~256 needs for equal quality — but each cone tap is ~2.7x a naive tap (2nd gather + divide), so the cone is a big win for CONVERGED/swim-free quality, not a raw-cost win over the coarse naive-8. Cone uses a per-material cone map (Material::ConeMap, baked once at setup when --parallax_pom_cone is on). Needs --parallax + a HeightMap. STEP-3 LOD fades to single-shift with distance/angle.")
FDS_FLAG_INT  (parallax_pom_quarter,   "FDS_PARALLAX_POM_QUARTER",     0,                              "parallax", "Tier-2 STEP-2 quarter-res POM offset field: when set with --parallax_pom, run the cone march only on the even lanes/rows of each 8-wide raster block and reuse the resulting UV OFFSET for the odd neighbours (÷~4 the march cost). 0 = full-res march every pixel. The albedo/normal texel fetch stays full-res — only the offset SEARCH is subsampled. Bilateral (depth/height-aware) fill keeps recess silhouettes; a plain share is used where neighbours agree.")
FDS_FLAG_FLOAT(parallax_pom_lod,       "FDS_PARALLAX_POM_LOD",         0.0f,                           "parallax", "Tier-2 STEP-3 POM level-of-detail fade distance (view-Z units). 0 = no fade (full march everywhere --parallax_pom is on). >0 = the cone-march result is blended toward the tier-0 single-shift as view-Z grows past this, reaching pure single-shift at ~2× this distance, so far/oblique parallax pixels (most of them) skip the march. Continuous (no pop). Try ~30-50 in greets (view-Z ~[5..80]).")
FDS_FLAG_BOOL (parallax_pom_cone,      "FDS_PARALLAX_POM_CONE",        0,                              "parallax", "Select the relaxed CONE-STEP march for --parallax_pom instead of the default naive linear march. The cone brackets the first ray/height crossing then binary-refines onto it → converges sub-texel in ~8 taps (vs the naive's ~256 for equal quality), at ~2.7x per-tap cost. Off by default (the naive march is cheaper for the coarse tier). Needs --parallax_pom>0 + a baked Material::ConeMap.")
FDS_FLAG_INT  (parallax_pom_refine,    "FDS_PARALLAX_POM_REFINE",      6,                              "parallax", "Cone march (--parallax_pom_cone) binary-search refine iterations after bracketing the crossing. Higher = tighter sub-texel landing. 6 is ~1/64-step accurate; diminishing returns past that. No effect on the naive march.")
FDS_FLAG_FLOAT(parallax_pom_relax,     "FDS_PARALLAX_POM_RELAX",       4.0f,                           "parallax", "Cone march (--parallax_pom_cone) step-width relax factor: widens the conservative cone step so the ray brackets the crossing in fewer taps (the bisection then recovers the exact crossing inside the bracket). 1 = strict conservative (slow to bracket); higher brackets faster but overshoots more per step. 4 is the measured sweet spot on the greets stone relief.")
FDS_FLAG_INT  (pom_height_mip,         "FDS_POM_HEIGHT_MIP",           -1,                             "parallax", "FIX for the diagonal seams on the greets stone walls (the height map is now real, non-flat content). The parallax height/cone gathers sample the material's HeightMap at the per-FACE albedo miplevel, and faces come from the mipmap-via-subdivision clipper whose sub-face edges are DIAGONAL — so adjacent sub-faces at different mip levels read the height at different resolutions and the resulting UV OFFSET jumps across the diagonal boundary (a faint diagonal seam). This PINS the height (and its cone) mip to ONE fixed level for every face, with the height map's own dims/mask/scale threaded through the rasterizer ctx (independent of the albedo mip), so the sampled height is continuous across sub-face boundaries — height is low-frequency, so a single level is enough. -1 (default) = legacy per-face mip (byte-identical to before). >=0 pins that level (clamped to the map's mip range); 0 = full-res height, 1-2 = slightly coarser/cheaper and just as seam-free. Only affects parallax materials (greets stone); flag-off byte-null.")
FDS_FLAG_FLOAT(parallax_max_offset,    "FDS_PARALLAX_MAX_OFFSET",      0.0f,                           "parallax", "Clamp the per-pixel PARALLAX UV offset to at most this many TEXELS from the geometric UV (both single-shift and the POM march's final landing), mirroring --glass_refract_max for refraction. 0 = OFF (byte-identical, no clamp). The offset is (h-0.5)*strength*tangentViewXY; at strength >> the tuned ~0.3-0.4 it over-drives — the sampled UV streaks many texels and the stone blocks tear into diagonal smears crossing the mortar (the greets 'diagonal seam' at FDS_PARALLAX_STRENGTH=3 = 10x the tuned value; NOT a mip transition — the pose is ~all mip0 — and present with single-shift too, so not march banding). This bounds the streak length without disabling the effect: e.g. 6-12 texels keeps moderate relief while stopping the tear. The right fix is to keep strength in the tuned 0.15-0.4 band; this is the safety rail when a high strength is wanted. Applies to any parallax material (greets stone); needs --parallax + a HeightMap.")
FDS_FLAG_BOOL (pom_mip_viz,            "FDS_POM_MIP_VIZ",              0,                              "parallax", "DIAGNOSTIC for the stone-wall seam bug: tint each face's albedo by its per-FACE miplevel (a small color hash — mip0 red, mip1 green, mip2 blue, mip3 yellow, ...) so the mipmap-via-subdivision sub-face boundaries are directly visible. The diagonal color boundaries ARE the seam locations (--pom_viz shows the matching height-field discontinuity there); --pom_height_mip>=0 makes the height sampling ignore these boundaries. Rides the filtered-albedo path (needs --texture_filter>=1). Applies to every textured face, not only heightmap ones. Off by default.")
#if FDS_DEV
FDS_FLAG_BOOL(ao_from_diffuse,          "FDS_AO_FROM_DIFFUSE",          0,                              "ao-dev",   "[dev] Stand-in AO from the diffuse texture's luminance (no authored AO files needed) — proves the AO path on existing scenes.")
FDS_FLAG_BOOL(nmap_from_diffuse,        "FDS_NMAP_FROM_DIFFUSE",        0,                              "nmap-dev", "[dev] Derive normal map from diffuse")
FDS_FLAG_BOOL(viz_tangent,              "FDS_VIZ_TANGENT",              0,                              "nmap-dev", "[dev] Visualize per-pixel view-space tangent as diffuse color")
FDS_FLAG_BOOL(viz_normal,               "FDS_VIZ_NORMAL",               0,                              "nmap-dev", "[dev] Visualize per-pixel view-space normal as diffuse color (POST normal-map perturbation)")
FDS_FLAG_BOOL(viz_geonormal,            "FDS_VIZ_GEONORMAL",            0,                              "nmap-dev", "[dev] Visualize per-pixel GEOMETRY normal (the vertex-interpolated normal BEFORE the normal map perturbs it) as diffuse colour. A flat wall should be ONE solid colour; any variation (e.g. a diagonal kink along a quad's triangle split) is the geometry-normal interpolation. Pair with --viz-tangent to separate a normal crease from a tangent crease.")
FDS_FLAG_BOOL(viz_matid,                "FDS_VIZ_MATID",                0,                              "nmap-dev", "[dev] Visualize per-pixel matID as a deterministic colour (8-bit id hashed to BGRA) so you can see which face won z at each pixel. Use to verify reflected-floor pixels are actually the floor clone (and not some other face that happens to z-fight there).")
FDS_FLAG_BOOL(viz_pmid,                 "FDS_VIZ_PMID",                 0,                              "nmap-dev", "[dev] Visualize per-pixel mirror id (gb.mirrorId post-commit) as a deterministic colour. Distinct from --viz-matid because original + clone faces share material/matID — pmid is the only way to tell them apart per pixel.")
FDS_FLAG_BOOL(nmap_as_diffuse,          "FDS_NMAP_AS_DIFFUSE",          0,                              "nmap-dev", "[dev] Paint baked normal map directly as diffuse — confirms swizzle round-trip")
#endif

// ─── anti-aliasing ────────────────────────────────────────────────────────
FDS_FLAG_BOOL(aa,                       "FDS_AA",                       0,                              "aa",       "Edge-aware AA: a post-tonemap pass that blends a 5-tap cross only across G-buffer geometry edges (normal creases + depth/silhouette discontinuities). Removes jaggies without softening textures/interiors. Deferred path only.")
FDS_FLAG_FLOAT(aa_strength,             "FDS_AA_STRENGTH",              1.0f,                           "aa",       "Max blend weight at a detected edge (0..1). 1 = full 5-tap cross average at the strongest edges, scaled down by edge strength elsewhere; lower = subtler.")
FDS_FLAG_BOOL(aa_viz,                   "FDS_AA_VIZ",                   0,                              "aa",       "Debug: paint the AA edge map — detected geometry edges in green over a dimmed frame — instead of blending. Shows exactly which pixels --aa touches (silhouettes + creases). Requires --aa.")

// ─── display / present ───────────────────────────────────────────────────
FDS_FLAG_BOOL(no_vsync,                 "FDS_NO_VSYNC",                 0,                              "display",  "Disable SDL_RENDERER_PRESENTVSYNC — lets SDL_RenderPresent return immediately for benching real flip cost")

// ─── volumetric / atmospheric ────────────────────────────────────────────
FDS_FLAG_BOOL(draw_cones,               "FDS_DRAW_CONES",               0,                              "atmos",    "Draw volumetric spotlight cones (additive). Off by default; scene driver opts in.")
FDS_FLAG_BOOL(city_test_spots,          "FDS_CITY_TEST_SPOTS",          0,                              "atmos",    "Install 6 test spotlights in city for cone-overlay experimentation")
FDS_FLAG_FLOAT(cone_strength,           "FDS_CONE_STRENGTH",            0.05f,                          "atmos",    "Volumetric cone density (per-step contribution × 1e-3). 0.05 = subtle shafts, 0.5 = pea-soup fog")
FDS_FLAG_BOOL(volumetric_unified,       "FDS_VOLUMETRIC_UNIFIED",       0,                              "atmos",    "Use unified Beer-Lambert volumetric pass (replaces separate fog + cone passes; adds omni halos)")
FDS_FLAG_FLOAT(fog_sigma_mult,          "FDS_FOG_SIGMA_MULT",           3.0f,                           "atmos",    "Beer-Lambert extinction coefficient as multiple of 1/FZP. σ=mult/FZP → T(FZP)=exp(-mult). Default 3 = ~5% transmittance at FZP")
FDS_FLAG_FLOAT(omni_halo_strength,      "FDS_OMNI_HALO_STRENGTH",       0.0f,                           "atmos",    "Volumetric halo brightness scale for omnis (0 = no halos; 0.05 = subtle; 0.5 = strong). Runs in both unified and legacy pipelines (Render_OmniHalos standalone pass).")
FDS_FLAG_FLOAT(omni_halo_range_mult,    "FDS_OMNI_HALO_RANGE_MULT",     1.0f,                           "atmos",    "Global multiplier on every Omni's halo sphere radius (multiplies HaloRange when set, IRange otherwise). 1 = no change; use to scale halo footprints across a scene without editing every light.")
FDS_FLAG_FLOAT(omni_halo_force_range,   "FDS_OMNI_HALO_FORCE_RANGE",    0.0f,                           "atmos",    "Hard override: when > 0, every Omni's halo radius is forced to this value, ignoring IRange / HaloRange / omni_halo_range_mult. Cleanest way to tune halo footprints without compounding per-light settings.")
FDS_FLAG_BOOL(vol_prof,                 "FDS_VOL_PROF",                 0,                              "atmos",    "Per-frame timing for volumetric passes (cones/halos/unified). Prints averaged ms every FDS_VOL_PROF_INTERVAL frames.")
FDS_FLAG_INT(vol_n_samples,             "FDS_VOL_N_SAMPLES",            4,                              "atmos",    "Samples per pixel for volumetric ray-march. Lower = faster but noisier; 4 default (2× faster than 8 with only √2 more noise — best perf/quality knee per profiling).")
FDS_FLAG_BOOL(vol_cone_half_y,          "FDS_VOL_CONE_HALF_Y",          0,                              "atmos",    "Volumetric cone pass at half VERTICAL rate (even rows computed, written to both rows). Halves the pass cost but thins narrow beams — the 1-2px bright core line can fall between sampled rows (user-observed). Off by default; available for wide-cone scenes.")
FDS_FLAG_BOOL(vol_vec,                  "FDS_VOL_VEC",                  1,                              "atmos",    "Vectorize the per-sample inner loop in the cone/halo/unified passes (8-wide SIMD). Default on; --no-vol_vec falls back to scalar for A/B.")
FDS_FLAG_BOOL(vol_rect_cull,            "FDS_VOL_RECT_CULL",            1,                              "atmos",    "Per-batch (vec) / per-pixel (scalar) screen-rect cull in the cone tile fn. Skips the per-spot quadratic when the pixel/batch falls outside the spot's cone-bbox screen projection. Default on; --no-vol_rect_cull disables for A/B.")
FDS_FLAG_BOOL(vol_halo_analytic,        "FDS_VOL_HALO_ANALYTIC",        1,                              "atmos",    "Replace the halo per-sample ray-march with a closed-form arctan integral. Drops the (1-d/r)² near-edge softness (sharper boundary) but is ~8 ops/pixel vs N×30 ops. Default on; --no-vol_halo_analytic falls back to N-sample ray-march.")
FDS_FLAG_BOOL(vol_cone_analytic,        "FDS_VOL_CONE_ANALYTIC",        1,                              "atmos",    "Spotlight equivalent of vol_halo_analytic: closed-form arctan integral over the cone-clipped segment [zLo,zHi], coneAtten approximated at midpoint. Falls back to ray-march for shadow-casting spots (shadow lookup can't be integrated analytically). Default on.")
FDS_FLAG_FLOAT(vol_analytic_noise,      "FDS_VOL_ANALYTIC_NOISE",       0.08f,                          "atmos",    "Per-pixel multiplicative jitter strength applied to analytic halo / cone results. 0 = silky smooth analytic gradient; 0.08 = subtle dither matching ray-march visual noise; 0.2+ = heavy grain. Hashed from pixel coords so it's stable frame-to-frame.")
FDS_FLAG_FLOAT(cone_turbulence,         "FDS_CONE_TURBULENCE",          0.0f,                           "atmos",    "Animated turbulent density inside volumetric spotlight cones (drifting smoke/dust structure instead of uniform density). 0 = off (byte-identical legacy integration); 0..1 = modulation strength (0.5 = visible wisps, 1 = strong churn with dark voids). Noise field is WORLD-space value noise drifting with scene time, so beams read as sweeping through a static animated medium. Applies per segment (analytic hybrid) / per sample (ray-march); wide cones route through the segmented integrator while on.")
FDS_FLAG_FLOAT(cone_turb_scale,         "FDS_CONE_TURB_SCALE",          3.0f,                           "atmos",    "cone_turbulence noise cell size in WORLD units. Scene scale: greets beams span ~10-38 units -> 2-4 gives beam-width wisps; city beams are larger. Smaller = finer grain.")
FDS_FLAG_FLOAT(cone_turb_speed,         "FDS_CONE_TURB_SPEED",          0.5f,                           "atmos",    "cone_turbulence drift rate in noise cells/second (wind advection of the density field, fixed world direction). Also scales the swirl rotation rate. 0 = frozen structure.")
FDS_FLAG_FLOAT(cone_swirl,              "FDS_CONE_SWIRL",               0.0f,                           "atmos",    "Helical swirl of the cone turbulence around each beam's axis: samples rotate by angle = cone_swirl * (2*pi*axialDist/(8*cone_turb_scale)) + time phase before the noise lookup, producing corkscrew streaks that ride the beam. 0 = off; 1 = one full twist per 8 noise cells along the axis. Only active when cone_turbulence > 0.")
FDS_FLAG_INT(cone_turb_octaves,         "FDS_CONE_TURB_OCTAVES",        2,                              "atmos",    "Octaves of value noise for cone_turbulence (1 or 2). 2 adds a half-scale detail layer (~1.6x noise cost, richer wisps); 1 is the cheap single-scale look.")
FDS_FLAG_BOOL(deferred_skybox,          "FDS_DEFERRED_SKYBOX",          0,                              "atmos",    "Skybox-from-G-buffer pass. Paints pixels with zEnc==0 (no surface) by reconstructing view ray + sampling the sky cube. Off by default until visually validated. When on, the forward RenderSkyCube becomes redundant (perf win pending separate suppression).")
FDS_FLAG_BOOL(fast_fog,                 "FDS_FAST_FOG",                 0,                              "atmos",    "Analytic exponential fog post-pass (iquilezles model) that composes with the analytic cone/halo passes. Independent of Scn_Fogged so it can be toggled on clear scenes (city). Mixes pixels toward the scene Ambient color by 1-exp(-tau).")
FDS_FLAG_FLOAT(fast_fog_density,        "FDS_FAST_FOG_DENSITY",         3.0f,                           "atmos",    "fast_fog extinction as a multiple of 1/FZP: sigma = density/FZP. At the far plane tau~=density, so 3 => ~95% fogged. Higher = thicker.")
FDS_FLAG_FLOAT(fast_fog_height,         "FDS_FAST_FOG_HEIGHT",          0.0f,                           "atmos",    "fast_fog height falloff k in 1/world-units. 0 = uniform density. >0 = denser at low altitude (ground thickest), density(y) ~ exp(-k*y). Try ~1/(scene height) e.g. 0.0005 in city.")
FDS_FLAG_FLOAT(fast_fog_bottom,         "FDS_FAST_FOG_BOTTOM",          -1.0e9f,                        "atmos",    "fast_fog slab BOTTOM in world Y. Fog only fills the ray segment between bottom and top, so it reads as a bounded mass floating in the air rather than tinting every surface. Default -1e9 = no floor (unbounded below).")
FDS_FLAG_FLOAT(fast_fog_top,            "FDS_FAST_FOG_TOP",             1.0e9f,                         "atmos",    "fast_fog slab TOP in world Y. Set finite (e.g. 1000 in city) to cap the fog layer so building tops emerge above a discrete bank. Default 1e9 = no ceiling (unbounded above).")
FDS_FLAG_FLOAT(fast_fog_feather,        "FDS_FAST_FOG_FEATHER",         0.0f,                           "atmos",    "Softens the slab's top/bottom Y-cutoff over this many world units (smoothstep ramp) so the boundary doesn't show a razor-sharp horizontal line at grazing view angles. 0 = auto (20%% of slab thickness). Set explicit for tighter/softer edges.")
FDS_FLAG_FLOAT(fast_fog_dist_dim,       "FDS_FAST_FOG_DIST_DIM",        0.0f,                           "atmos",    "Blend the legacy 1998 distance darkening into the froxel/screen fog composite: the deferred SCENE term is scaled by 1-s+s*sqrt(max(0,1-z/FZP)) before fog layers on top, so far surfaces dim toward black at any altitude (aerial perspective the slab-bounded blob fog cannot give above its top). 0 = off (current look). 1 = the full legacy sqrt ramp. Skips sky (zEnc==0) and forward-filler pixels (mat sentinel), like the legacy pass.")
FDS_FLAG_FLOAT(fast_fog_dist_dim_far,   "FDS_FAST_FOG_DIST_DIM_FAR",    0.0f,                           "atmos",    "fast_fog_dist_dim reaches full darkness at THIS view distance (world units) instead of the far plane FZP. 0 = FZP (legacy). Lower to start the darkening earlier/steeper — e.g. 0.5*FZP makes mid-range visibly dimmer instead of compressing all the falloff near the horizon.")
FDS_FLAG_BOOL (mips,                    "FDS_MIPS",                     0,                              "render",   "Enable mip selection in MiplevelClipper (historically force-disabled via NO_MIPMAPS). NOTE most 1998 textures are low-res and MAGNIFIED at modern resolutions, so mips barely engage except on genuinely distant faces; the dominant texture shimmer is magnified point-sampling (needs bilinear, a filler change). The mip split path is historically buggy — watch for traversal artifacts when enabling. Combine with --mip-bias / --mip-hysteresis.")
FDS_FLAG_FLOAT(mip_bias,                "FDS_MIP_BIAS",                 0.5f,                           "render",   "Forward/G-buffer mip selection bias added to the per-face 0.5*log2(texel/pixel) metric before truncation. 0.5 = historical default. LOWER = finer mips held longer (sharper at distance, smaller pops when a face crosses a level; more texture aliasing/shimmer in exchange). Applies to the face-uniform paths of MiplevelClipper.")
FDS_FLAG_FLOAT(mip_hysteresis,          "FDS_MIP_HYSTERESIS",           0.0f,                           "render",   "Per-face mip switching hysteresis (in mip-metric units). 0 = off (historical: a face near a level boundary flips mips frame-to-frame — visible texture-detail flicker under camera motion, since the point-sampled fillers switch levels hard). ~0.25: a face must cross the boundary by this margin before switching, so boundary-straddling faces hold their level. Only +-1-level transitions are damped; cuts/jumps switch immediately.")
FDS_FLAG_BOOL(fast_fog_blobs,           "FDS_FAST_FOG_BLOBS",           0,                              "atmos",    "Fill the fog slab with procedurally-scattered blobs (one jittered sphere per world grid cell, closed-form cubic density per blob, 3D-DDA along the ray). Turns the smooth slab into a lumpy volumetric mass. Off = smooth slab.")
FDS_FLAG_FLOAT(fast_fog_cell,           "FDS_FAST_FOG_CELL",            400.0f,                         "atmos",    "Blob grid cell size in world units (= blob diameter). Smaller = finer, lumpier fog but more DDA cells/ray. Try ~1/4 of the slab horizontal extent.")
FDS_FLAG_FLOAT(fast_fog_blob_jitter,    "FDS_FAST_FOG_BLOB_JITTER",     0.35f,                          "atmos",    "Per-cell blob center jitter as a fraction of the cell size (0 = regular lattice, 0.5 = blobs can sit on cell faces). Breaks up the grid regularity.")
FDS_FLAG_BOOL(fast_fog_worley,          "FDS_FAST_FOG_WORLEY",          0,                              "atmos",    "Froxel blob field uses inverted Worley F1 (distance to the nearest jittered per-cell feature point) instead of trilinear value noise: density peaks AT scattered points and falls off radially, so fog reads as puffy rounded cloud masses instead of caustic-like veins. Size-modulated by a large-scale value-noise octave so puffs vary instead of forming a polka-dot lattice. Froxel path only; ~27 cell hashes per sample vs 8 (costs more).")
FDS_FLAG_FLOAT(fast_fog_worley_thresh,  "FDS_FAST_FOG_WORLEY_THRESH",   0.5f,                           "atmos",    "Worley puff cutoff: density reaches 0 at F1 = (1 - thresh) cells from a feature point. Higher = smaller, more separated puffs with clear air between (0.5 -> puff radius half a cell); lower = fatter merging masses. Range ~0.2-0.7.")
FDS_FLAG_FLOAT(fast_fog_blob_overlap,   "FDS_FAST_FOG_BLOB_OVERLAP",    0.0f,                           "atmos",    "Metaball-style ADDITIVE blob field (overrides worley/value noise when > 0): each cell's jittered blob contributes (1-(d/R)^2)^2 and overlapping blobs SUM, so density piles up where they stack - the 'lots of overlapping big blobs' cloud look that inverted-Worley F1 cannot express (nearest-distance is bounded; bigger radii just fill space uniformly). Value = blob radius in CELL units: 0.7 = separated puffs, 1.0 = touching, 1.2-1.5 = overlapping cloud masses (capped at 1.5, the 3x3x3 search limit). fast_fog_cell stays the spacing knob; this decouples size from spacing. fast_fog_worley_thresh is reused as the iso-threshold (where fog begins out of the summed field).")
FDS_FLAG_FLOAT(fast_fog_falloff,        "FDS_FAST_FOG_FALLOFF",         0.0f,                           "atmos",    "Distance (world units) over which fog density e-folds with view distance: density *= exp(-z/falloff). Makes fog a near-camera mass that thins out far away instead of forming a wall at the far plane. 0 = auto (= scene FZP). Smaller = tighter, closer fog.")
FDS_FLAG_BOOL(fast_fog_froxel,          "FDS_FAST_FOG_FROXEL",          1,                              "atmos",    "Froxel (view-frustum 3D grid) volumetric fog — THE fast_fog renderer. Populates density+in-scatter per froxel, integrates front-to-back along depth, trilinearly composites; temporal supersampling, distance-LOD, worley/metaball fields, glow compression and xpar fog all live on this path. Volumetric by construction (fog fills air, not painted on surfaces), no grazing speckle, cost decoupled from screen resolution. --no-fast_fog_froxel falls back to the LEGACY screen-space per-pixel march (value-noise only, glow speckles at grazing angles, saturates at high inscatter) — kept for A/B reference.")
FDS_FLAG_INT(fast_fog_froxel_x,         "FDS_FAST_FOG_FROXEL_X",        256,                            "atmos",    "Froxel grid width (columns). Coarse is fine — fog is low-frequency and the composite trilinearly upsamples.")
FDS_FLAG_INT(fast_fog_froxel_y,         "FDS_FAST_FOG_FROXEL_Y",        144,                             "atmos",    "Froxel grid height (rows).")
FDS_FLAG_INT(fast_fog_froxel_z,         "FDS_FAST_FOG_FROXEL_Z",        64,                            "atmos",    "Froxel grid depth slices (camera to fog far). More = finer depth resolution / less near-camera banding.")
FDS_FLAG_BOOL(fast_fog_froxel_temporal, "FDS_FAST_FOG_FROXEL_TEMPORAL", 1,                             "atmos",    "Temporal supersampling of the froxel grid: jitter the per-froxel sample position each frame (Halton 2/3/5), reproject each froxel's center into the previous frame's grid and blend the history in. Averages 8 sub-froxel positions over time, dissolving the XY stair/blockiness of the coarse grid without raising its resolution. Costs one history fetch per froxel; moving lights can show slight glow lag (lower fast_fog_froxel_blend if so).")
FDS_FLAG_BOOL(rain,                     "FDS_RAIN",                     0,                             "atmos",    "Screen-space rain: procedural streaks composited as a tile-parallel post pass (3 depth layers with parallax, z-buffer occluded, attenuated by the froxel/SS fog at each layer's depth, sinusoidal wind gusts). Works in any scene with a z-buffer; scene time drives the fall so pause freezes it. Read per frame - scriptable (e.g. ramp a storm in via SCRIPTS/<scene>.params).")
FDS_FLAG_FLOAT(rain_intensity,          "FDS_RAIN_INTENSITY",           1.0f,                          "atmos",    "Screen-space rain amount: scales streak density and opacity (0 = none, 1 = steady rain, 2+ = downpour). Per-frame / scriptable.")
FDS_FLAG_FLOAT(rain_speed,              "FDS_RAIN_SPEED",               1.0f,                          "atmos",    "Screen-space rain fall speed multiplier. Per-frame / scriptable.")
FDS_FLAG_BOOL(fast_fog_refl_depth,      "FDS_FAST_FOG_REFL_DEPTH",      1,                             "atmos",    "Fog the water's reflections at their MIRRORED path length (pass-1 Z, displaced through the wobble) instead of uniformly at the fog far plane — near buildings stay crisp in the mirror, far ones drown, matching the world above the waterline. City only (the scene hands the engine its reflection Z).")
FDS_FLAG_FLOAT(bolt_width,              "FDS_BOLT_WIDTH",               0.85f,                          "scene",    "Fountain lightning CORE ribbon half-width factor (px = POW * this * RZ * FOVX). Thin=0.8, fat=2.5. Per-strike / scriptable (SCRIPTS/fountain.params hot-reloads).")
FDS_FLAG_FLOAT(bolt_kink,               "FDS_BOLT_KINK",                0.30f,                         "scene",    "Fountain lightning texture ROUGHNESS: midpoint-displacement amplitude of the baked bolt texture (fraction of width). ~0.18 smooth, ~0.3 jagged, >0.4 wild. Changing it re-bakes the texture set (live, slight hitch).")
FDS_FLAG_FLOAT(bolt_seg,                "FDS_BOLT_SEG",                 1.0f,                          "scene",    "Fountain lightning BRIGHTNESS multiplier (additive). 1=default, <1 dimmer, >1 hotter/blown. Live / scriptable.")
FDS_FLAG_BOOL (bolt_geom,               "FDS_BOLT_GEOM",                1,                              "scene",    "Fountain lightning glow rendering: 1 = fully geometric untextured additive Gouraud ribbon (default — no texture bake/sample, clean at any zoom and at screen edges/forks), 0 = baked bilinear texture quad. Both share the geometric AA core line.")
FDS_FLAG_FLOAT(bolt_interval,           "FDS_BOLT_INTERVAL",            220.0f,                         "scene",    "Fountain lightning strike cadence in Timer units (smaller = more frequent strikes). Strikes fire periodically from the first scripted time through the scene at random spires; deterministic per index so it stays scrub-safe. ~120 = frantic, ~500 = sparse.")
FDS_FLAG_FLOAT(bolt_flash_peak,         "FDS_BOLT_FLASH_PEAK",          500.0f,                         "scene",    "Fountain strike-flash light ISize at full intensity (lights the froxel fog + nearby geometry). Keep it mostly BELOW --fast_fog_glow_max so the fog's 1/d^2 falloff shows (bright halo at the strike, dark away) instead of a flat bright wash that hides the bolt. 0 = no flash light.")
FDS_FLAG_FLOAT(bolt_flash_range,        "FDS_BOLT_FLASH_RANGE",         500.0f,                         "scene",    "Fountain strike-flash light reach in world units. Smaller = tighter halo around the bolt; larger spreads it across more fog (too large = whole-screen wash).")
FDS_FLAG_FLOAT(bolt_flash_decay,        "FDS_BOLT_FLASH_DECAY",         0.10f,                          "scene",    "Fountain strike-flash decay rate: intensity *= exp(-dTime*this) per frame. Larger = shorter/snappier flash (~0.05 ≈ a few frames); smaller = lingers.")
FDS_FLAG_BOOL(rain_lens,                "FDS_RAIN_LENS",                1,                             "atmos",    "On-camera droplets while --rain is active: refracting discs that stick to the 'lens', dwell, then trickle down and shrink. Spawn rate follows rain_intensity; scene time drives the motion (pause freezes). Deterministic (hash-seeded, no rand).")
FDS_FLAG_BOOL(city_rain,                "FDS_CITY_RAIN",                0,                             "scene",    "The 1998 city rain: 3000 camera-tracking drops (1px + transparent motion trail), sinusoidal wind gusts, spline-lookahead respawn. Read once at scene init (allocates the particle pool) — CLI/env only, not hot-scriptable.")
FDS_FLAG_BOOL(city_headlights,          "FDS_CITY_HEADLIGHTS",          0,                             "scene",    "RETIRED code scheme (LEGACY single nose spot per vehicle, re-aimed along motion each tick). Default OFF since 2026-07-11: the city headlights are AUTHORED lights now — 46 parented 'city headlight L/R' spots baked into Authoring/city/CITY1.LWS -> CITY.FLD — and turning this on would double-light every vehicle nose (and re-add the police strobe). Kept for A/B against the authored look. Volumetric beams when --draw_cones is on. Scriptable per-frame (city.params).")
FDS_FLAG_BOOL(city_headlights_front,    "FDS_CITY_HEADLIGHTS_FRONT",    0,                             "scene",    "RETIRED code scheme (front-row PAIR of spots per vehicle on the local-AABB front face, ±35% width, 15°/30° cones, warm white, parented wrappers). Default OFF: this exact scheme is what got baked as AUTHORED lights into Authoring/city/CITY1.LWS -> CITY.FLD (46 'city headlight L/R' spots, Omni_SceneAuthored -> editable in the editor lights list, grouped under their vehicles). Turning it on double-lights every vehicle front. Kept for A/B; the intensity/range knobs still shape the CODE lights only — the authored lights are edited per-light via the editor/LWS.")
FDS_FLAG_FLOAT(city_headlight_intensity,"FDS_CITY_HEADLIGHT_INTENSITY", 1.2f,                          "scene",    "Headlight beam intensity (spot ISize), both schemes. 0 also disables; ~2-4 reads well against the streetlights.")
FDS_FLAG_FLOAT(city_headlight_range,    "FDS_CITY_HEADLIGHT_RANGE",     1600.0f,                       "scene",    "Front-row headlight beam range in world units for a reference 50-unit-radius vehicle; each vehicle scales it by its world bounding radius / 50 (clamped 0.5x-1.5x, so the x18.9-scaled SHIP1 doesn't floodlight the city). The legacy nose scheme keeps its fixed 1600.")
FDS_FLAG_INT(fast_fog_froxel_taps,      "FDS_FAST_FOG_FROXEL_TAPS",     1,                             "atmos",    "Density samples per froxel per frame when temporal is on (1 or 2). 2 averages two opposite phases of the jitter cycle each frame — halves the temporal cycle's amplitude and doubles convergence, for roughly double the noise-field cost in foggy froxels. Diagnostic / quality knob for residual fog shimmer.")
FDS_FLAG_FLOAT(fast_fog_froxel_blend,   "FDS_FAST_FOG_FROXEL_BLEND",    0.9f,                          "atmos",    "Temporal history weight (0..0.95): new froxel value = lerp(current, history, blend). The jitter cycle's residual flicker scales with (1-blend), so HIGHER = LESS shimmer (camera motion is handled by reprojection, not by this); the cost of high values is fog/glow response lag (~1/(1-blend) frames). Lower = more responsive but more shimmer; 0 disables blending (jitter then shows as raw per-frame noise).")
FDS_FLAG_BOOL(fast_fog_xpar,            "FDS_FAST_FOG_XPAR",            1,                             "atmos",    "Fog the transparent peel from the froxel grid: each transparent pixel's lit color becomes lit*T(z) + inscatter(z) at ITS OWN depth before the alpha blend (out = a*(C*T+acc) + (1-a)*Bg — exact under the froxel model, one trilinear grid sample per transparent pixel). Off = transparents keep the legacy per-light sqrt ramp (no aerial perspective on water/glass).")
FDS_FLAG_INT(fast_fog_glow_grid_div,    "FDS_FAST_FOG_GLOW_GRID_DIV",   4,                             "atmos",    "Froxel glow (light in-scatter radiance) is evaluated on an XY grid this many times coarser than the fog grid (full z resolution) and bilinearly upsampled - light radiance is low-frequency in XY, and this divides the per-light glow cost (the #1 froxel cost in many-light scenes: 30-omni city glow ~26ms -> ~1.6ms at div=4) by div^2. 1 = exact per-column glow (the A/B reference). Softens shadow boundaries INSIDE fog glow by ~div fine froxels; surface shadows unaffected.")
FDS_FLAG_FLOAT(fast_fog_glow_max,       "FDS_FAST_FOG_GLOW_MAX",        0.0f,                          "atmos",    "Soft-knee compressor for the froxel fog's per-slice in-scatter radiance (8-bit output units): EXACTLY linear below half this value, then compressed, asymptotically approaching it — tames the white-clipping cores near lamps (radial kernel peaks ~20x, times fast_fog_inscatter) WITHOUT dimming the glow's dim reaches or touching density/extinction. Hue-preserving (max-channel scaled). 0 = off. Try ~250-400; lower = flatter glow, higher = only the hottest cores compressed. Reduce fast_fog_inscatter instead if you want the WHOLE glow dimmer.")
FDS_FLAG_BOOL(fast_fog_halfres,         "FDS_FAST_FOG_HALFRES",         1,                              "atmos",    "Compute fast_fog at half resolution and bilaterally (depth-weighted) upsample. Fog is low-frequency so the quality cost is tiny; ~4x cheaper, makes the blob field affordable. --no-fast_fog_halfres for full-res.")
FDS_FLAG_BOOL(fast_fog_adaptive,        "FDS_FAST_FOG_ADAPTIVE",        0,                              "atmos",    "Hierarchical fast_fog: compute on a coarse grid (fast_fog_adaptive_step), interpolate where neighbouring coarse samples agree, recompute per-pixel only where they disagree (occluder/shadow/depth edges). Cheaper than half-res in smooth regions, full-res-sharp at edges. Overrides fast_fog_halfres when set.")
FDS_FLAG_INT(fast_fog_adaptive_step,    "FDS_FAST_FOG_ADAPTIVE_STEP",   4,                              "atmos",    "Coarse-grid spacing (pixels) for fast_fog_adaptive. 4 = compute 1/16 of pixels then refine. Larger = cheaper base but more refinement at edges.")
FDS_FLAG_FLOAT(fast_fog_adaptive_thresh,"FDS_FAST_FOG_ADAPTIVE_THRESH", 0.06f,                          "atmos",    "Adaptive refine trigger: if the 2x2 coarse fog-amount spread exceeds this (or depth disagrees), recompute the pixel exactly instead of interpolating. Lower = more recompute (sharper, slower).")
FDS_FLAG_FLOAT(fast_fog_inscatter,      "FDS_FAST_FOG_INSCATTER",       0.0f,                           "atmos",    "In-scatter glow: brightness scale for scene lights (omnis/spots) lighting the fog medium, so fog blooms around lamps. Integrated along the fog segment (fast_fog_inscatter_samples points), scaled by fog amount. 0 = off (fog only occludes toward Ambient). Try 0.3-1.0.")
FDS_FLAG_BOOL(fast_fog_inscatter_analytic,"FDS_FAST_FOG_INSCATTER_ANALYTIC",1,                          "atmos",    "Integrate the in-scatter glow in closed form (arctan integral of the 1/dist^2 radial kernel over the fog segment, cone/edge factors at the segment's closest-approach point) instead of point sampling. Matches vol_cone_analytic/vol_halo_analytic. Shadow-casting spots can't be integrated (per-sample shadow tap) so they fall back to fast_fog_inscatter_samples point sampling. Default on; --no-fast_fog_inscatter_analytic forces sampling for all lights.")
FDS_FLAG_INT(fast_fog_inscatter_samples,"FDS_FAST_FOG_INSCATTER_SAMPLES",6,                             "atmos",    "Stratified samples used to integrate in-scatter for lights the analytic path can't handle (shadow-casting spots), or for all lights when --no-fast_fog_inscatter_analytic. 1 = the old single-midpoint sample, which resonates with the lamp's 1/dist^2 near-field and prints a bright disc/shell. >=4 converges to the smooth finite integral. 6 is a good quality/cost balance.")
FDS_FLAG_BOOL(fast_fog_inscatter_jitter,"FDS_FAST_FOG_INSCATTER_JITTER", 0,                             "atmos",    "Per-pixel interleaved-gradient-noise sample-offset for the sampled in-scatter integral. Default OFF: with the analytic path on, the shadowed integral is importance-sampled by the radial CDF so its summand (cutoff*cone * PCF-visibility) is smooth — centered samples are already terrace-free and pattern-free, so jitter only ADDS a visible weave. Turn ON only for the brute-force path (--no-fast_fog_inscatter_analytic), where uniform samples of the 1/dist^2 spike + binary shadow DO terrace without it.")
FDS_FLAG_BOOL(fast_fog_shadow_analytic, "FDS_FAST_FOG_SHADOW_ANALYTIC", 0,                             "atmos",    "Analytic shadowed in-scatter: bisect the shadow map for lit/shadowed transitions, sum the analytic radial integral over lit sub-intervals (cutoff^2*cone pinned per interval at clamp(z*,a,b)). Exact for fully-lit/convex; an approximation in bright partially-shadowed regions, and no faster here (path is compute-bound, not shadow-tap-bound). Experimental A/B; default off.")
FDS_FLAG_BOOL(fast_fog_shadow_earlyout, "FDS_FAST_FOG_SHADOW_EARLYOUT", 1,                             "atmos",    "Fully-lit early-out for the shadowed in-scatter: probe PCF visibility at z* and 5 points across the segment; if all read fully lit, skip the per-sample integral and use the analytic brightness. Wins in LIT-heavy views (most of the cone unoccluded); a wash in shadow-heavy views (the probes just add cost to penumbra pixels that still loop), and can slightly over-brighten a thin shadow that falls between probes (~3 levels). Default on; --no-fast_fog_shadow_earlyout for the exact per-pixel integral everywhere.")
FDS_FLAG_INT(fast_fog_shadow_pcf,       "FDS_FAST_FOG_SHADOW_PCF",      1,                              "atmos",    "PCF radius (shadow-map texels) for the sampled in-scatter shadow tap. 0 = single binary tap (hard edge -> the lit-sample count steps by 1 across neighbours, printing ns horizontal terraces unless ns is huge). 1 = 3x3 box -> fractional visibility -> soft penumbra that reads smooth at low fast_fog_inscatter_samples. 2 = 5x5 (softer/slower). Cost is (2r+1)^2 depth taps per in-scatter sample, so only the shadowed-spot path pays it.")
FDS_FLAG_FLOAT(fast_fog_dither,         "FDS_FAST_FOG_DITHER",          1.0f,                           "atmos",    "Triangular dither amplitude (in 8-bit levels) added to the fog composite to break up the contour banding that 8-bit output quantization gives on smooth low-contrast fog gradients. 0 = off. 1.0 = ~+-1 level, enough to dissolve bands. The banding is NOT from fastPow2 (verified: std::exp bands identically).")

// ─── Cinematic preset ─────────────────────────────────────────────────────
FDS_FLAG_BOOL (cinematic,               "FDS_CINEMATIC",                0,                              "atmos",    "Cinematic preset: each scene turns on HDR + hdr_linear + sane bloom + the filmic post stack (anamorphic, chromatic aberration, vignette, colour grade, film grain) at a PER-SCENE exposure tuned so nothing blows out (bright water scenes get low exposure, dark scenes high). Applied via setDefault in each scene's factory, so any individual --flag you pass still overrides it. Does NOT enable deferred_quarter (greets keeps that to itself). Greets keeps its own hotter HDR/bloom and just gains the post stack.")

// ─── HDR (prototype, docs/fountain_hdr_plan.md) ───────────────────────────
FDS_FLAG_BOOL (hdr,                     "FDS_HDR",                      0,                              "atmos",    "HDR prototype: deferred passes accumulate unclamped radiance into an f32 buffer, then a tonemap pass maps it to the 8-bit framebuffer instead of clamping per-pass (replaces the glowMax soft-knee). Lets additive glow/fog/flash roll off instead of clipping to white. Fountain-first; no-op until the deferred writes are wired (Phase 1).")
FDS_FLAG_FLOAT(hdr_exposure,            "FDS_HDR_EXPOSURE",             1.0f,                           "atmos",    "HDR exposure multiplier applied before the tonemap. 1.0 = neutral; raise to brighten, lower to darken before the highlight roll-off.")
FDS_FLAG_FLOAT(hdr_white,               "FDS_HDR_WHITE",                1.0f,                           "atmos",    "HDR post-tonemap chroma scale: 1.0 = neutral (ACES filmic's own highlight desaturation only); <1 pulls colors toward the tonemapped luminance (less saturated, e.g. 0.8 to tame neon glow); >1 boosts saturation. Applied after the ACES curve.")
FDS_FLAG_FLOAT(hdr_glow_scale,          "FDS_HDR_GLOW_SCALE",           0.25f,                          "atmos",    "HDR auto-compensation: glow inputs tuned against glowMax's cap (fast_fog_inscatter, bolt_flash_peak, cone_strength) run hot once --hdr disables that cap, so in HDR mode they're scaled by this factor. Lets the glowMax-tuned flags Just Work under --hdr instead of hand-dividing each. ~0.25 (=÷4) start; lower if fog/glow still too hot. 1.0 = no compensation.")
FDS_FLAG_BOOL(hdr_glow_softknee,        "FDS_HDR_GLOW_SOFTKNEE",        0,                              "atmos",    "HDR fog in-scatter: the physically-grounded alternative to the flat hdr_glow_scale fudge. Instead of disabling the soft-knee under --hdr and scaling inscatter by a constant (which over-dims faint glow and under-tames hot cores — a scalar can't match the knee's gain curve g=(2x-1)/x²), run the SAME soft-knee in HDR-linear with fast_fog_glow_max as the radiance ceiling: faint glow preserved (gain~1), hot cores rolled off (gain→0), auto-tracking the actual glow level; ACES tonemaps on top. Tune fast_fog_glow_max (the physical ceiling; falls back to 300 if unset) rather than re-tuning a ratio. Affects ONLY the froxel/screen fog in-scatter, NOT volumetric cones (no soft-knee there — they keep hdr_glow_scale). Default off for A/B vs hdr_glow_scale.")
FDS_FLAG_BOOL(hdr_cone_softknee,        "FDS_HDR_CONE_SOFTKNEE",        0,                              "atmos",    "HDR volumetric cone/halo glow: the physically-grounded alternative to scaling cone_strength by hdr_glow_scale. Applies a soft-knee (linear below cone_glow_max/2, asymptote at cone_glow_max, same gain curve g=(2x-1)/x² as the fog knee) to the cone+omni-halo in-scatter at its composite into the linear HDR buffer, so hot shaft cores roll off smoothly toward the ceiling (faint shafts preserved) before ACES, instead of a flat hdr_glow_scale that over-dims faint shafts and under-tames cores. When on, the cone term skips the hdr_glow_scale fudge. Tune cone_glow_max (falls back to 200 if unset). HDR-only; affects cones AND omni halos (they share VolCompositeAdd). Sibling of --hdr-glow-softknee (fog in-scatter). Default off for A/B.")
FDS_FLAG_FLOAT(cone_glow_max,           "FDS_CONE_GLOW_MAX",            0.0f,                           "atmos",    "Radiance ceiling for --hdr-cone-softknee's soft-knee on the volumetric cone+halo glow, in the same linear-radiance units as the rest of the HDR buffer (cones composite UNCLAMPED into g_hdrBuf and ACES rolls off above this). Try ~150-400; lower = more roll-off. 0 = use the 200 fallback when --hdr-cone-softknee is on.")
FDS_FLAG_BOOL (hdr_linear,              "FDS_HDR_LINEAR",               0,                              "atmos",    "HDR Phase 3 Stage A (look experiment): tonemap in LINEAR space. Decodes the accumulated buffer gamma->linear (cheap gamma-2.0: square), applies exposure+ACES in linear, then encodes linear->sRGB (sqrt) on output. Does NOT make the surface lighting itself linear (that's Stage B) -- this just lets you A/B whether linear tonemapping looks better before committing to the hot-kernel rewrite. Off = the original gamma-space ACES. Toggle live via the tune server.")
FDS_FLAG_BOOL (bloom,                   "FDS_BLOOM",                    0,                              "atmos",    "Full-screen HDR bloom: bright-pass the linear radiance buffer (g_hdrBuf, the true unclamped source), blur a downsampled pyramid, and add the glow back BEFORE the tonemap so it rolls off through ACES with everything else. Requires --hdr (no float buffer otherwise). Subsumes the localized disco-ball bloom. Threaded (6x4 tiles). Off = no spatial glow (HDR still rolls highlights off, just doesn't bleed).")
FDS_FLAG_FLOAT(bloom_threshold,         "FDS_BLOOM_THRESHOLD",          200.0f,                         "atmos",    "Bloom bright-pass knee, in the linear-radiance 0-255 scale (255 = reference white; lit surfaces sit near there, lights/flash/disco exceed it). Only radiance above this blooms. Lower = more of the scene glows; raise to restrict bloom to the brightest highlights.")
FDS_FLAG_FLOAT(bloom_intensity,         "FDS_BLOOM_INTENSITY",          0.6f,                           "atmos",    "Bloom add-back strength: the blurred bright-pass is scaled by this before adding into g_hdrBuf. 0 = off (same as --no-bloom), ~0.5-1.0 a natural glow, higher for a dreamy/overblown look.")
FDS_FLAG_FLOAT(hdr_refl_gain,           "FDS_HDR_REFL_GAIN",            2.5f,                           "atmos",    "HDR brightness gain for forward Mat_HdrEmissive surfaces (the disco ball): when their colour is lifted from the 8-bit forward buffer into g_hdrBuf, it's scaled by this so the reflection exceeds 255 and over-blooms (8-bit forward can't otherwise be a true HDR source). 1.0 = no boost (just HDR-correct). Only affects flagged surfaces, so other reflective env is untouched.")
FDS_FLAG_BOOL (anamorphic,              "FDS_ANAMORPHIC",               0,                              "atmos",    "Anamorphic lens streaks (Star Trek 2009 look): bright-pass the linear g_hdrBuf, build a long HORIZONTAL light streak (+ a faint VERTICAL cross) off every hot source via exponential doubling-blur, tint it cool blue-white, and add it back BEFORE the tonemap so it rolls off through ACES. Requires --hdr. Independent of --bloom (does its own bright-pass at bloom_threshold). Threaded.")
FDS_FLAG_FLOAT(anamorphic_intensity,    "FDS_ANAMORPHIC_INTENSITY",     0.5f,                           "atmos",    "Anamorphic streak add-back strength (scales the streak before adding into g_hdrBuf). 0 = off.")
FDS_FLAG_INT  (anamorphic_passes,       "FDS_ANAMORPHIC_PASSES",        6,                              "atmos",    "Horizontal streak length in exponential doubling passes — reach ~2^passes quarter-res px (6 ~ a 256px streak at 1080p). Each pass is 3 taps; cost is log(length).")
FDS_FLAG_FLOAT(anamorphic_decay,        "FDS_ANAMORPHIC_DECAY",         0.85f,                          "atmos",    "Per-pass streak falloff weight (higher = longer, brighter tail). ~0.8-0.9.")
FDS_FLAG_FLOAT(anamorphic_vert,         "FDS_ANAMORPHIC_VERT",          0.25f,                          "atmos",    "Faint vertical cross-streak intensity as a fraction of the horizontal (0 = pure horizontal anamorphic; 0.25 = a subtle JJ lens-array cross). The vertical streak uses 2 fewer doubling passes so it stays shorter than the horizontal.")
FDS_FLAG_BOOL (lens_ghosts,             "FDS_LENS_GHOSTS",              0,                              "atmos",    "Screen-space lens-flare ghosts: a chain of colored discs + a halo ring marching along the line from each bright source through screen-centre, sampled from the linear g_hdrBuf bright-pass and added BEFORE the tonemap. Completes the anamorphic flare. Requires --hdr. Threaded.")
FDS_FLAG_FLOAT(lens_ghost_intensity,    "FDS_LENS_GHOST_INTENSITY",     0.4f,                           "atmos",    "Lens-ghost add-back strength. 0 = off.")
FDS_FLAG_INT  (lens_ghost_count,        "FDS_LENS_GHOST_COUNT",         4,                              "atmos",    "Number of ghost discs along the centre axis.")
FDS_FLAG_FLOAT(lens_ghost_dispersal,    "FDS_LENS_GHOST_DISPERSAL",     0.32f,                          "atmos",    "Ghost spacing as a fraction of the screen toward/through centre (bigger = ghosts spread farther apart).")
FDS_FLAG_FLOAT(lens_ghost_halo,         "FDS_LENS_GHOST_HALO",          0.4f,                           "atmos",    "Halo-ring intensity (the soft circle the ghosts sit on), as a fraction of ghost_intensity. 0 = no halo.")
FDS_FLAG_BOOL (chromatic,               "FDS_CHROMATIC",                0,                              "atmos",    "Chromatic aberration: radial per-channel split (R outward, B inward) that grows toward the frame edge — the lens-glass tell. Post-tonemap on the 8-bit image. Cheap.")
FDS_FLAG_FLOAT(chromatic_amount,        "FDS_CHROMATIC_AMOUNT",         2.5f,                           "atmos",    "Max channel split in pixels at the frame corner (0 at centre). ~1-4 subtle to strong.")
FDS_FLAG_BOOL (vignette,                "FDS_VIGNETTE",                 0,                              "atmos",    "Vignette: darken the frame toward the corners (cinematic focus). Post-tonemap on the 8-bit image.")
FDS_FLAG_FLOAT(vignette_strength,       "FDS_VIGNETTE_STRENGTH",        0.4f,                           "atmos",    "Vignette darkening at the corner (0 = none, 1 = black corners). ~0.3-0.5 natural.")
FDS_FLAG_BOOL (dof,                     "FDS_DOF",                      0,                              "atmos",    "Depth-of-field: circle-of-confusion bokeh blur off the G-buffer depth, applied to the linear g_hdrBuf BEFORE bloom so defocused highlights bloom into discs. Gather blur with a golden-angle disc kernel + scatter-as-gather weighting (no foreground bleed). Requires --hdr. Threaded.")
FDS_FLAG_FLOAT(dof_focus,               "FDS_DOF_FOCUS",                0.0f,                           "atmos",    "Focus-plane distance in view-space z units. 0 (default) = auto-focus on the screen-centre depth each frame.")
FDS_FLAG_FLOAT(dof_range,               "FDS_DOF_RANGE",                0.06f,                          "atmos",    "Depth over which sharpness falls to full blur, as a FRACTION of the scene far-plane (so one value auto-scales across scenes: a small room and an outdoor vista both work). Smaller = shallower depth of field. ~0.03 shallow, ~0.1 gentle.")
FDS_FLAG_FLOAT(dof_max,                 "FDS_DOF_MAX",                  10.0f,                          "atmos",    "Maximum blur radius at full circle-of-confusion, in pixels at a 540p reference height (auto-scaled to the actual resolution so the blur looks the same at 540p and 1080p). 0 = off.")
FDS_FLAG_INT  (dof_downscale,           "FDS_DOF_DOWNSCALE",            2,                              "atmos",    "DoF compute resolution divisor (same idea as --ssao_downscale): 1 = full-res gather (original path); 2 = half-res gather + depth-aware bilinear upsample, blended toward the sharp original as CoC shrinks so the focus boundary stays clean. ~4x less gather work; defocused regions are blurry by definition so the res cut is invisible except at the in-focus transition band, which the CoC blend covers. Default 2.")
FDS_FLAG_BOOL (grade,                   "FDS_GRADE",                    0,                              "atmos",    "Colour grade on the final 8-bit image: temperature, contrast, saturation, and a teal-orange split-tone (shadows → teal, highlights → orange — the blockbuster look). Post-tonemap, cheap, works with or without bloom/HDR effects in frame.")
FDS_FLAG_FLOAT(grade_teal_orange,       "FDS_GRADE_TEAL_ORANGE",        0.3f,                           "atmos",    "Teal-orange split-tone strength. 0 = neutral, ~0.3 tasteful, ~0.6 strong cinematic.")
FDS_FLAG_FLOAT(grade_contrast,          "FDS_GRADE_CONTRAST",           1.05f,                          "atmos",    "Contrast around mid-grey. 1 = none, >1 punchier, <1 flatter.")
FDS_FLAG_FLOAT(grade_saturation,        "FDS_GRADE_SATURATION",         1.1f,                           "atmos",    "Saturation. 1 = none, >1 richer, 0 = greyscale.")
FDS_FLAG_FLOAT(grade_temp,              "FDS_GRADE_TEMP",               0.0f,                           "atmos",    "Colour temperature shift. 0 = neutral, + = warmer (more red/less blue), - = cooler. ~±0.3 subtle.")
FDS_FLAG_BOOL (grain,                   "FDS_GRAIN",                    0,                              "atmos",    "Animated film grain: per-pixel luminance noise hashed on x,y,frame and added to the final image. Post-tonemap, cheap.")
FDS_FLAG_FLOAT(grain_strength,          "FDS_GRAIN_STRENGTH",           6.0f,                           "atmos",    "Film-grain amplitude in 8-bit levels (peak ± offset). ~4-10 subtle to coarse.")

// ─── scene-specific ──────────────────────────────────────────────────────
FDS_FLAG_BOOL(skip_cubemap,             "FDS_SKIP_CUBEMAP",             0,                              "city",     "City: skip per-building env-map bake")
FDS_FLAG_BOOL(city_envmap_cache,        "FDS_CITY_ENVMAP_CACHE",        1,                              "city",     "Cache per-building env-map panoramas to Runtime/cache/city_envmap.bin keyed by CITY.FLD + panorama dims. Default on — slashes city bench/PGO init from ~4.8s to ~0.4s. --no-city-envmap-cache forces a fresh bake (and rewrites the cache).")
FDS_FLAG_BOOL(water_ripple,             "FDS_WATER_RIPPLE",             1,                              "city",     "City: animate the water-reflection displacement map with cross-axis travelling ripples (was a frozen static sin/cos warp). The mirrored world below the water surface now moves. --no-water_ripple restores the legacy static warp. Per-frame dispMap rebuild is row-parallel across the pool.")
FDS_FLAG_FLOAT(water_ripple_amp,        "FDS_WATER_RIPPLE_AMP",         30.0f,                          "city",     "Water-ripple displacement amplitude in pixels (peak screen-space offset of the reflection). Higher = choppier; at low HDR exposure the reflection is dark so it needs more amplitude to read. Legacy static warp was ~15.")
FDS_FLAG_FLOAT(water_ripple_speed,      "FDS_WATER_RIPPLE_SPEED",       1.0f,                           "city",     "Water-ripple animation speed. 0 = frozen (but cross-axis organic, unlike the legacy warp).")
FDS_FLAG_FLOAT(water_ripple_scale,      "FDS_WATER_RIPPLE_SCALE",       1.0f,                           "city",     "Water-ripple spatial frequency scale. Larger = tighter, choppier ripples; smaller = broad swells.")
FDS_FLAG_FLOAT(water_scroll_speed,      "FDS_WATER_SCROLL_SPEED",       1.0f,                           "city",     "Water SURFACE-texture scroll speed (the tiled albedo sliding, distinct from the reflection ripple). 1.0 = original rate; scale up for a faster flow, 0 = frozen.")
FDS_FLAG_BOOL (water_bump,              "FDS_WATER_BUMP",               1,                              "city",     "Bump-mapped specular GLINTS on the water surface (distinct from the reflection ripple): an animated WORLD-space ripple normal catches a key light → view-dependent sparkles across the water. Masked on the transparent G-buffer (front == water matID) with opaque-Z occlusion, so it covers all visible water and never paints over foreground geometry. --no-water_bump disables.")
FDS_FLAG_FLOAT(water_bump_strength,     "FDS_WATER_BUMP_STRENGTH",      0.6f,                           "city",     "Water-bump glint brightness (peak add in 0-1 → ×255). 0 = off. ~0.3 subtle shimmer, ~0.8 strong sparkle.")
FDS_FLAG_FLOAT(water_bump_shininess,    "FDS_WATER_BUMP_SHININESS",     14.0f,                          "city",     "Water-bump glint tightness. Higher = smaller, sharper sparkles; lower = broad sheen.")
FDS_FLAG_FLOAT(water_bump_scale,        "FDS_WATER_BUMP_SCALE",         6.0f,                           "city",     "Water-bump normal spatial frequency (independent of the coarse reflection ripple). Higher = finer, denser sparkles; lower = broad coherent sheen.")
FDS_FLAG_BOOL (water_detile,            "FDS_WATER_DETILE",             1,                              "city",     "De-tile the water ALBEDO: warp the water grid's face UVs by a low-frequency function of position at init, so the tiled texture stretches/swirls across the surface instead of repeating as a regular grid. --no-water_detile restores the plain tiling.")
FDS_FLAG_FLOAT(water_detile_amp,        "FDS_WATER_DETILE_AMP",         0.6f,                           "city",     "Water de-tile warp amplitude in UV units (fraction of a texture tile the mapping is displaced; varies across the surface). Bigger = more distortion, but too big smears the texture.")
FDS_FLAG_FLOAT(water_detile_scale,      "FDS_WATER_DETILE_SCALE",       3.5f,                           "city",     "Water de-tile warp spatial frequency. Higher = more, smaller warp cells (breaks local tile repetition); lower = broad swells.")
FDS_FLAG_BOOL (water_procedural,        "FDS_WATER_PROCEDURAL",         0,                              "city",     "Procedural water composite (Stage B): replace the tiled albedo with a deep-water colour mixed with the reflection by a view-angle FRESNEL term (more reflection at grazing, deep colour looking straight down). Coherent with the shared wave field. Off = legacy albedo+reflection blend.")
FDS_FLAG_FLOAT(water_deep_b,            "FDS_WATER_DEEP_B",             58.0f,                          "city",     "Procedural deep-water colour Blue (0-255), seen looking straight down.")
FDS_FLAG_FLOAT(water_deep_g,            "FDS_WATER_DEEP_G",             44.0f,                          "city",     "Procedural deep-water colour Green (0-255).")
FDS_FLAG_FLOAT(water_deep_r,            "FDS_WATER_DEEP_R",             26.0f,                          "city",     "Procedural deep-water colour Red (0-255).")
FDS_FLAG_FLOAT(water_reflectivity,      "FDS_WATER_REFLECTIVITY",       0.9f,                           "city",     "Procedural water max reflection at grazing angle (fresnel peak). 1 = full mirror at the horizon, 0 = no reflection.")
FDS_FLAG_FLOAT(water_fresnel_base,      "FDS_WATER_FRESNEL_BASE",       0.65f,                          "city",     "Procedural water reflection floor looking STRAIGHT DOWN (fresnel base). For this mirror water the reflection underlay IS the see-through, so this is effectively the base transparency: higher = more reflection/transparency at all angles, lower = more opaque deep colour. ~0.65 gives the reflection clear weight; 1 = full mirror everywhere.")
FDS_FLAG_BOOL (water_fresnel_composite, "FDS_WATER_FRESNEL_COMPOSITE",  1,                              "city",     "Procedural water kernel composite: replace the lit water texel with deep-colour x (1-fresnel) + reflection x fresnel (the city look — assumes a BRIGHT reflection underlay). Off = keep the forward-style lit-texel + reflection/2 blend and take only the procedural field (ripple/glints/caustics) on top; chase turns this off because its night-sky reflection underlay is black and the deep colour reads as a dark view-angle band.")
FDS_FLAG_FLOAT(water_albedo_mix,        "FDS_WATER_ALBEDO_MIX",         0.45f,                          "city",     "Procedural water: strength of the generated CAUSTIC texture (bright cell-network lines), modulating the water brightness, sampled per-pixel at a UV WARPED BY THE WAVE FIELD so it ripples with the same waves as the glints/reflection (coherent). 0 = none, ~0.45 visible caustics, higher = stronger.")
FDS_FLAG_FLOAT(water_tex_scale,         "FDS_WATER_TEX_SCALE",          0.06f,                          "city",     "Procedural water caustic tiling: world-units→texel frequency. Higher = smaller/denser caustic cells; lower = larger cells.")
FDS_FLAG_FLOAT(water_tex_warp,          "FDS_WATER_TEX_WARP",           5.0f,                           "city",     "How hard the wave field distorts the water texture's sampling (in texels). Makes the texture ripple/flow WITH the waves & glints; 0 = flat (just tiled), too high = over-churned/funhouse.")
FDS_FLAG_FLOAT(water_tex_flow,          "FDS_WATER_TEX_FLOW",           1.0f,                           "city",     "How fast the caustic texture TRANSLATES with the wave field. 1 = matches the glint scroll velocity (caustics ride the waves), 0 = anchored (warp ripples it in place only), >1 = faster than the glints.")
FDS_FLAG_BOOL (water_variation,         "FDS_WATER_VARIATION",          0,                              "city",     "Break the procedural water's REGULARITY (default OFF → city/existing byte-identical). ON layers extra structure on the wave field + caustics so the sea reads as a varied natural surface instead of a uniform repeating field: (1) waterWaveSlope adds a low-frequency world-space SWELL (two crossed long swells + a slow macro roll) so there is large-scale structure the 128-texel tile can't hold, plus a third rotated ripple octave to break the tile's periodicity; (2) the caustic-cell sampling sums THREE scales/rotations (base + a finer rotated octave + a coarse macro octave) so the Worley network stops visibly tiling at water_tex_scale. Chase's factory turns this ON (createChaseScene); city/fountain leave it off. Read once into a static at BuildField, so it's a per-scene bake choice — flip needs a scene re-init.")
#if FDS_DEV
FDS_FLAG_BOOL(debug_panorama,           "FDS_DEBUG_PANORAMA",           0,                              "city-dev", "[dev] City: synthesize debug panoramas with gridlines")
FDS_FLAG_BOOL(dump_panorama,            "FDS_DUMP_PANORAMA",            0,                              "city-dev", "[dev] City: dump baked panoramas to PPM")
#endif
FDS_FLAG_BOOL(greets_mat_labels,        "FDS_GREETS_MAT_LABELS",        0,                              "greets",   "Greets: overlay one '<matID>:<name>' label per material at the centroid of its closest-to-camera on-screen face. Diagnostic for picking mirror/effect target materials by name.")
FDS_FLAG_BOOL(greets_stone_tex,         "FDS_GREETS_STONE_TEX",         1,                              "greets",   "Greets: swap the wall ('rooms') + floor ('floor') diffuse to the de-lit 1024 Egyptian sandstone textures (TEXTURES/greets_wall.jpg, greets_floor.jpg). For the normal map, prefers a dedicated AUTHORED tangent-space map (TEXTURES/greets_*_n.png) if present; otherwise Sobel-bakes one from a height map (greets_*_h.png). Off by default for A/B.")
FDS_FLAG_BOOL(greets_nmap_flip_g,       "FDS_GREETS_NMAP_FLIP_G",       0,                              "greets",   "Greets stone-tex: flip the green channel of an AUTHORED normal map (greets_*_n.png) on load. Authored maps come in two conventions — OpenGL (+Y up) and DirectX (+Y down); the engine's tangent-space decode expects one of them. If lit bumps look inverted (mortar grooves bulge out / bricks cave in), toggle this. No effect on the Sobel-baked-from-height path.")
FDS_FLAG_BOOL(greets_tbn_fix,           "FDS_GREETS_TBN_FIX",           1,                              "greets",   "Greets: fix the normal-map relief seam at boundaries between faces of opposite UV handedness (mirrored mapping). The deferred kernel reconstructs the bitangent as a fixed-sign N×T, which is wrong on negative-UV-determinant faces; this splits those faces onto a handedness=-1 material clone so the kernel flips B per pixel (B = TbnHandedness·(N×T)). Default on; the 'rooms' wall has ~92 mirrored faces out of ~196. Off = the legacy seam.")
FDS_FLAG_FLOAT(greets_floor_uv_scale,   "FDS_GREETS_FLOOR_UV_SCALE",    1.5f,                           "greets",   "Greets stone-tex: scale the floor's planar UVs so tiles are this much BIGGER (fewer repetitions). 1.0 = authored size; 1.5 = tiles 1.5x larger. Applied to the floor face UVs after load (the planar projection is baked at FLD load, so this rescales it in code).")
FDS_FLAG_FLOAT(greets_floor_detile,     "FDS_GREETS_FLOOR_DETILE",      0.06f,                          "greets",   "Greets stone-tex: low-frequency world-space UV warp on the floor to break the obvious tile grid (same de-tile trick as city water). Amplitude in UV units; 0 = off. Per shared world position so adjacent faces stay seamless.")
FDS_FLAG_BOOL(greets_mirror,            "FDS_GREETS_MIRROR",            0,                              "greets",   "Greets: build a one-shot world-mirrored clone of every mesh across the teleporter wall plane and hide the wall faces, so the teleporter rectangle reveals a Z-buffer-portal view of the mirrored room. Static-only — dynamic meshes (robot) reflect frozen at init.")
FDS_FLAG_BOOL(greets_mirror_debug_mask, "FDS_GREETS_MIRROR_DEBUG_MASK", 0,                              "greets",   "Greets: after Render(), overlay gb.mirrorId * 64 onto the framebuffer (red/green/blue channels rotated by mirror id) so you can see which pixels each mirror's wall pre-pass actually stamped. Diagnostic for tuning the per-pixel mask path.")
FDS_FLAG_BOOL(greets_mirror_cam,        "FDS_GREETS_MIRROR_CAM",        0,                              "greets",   "Greets: after building mirrors, override the camera to a fixed free-cam pose squarely in front of the teleporter mirror (computed from its wall centroid + plane normal). Lets a snapshot capture the teleporter reflection directly without hunting for a scripted-camera timestamp that happens to face it.")
FDS_FLAG_BOOL(mirrortest_skip_mirror,   "FDS_MIRRORTEST_SKIP_MIRROR",   0,                              "mirror",   "mirrortest snapshot: build the bare floor+wall+mirror+test-object scene WITHOUT invoking BuildMirror or the mask pre-pass. Use to bisect whether the Render() hang is in the mirror layer or in the base scene render path. Run: ./DEMO --deferred --snapshot=mirrortest --mirrortest-skip-mirror")
FDS_FLAG_FLOAT(greets_spot_height,      "FDS_GREETS_SPOT_HEIGHT",       0.0f,                           "greets",   "Greets: override robot spotlight height (0 = scene default)")
FDS_FLAG_BOOL(greets_blasters,          "FDS_GREETS_BLASTERS",          0,                              "greets",   "Greets: test the blaster-bolt system — periodically fire bright additive energy bolts across the room (Star-Wars style, bloom into the HDR buffer). Off by default; dev harness for the BlasterBolts module destined for the chase scene.")
FDS_FLAG_BOOL (blaster_light,           "FDS_BLASTER_LIGHT",            1,                              "blaster",  "Blaster bolts EMIT light into the scene: each live bolt drives a transient, non-stationary, coloured Omni at its position (deferred surface lighting → moving light pools on nearby geometry, and fog in-scatter for free where fog is on). Scene-agnostic; works with or without fog. --no-blaster_light = the old draw-only billboard (no scene illumination). Capped at a fixed pool of simultaneous bolt-lights (excess live bolts glow but don't light).")
FDS_FLAG_FLOAT(blaster_light_intensity, "FDS_BLASTER_LIGHT_INTENSITY",  160.0f,                         "blaster",  "Blaster bolt-light peak intensity (Omni ISize; radiance ≈ boltColour × this × linear-falloff). Scene-scale dependent — ~100-300 at the greets/chase scale. 0 = no emission (≈ --no-blaster_light).")
FDS_FLAG_FLOAT(blaster_light_range,     "FDS_BLASTER_LIGHT_RANGE",      14.0f,                          "blaster",  "Blaster bolt-light range in VIEW-SPACE (world) units — how far the moving pool reaches. Scene-scale dependent (these scenes live in view-Z ~[5..80]); ~10-20 reads as a tight travelling glow, larger washes the room.")
FDS_FLAG_BOOL(no_greets_spots,          "FDS_NO_GREETS_SPOTS",          0,                              "greets",   "Greets: skip the code-installed robot spotlights (g_RobotSpot + orbit lights). FLD omnis still load.")
FDS_FLAG_BOOL(greets_omni_shadows,      "FDS_GREETS_OMNI_SHADOWS",      0,                              "greets",   "Greets: mark every FLD-loaded Light_Omni as Omni_CastsShadow|StaticShadow so CubeShadowMaps_Rebuild bakes 6-face shadow cubes for them. Disabled by default — N omnis × 6 faces × shadowMapRes² adds up quickly.")
FDS_FLAG_INT(greets_omni_shadow_res,    "FDS_GREETS_OMNI_SHADOW_RES",   256,                            "greets",   "Greets: per-face cube shadow-map resolution for omnis flagged by --greets-omni-shadows. Should be a power of two (128/256/512/1024). Total memory per omni = 6 × res² × 4 bytes.")
FDS_FLAG_INT(greets_moving_omni_shadow_res, "FDS_GREETS_MOVING_OMNI_SHADOW_RES", 0,                       "greets",   "Greets: separate per-face cube shadow-map resolution for omnis flagged as MOVING (Omni_CastsShadow without Omni_StaticShadow — typically mech-attached). 0 = use --greets-omni-shadow-res. Moving omnis pay full per-frame cube re-bake (no static cache, no lightmap), so dropping their res is the cheapest way to reclaim shadow time when they sit close to the camera.")
FDS_FLAG_INT(greets_piramid_chunk_grid, "FDS_GREETS_PIRAMID_CHUNK_GRID", 8,                              "greets",   "Greets: spatial-grid resolution per axis for Piramid.lwo chunking. Greets's wall mesh is one giant TriMesh (bsphere r≈60) that the cube-face cull can't reject; splitting it at scene init into N³ smaller TriMeshes (most cells empty → ~50-150 chunks in practice) lets mesh-level culling actually fire. 0 = disable chunking. Overridden by --greets_chunk_size when that is > 0.")
FDS_FLAG_FLOAT(greets_chunk_size,       "FDS_GREETS_CHUNK_SIZE",        0.0f,                           "greets",   "Greets: SIZE-based Piramid chunk granularity (Phase A of the chunk-occlusion experiment, docs/VISIBILITY_PLAN.md §7). When > 0, the wall mesh is partitioned into near-CUBIC cells of ~this many world units per side (per-axis grid = ceil(span/size)) instead of the uniform N³ grid — so the cell size is resolution-independent and does NOT grow 20× when --greets_displace multiplies the face count. 0 = OFF: use the legacy greets_piramid_chunk_grid N³ grid, BYTE-IDENTICAL to before. Smaller = more, tighter chunks (better frustum + occlusion rejection, more per-chunk overhead). Chunking is look-neutral scene content (a spatial partition of the same faces), not a byte-gated engine change; only the default (0) is proven byte-null.")
FDS_FLAG_INT(greets_stone_subdiv,       "FDS_GREETS_STONE_SUBDIV",      0,                              "greets",   "Greets: LINEAR-subdivide the stone wall ('rooms') + floor ('floor') materials N levels (1→4 faces per level) at init — the tessellation-density knob for the stone displacement bake (docs/ENVDYN_DISPLACEMENT_PLAN.md workstream B) and its cost spike. Pure density split: midpoints stay linear (no PN rounding — flat walls must stay flat), base geometry bit-unchanged. Runs at the FDS_MOMY_SUBDIV hook point: after Preprocess, before MakeFacesIndependentByAngle + the Piramid chunk split (so chunk bounds wrap the finer mesh). 0 = off (byte-identical); with --greets_displace on, 0 means 'use the B2-measured default density' (L=2: +3.4k faces, +2.3 ms threaded / +14.7 ms serial at the t=5780 wall pose; L=3 costs +11.5 ms threaded — needs the B5 tile pre-reject first).")
FDS_FLAG_BOOL(greets_displace,          "FDS_GREETS_DISPLACE",          0,                              "greets",   "Greets: STONE DISPLACEMENT bake (docs/ENVDYN_DISPLACEMENT_PLAN.md B3) — at init, subdivide the wall ('rooms') + floor ('floor') (see greets_stone_subdiv) and push each interior vertex along its smooth vertex normal by greets_displace_amp*(h-mipMean) (zero-mean relief, no DC bulge against the pinned borders), h bilinear-sampled from the material's HeightMap at mip greets_displace_mip at the per-FACE UV (averaged over the vertex's incident target faces). Real silhouettes + true self-shadowing for the block-scale relief; POM carries the finer detail (residual map, B4). Patch-BORDER verts (edges used by only one target face — wall/ceiling junctions, doorway jambs, wall-floor lines) are pinned at zero displacement so no T-junction or cross-material crack can open; relief fades to the authored edge there. Face normals + NormProd re-derived here; per-vertex normals re-derived by the MakeFacesIndependentByAngle pass right after (same as today). Needs the height maps loaded (--greets_stone_tex + --parallax, both default on). Default 0 = bake never runs (byte-identical).")
FDS_FLAG_FLOAT(greets_displace_amp,     "FDS_GREETS_DISPLACE_AMP",      0.3f,                           "greets",   "Greets displacement amplitude in WORLD units: vertex offset = amp*(h-mipMean) along the vertex normal (mipMean = the sampled mip's average, so the relief is zero-mean), carving up to amp*(max-min) of peak-to-valley relief. The UV-space ParallaxScale is deliberately NOT reused (different units). Scene scale: the mummy is ~3.2 units tall (~1.8 m), so 0.1 ≈ 3 cm of stone relief.")
FDS_FLAG_INT(greets_displace_mip,       "FDS_GREETS_DISPLACE_MIP",      2,                              "greets",   "Greets displacement: height-map mip level the BAKE samples for vertex heights AND for the B4 residual split (they must match or POM double-counts). 1024² map: 2 = 256², 4 = 64² texels per UV tile. This is the geometry/POM frequency split point: geometry carries the relief at scales COARSER than this mip (real silhouette), POM's residual map carries the finer surface micro-texture. Default 2 (was 4): mip 4 box-blurred the block edges cell-wide, so displaced stone read as pillowy DOMES with wavy 'melted' mortar (the geometry carried a smoothed low band, sharp block edges left to POM's parallax fakery); mip 2 resolves the mortar grooves (~2-3 texels wide, ~32 texels/block) so the blocks pop out with crisp planar faces and STRAIGHT mortar. mip 1 is marginally crisper but risks aliasing sub-block surface noise into the geometry — mip 2 is the robust sweet spot (block-scale relief fully carried, micro-texture stays parallax). Verified A/B at frontal t=1867 + grazing poses; face count essentially unchanged (mip4 9590 → mip2 9667, +0.8%). Clamped to the map's block-tiled mip range.")
FDS_FLAG_FLOAT(greets_displace_adapt,   "FDS_GREETS_DISPLACE_ADAPT",    1.0f,                           "greets",   "Greets displacement ADAPTIVE-DEPTH gain: each stone quad's subdivision level (0..5) is the smallest whose HONEST refinement error passes — a cell is 'bad' when its bilinear-of-corners deviates from the true height by > eps anywhere in the cell's FULL texel footprint at greets_displace_mip (not a sparse stencil, which used to alias and read flat) — bounded above by the per-quad block-pitch cap (greets_displace_cpb). This scales the error eps by 1/adapt: >1 = stricter = deeper, <1 = shallower/cheaper. 1.0 = the tuned default (genuinely flat quads stay shallow; block-bearing quads climb to block resolution). Only read when --greets_displace is on AND greets_stone_subdiv is 0 (a nonzero greets_stone_subdiv forces that UNIFORM level through the symmetric retriangulation instead — the cost-comparison baseline). Level-boundary edges are crack-free: the finer side's inserted edge verts are pinned onto the coarser side's straight displaced segment.")
FDS_FLAG_FLOAT(greets_displace_cpb,     "FDS_GREETS_DISPLACE_CPB",      1.0f,                           "greets",   "Greets displacement CELLS-PER-BLOCK: the target subdivision density, in subdivision cells per stone BLOCK, that the adaptive bake drives each quad toward. The block pitch (mortar period) is estimated per material from the height map by gradient autocorrelation, so this is map-relative: however many UV tiles a wall quad spans, its cells land at block scale (the fix for 'cells span 2-3 blocks → ON looks like OFF'). 1.0 = one cell per block (each block a centre-fan dome, mortar recessed at the shared cell borders — the shipped default; blocks pop with the lowest face cost). 2.0 = half-block cells (crisper flat-topped blocks, but ~4x the faces and ~2x the frame cost — measured +70 ms at t=5780, use only for hero close-ups). <1 coarser/cheaper. The honest full-footprint refinement metric still keeps genuinely flat quads shallow; this only sets the ceiling. Only read when --greets_displace is on and greets_stone_subdiv is 0.")
FDS_FLAG_BOOL(greets_displace_edge,     "FDS_GREETS_DISPLACE_EDGE",     1,                              "greets",   "Greets displacement EDGE-ALIGNED tessellation (the flat-top fix, docs/ENVDYN_DISPLACEMENT_PLAN.md): subdivision cell borders SNAP onto the height map's mortar-groove lines instead of slicing a uniform 2^L grid, so block plateaus become FLAT cells at the plateau height (4 corners, 2 triangles, zero interior tessellation) and the step down/up happens in a narrow transition band at the groove (~1.25-texel shoulder pads at the bake mip). Groove lines are detected per material in MAP space: the per-row mean-height profile gives the horizontal mortar runs, and the per-BAND (between horizontal grooves) column profile gives each band's vertical runs — running bond, where vertical mortar phase alternates per block row, lands naturally as per-band groove positions. Fixes the proven centre-fan DOME defect (--scene-displacetest: FLAT-TOP 0% at cpb=1 — every block a pyramid, square-wave silhouette FAILS). Only applies to quads whose UV mapping is axis-aligned (up to u/v swap + flips) when the block-pitch estimate succeeds AND the groove profile is bimodal; everything else (lone triangles, rotated/skewed UV charts, structure-free maps like the smooth control) keeps the adaptive centre-fan path, and greets_stone_subdiv>0 (the uniform baseline) bypasses it entirely. Cross-quad/T-junction crack discipline: groove params quantized to a 1/2048 lattice + the generalized side-pin (finer side snapped onto the coarser side's displaced polyline). COST (measured t=5780 1080p threaded, iters=40): flags-off 52.5 ms; dome path (--no-greets_displace_edge) 42.9k faces / 72.5 ms; edge path 86.6k faces / 107.0 ms — same ms-per-face curve, the edge carve just makes more (and correctly-placed) faces: ~24 tris per block (flat top + 4 step walls + corners) vs the dome's 4-triangle fan that failed the square-wave test outright. greets_displace_cpb is NOT read by the edge path (it has no free density dial — the groove graph sets the cells); it still drives the fan fallback. Only read when --greets_displace is on. 0 = legacy dome tessellation (A/B + perf baseline).")
FDS_FLAG_BOOL(greets_displace_seam_union, "FDS_GREETS_DISPLACE_SEAM_UNION", 1,                            "greets",   "S4a fan<->edge SEAM-HOLE fix (docs/OPTIMIZATION_BACKLOG.md S4a). The displacement bake's cross-patch heal only REPOSITIONS the finer side's edge verts onto the coarser side's polyline; where two adjacent stone patches' shared-side param lists have NO subset relation (a fan/lone patch's i/2^L side meeting an edge-aligned patch's mortar-groove side), the repositioned chord bypasses the other side's groove KINK -> a hairline background hole at the junction. Fix: for every interior side shared by two patches whose param lists are NEITHER a subset of the other, UNION both lists and give BOTH patches a vertex at every union param (fan-splitting the boundary triangle of each segment that lacks them), so both boundary polylines pass through the identical shared-vertex set = watertight; the heal then no-ops on those sides. SUBSET sides (level boundaries) are untouched (adaptive-level tessellation stays byte-identical). Default ON; --no-greets_displace_seam_union reproduces the pre-fix holey heal for A/B. Only read when --greets_displace is on.")
FDS_FLAG_BOOL(greets_shadow_proxy,      "FDS_GREETS_SHADOW_PROXY",      0,                              "greets",   "S1 OFFSCREEN PROXY (docs/ENVDYN_DISPLACEMENT_PLAN.md): render the displaced stone (rooms/floor detail, ~81k faces) ONLY to the main camera; every offscreen consumer (per-frame shadow bake, mirror RTT, env probe, disco/shatter) rasterises a FLAT pre-displacement stand-in (~226 faces) instead. Built at init as a separate Tri_OffscreenProxy mesh with the displaced walls' single shadow-cluster id stamped on so the deferred PolyId self-shadow test matches; the displaced detail is tagged Face_MainOnly and skipped in offscreen passes, and chunks that are 100%% displaced are marked Tri_NoShadowCast so their per-vertex transform is skipped too. Measured (t=5780, 1080p, threaded, 30-iter p50, interleaved): BAKE 27.3->21.5 ms, frame 92.8->88.1 ms (-4.7; the win is bounded because the cube-face cull already limited per-frame wall rastering). TRADE-OFF: the flat caster's shadows differ from the displaced walls' on the looked-at wall (~1%% of pixels shift by the displacement offset — measured, NOT invisible), and a flat caster carries no mortar relief so it does NOT restore per-block groove self-shadow. DEFAULT 0 so --greets_displace alone keeps its reviewed look; set 1 to opt into the perf (a look call). Only read when --greets_displace is on.")
FDS_FLAG_FLOAT(greets_displace_smooth,  "FDS_GREETS_DISPLACE_SMOOTH",   80.0f,                           "greets",   "Greets displacement SMOOTH-NORMAL angle (degrees, S1 faceting fix): after the displacement bake + MakeFacesIndependentByAngle, the displaced stone is re-smoothed by a scene-wide position-bucket weld that averages the DISPLACED face normals over neighbours within THIS angle (area-weighted), rebuilding a continuous normal AND tangent basis so the triangulation stops reading as facets/hairline seams. Higher = smoother relief (rounder stone); MUST stay below 90 so authored wall-to-wall 90-degree corners stay hard (they are ~90 apart, so the gate won't average across them); material boundaries (wall/floor/ceiling) are hard for free. 0 = leave the per-face facet normals (debug: shows the raw triangulation). Only read when --greets_displace is on.")
FDS_FLAG_INT(displace_viz,              "FDS_DISPLACE_VIZ",             0,                              "greets",   "DEBUG overlay for the stone-displacement bake (docs/ENVDYN_DISPLACEMENT_PLAN.md B). MODE selector (needs an explicit value, e.g. --displace_viz=1): 0 = OFF (byte-null, nothing recorded or drawn), 1 = MAGNITUDE wireframe, 2 = HEIGHT-ERROR field. All modes project the displaced 'rooms'/'floor' post-bake triangles through the main camera over the final frame (post-tonemap), depth-tested against ZPage16 so occluded far walls don't bleed through. MODE 1 draws the triangle EDGES tinted by per-vertex displacement magnitude (COOL blue = 0 at pinned borders + flat verts, green, WARM red = the bake's max push) — shows the added/subdivided geometry and how far each vertex moved. MODE 2 tints each displaced triangle by the SIGNED height error truth − carried, where truth = the height map at the BAKE mip and carried = the barycentric interp of the vertices' applied displacement, taken as the WORST error anywhere in the triangle's full texel footprint (not a sparse stencil, which aliased and read everything 'matched'). The value is an ABSOLUTE fraction of the map's peak-to-valley relief: MATCHED cells (|err| < 15%) get NO fill — only the thin wireframe — so the eye is drawn to failures; above that the fill fades in and tints RED = geometry UNDER-carries (missing relief — cell too coarse to follow the map, raise greets_displace_cpb) / BLUE = OVER-carries. Reads as a heat map of where the displaced GEOMETRY fails the HEIGHT MAP, so it's the tuning dial for greets_displace_cpb / _mip / _amp. Needs --greets_displace ON to have any baked geometry; with the bake OFF the overlay is empty and prints a one-line stderr hint. Run: ./DEMO --scene-greets --greets_displace --displace_viz=2")
FDS_FLAG_BOOL(shadow_cube_face_cull,    "FDS_SHADOW_CUBE_FACE_CULL",    1,                              "shadows",  "Per-cube-face bsphere cull in Transform_Objects: skip meshes whose world-space bsphere doesn't intersect the 90°-FOV pyramid of the cube face being baked. Reuses sphereOutsideSpotCone with a circumscribed cone (half-angle 54.7°, cos ≈ 0.577) to keep the test conservative. Big win for moving omnis with 6 active faces — typically each face sees only ~⅙ of the scene.")
FDS_FLAG_BOOL(shadow_cube_vert_cull,    "FDS_SHADOW_CUBE_VERT_CULL",    0,                              "shadows",  "Per-vertex pyramid cull in the cube-face shadow xform, gated on TriMesh::worldVerts being pre-computed. For meshes that pass the mesh-level cube-face cull but only partially overlap the face pyramid, skip the view matmul for world-space vertices outside. Off by default: in practice (greets chunk grid=8) the mesh-level cull is tight enough that surviving meshes have nearly all verts inside; the per-vertex test cost + un-fused perspective in the survivor path (~36 ops vs 18 ops M34) exceeds the savings. Useful if you have one giant moving mesh that can't be spatially split.")
FDS_FLAG_BOOL(shadow_swizzle,           "FDS_SHADOW_SWIZZLE",           0,                              "shadows",  "[experiment] Store shadow-map depth/polyId in 8x8-tiled (swizzled) layout so a 2x2/3x3 PCF footprint lands in one cache line instead of straddling rows, and read them swizzled in the lighting-pass PCF. A timed swizzle pass converts the freshly-baked linear maps to tiled each frame; --shadow_bake_time reports the swizzle cost separately so we can weigh swizzle-cost vs PCF-read speedup.")
FDS_FLAG_BOOL(shadow_lm_dynamic,       "FDS_SHADOW_LM_DYNAMIC",        0,                              "shadows",  "Keep the static-shadow LIGHTMAP fast path active when --shadow-dynamic is on, compositing lightmap(static) x dynamic-only cube tap (resolveCubeAtten already implements the composite). Previously --shadow-dynamic disabled the lightmap entirely, forcing full cube taps for every static light at every pixel. Faces whose dynamic buffer was not baked this frame (no moving mesh visible: ShadowMap::dynBaked) skip the dynamic tap. MEASURED NEUTRAL-to-NEGATIVE on greets (planar sampler +0.8ms w1; mech keeps dynBaked true on ~40% of faces; moving-omni taps can never use lightmaps) -> default OFF, kept for configs with sparse dynamics.")
FDS_FLAG_FLOAT(greets_omni_default_range, "FDS_GREETS_OMNI_DEFAULT_RANGE", 1500.0f,                       "greets",   "Greets: fallback IRange (and rRange) applied to FLD-loaded omnis whose Range spline is 0 (the FLD format omits the envelope when the authoring tool didn't write one — every greets omni hits this case). Set to 0 to leave them at 0, which kills surface lighting + halo + shadow FZP for those omnis.")
FDS_FLAG_FLOAT(greets_mirror_min_area,  "FDS_GREETS_MIRROR_MIN_AREA",   2.0f,                           "greets",   "Greets: secondary area gate, applied AFTER the explicit surface-name allowlist (see kMirrorScreenMats in GREETS.CPP) — it only picks the front face of a marked screen's box vs its thin side caps; it no longer decides WHICH screens reflect (that's the explicit name list now). Box edge strips 0.30-0.32, column panels ~1.0, small amudim screens ~6.4, big display 172.")
FDS_FLAG_FLOAT(greets_mirror_rtt_min_area, "FDS_GREETS_MIRROR_RTT_MIN_AREA", 1.5f,                        "greets",   "Greets: minimum coplanar P_TEXT cluster area to become a FIRST-ORDER RTT mirror (below the clone threshold). The central column panels (~0.98-1.00 area) + box edge strips (~0.30) are barely-visible half-silvered screens that add little but each cost an RTT slot + the per-frame RTT bake. Default 1.5 drops them (only end-screen CLONES at >=2.0 survive; second-order/recursive RTT is unaffected). Set 0.2 to re-include the columns + strips.")
FDS_FLAG_BOOL(mirror_rtt_probe,         "FDS_MIRROR_RTT_PROBE",         0,                              "greets",   "Per-frame probe for second-order mirror pairs: for every active mirror A whose reflection contains another mirror B's panel on screen, log the projected pixel footprint (= required RTT resolution), the doubly-reflected virtual camera position, and B's panel window extents. Diagnostic groundwork for the order-2 render-to-texture path; no rendering changes.")
FDS_FLAG_BOOL(mirror_rtt,               "FDS_MIRROR_RTT",               0,                              "greets",   "Second-order mirror reflections via render-to-texture: panels of mirror B seen inside mirror A's reflection display a per-frame low-res forward render of the real scene from the doubly-reflected camera, through B's panel window (off-axis projection, near plane at the mirror plane). Up to 2 visible pairs re-rendered per frame, picked by projected footprint area.")
FDS_FLAG_INT(mirror_recurse_depth,      "FDS_MIRROR_RECURSE_DEPTH",     0,                              "greets",   "Recursive mirror reflection depth (0 = legacy order-1 clones + order-2 RTT). N>0 enables the recursive portal-render path: a mirror seen in a mirror ... resolves N levels deep. See docs/MIRROR_RECURSION_PLAN.md. Campaign in progress — slices land incrementally; validate on --scene-cloaktest.")
FDS_FLAG_FLOAT(mirror_rtt_alpha,        "FDS_MIRROR_RTT_ALPHA",         0.75f,                          "greets",   "First-order RTT panel blend: panel weight in the transparent kernel's lerp (panel*a + behind*(1-a)). 0.75 = mostly mirror with a hint of see-through; lower is more windowy. 0 falls back to the legacy additive texel + behind/2.")
FDS_FLAG_FLOAT(mirror_rtt_gain,         "FDS_MIRROR_RTT_GAIN",          0.55f,                          "greets",   "First-order RTT reflection gain (reflectance): the mirrored scene is scaled by this before the text composite. The offscreen pass is forward-lit (StaticLighting bake on walls), which runs brighter than the deferred main pass — <1 re-balances, and real mirrors absorb anyway. 1.0 = no attenuation.")
FDS_FLAG_BOOL(greets_disco,             "FDS_GREETS_DISCO",             1,                              "greets",   "Mirrored disco ball hanging in the greets corridor: faceted env-mapped sphere + rotating spotlight dots.")
FDS_FLAG_BOOL(shard_deferred,           "FDS_SHARD_DEFERRED",           0,                              "greets",   "Mirror-shard reflections bake through the DEFERRED kernel (shadowed, lit exactly as the main deferred view) instead of the forward filler. Each shard owns a per-worker G-buffer fanned across the pool (MirrorShatter Slice 6). ~20ms vs ~6ms forward on greets's 238 shards — shadowed quality for the cost. Off → forward bake. FDS_SHARD_REFL_SERIAL forces the legacy serial path either way. Read once at shatter time. Run: ./DEMO --shard-deferred --scene-greets")
FDS_FLAG_FLOAT(mirror_rtt_density,      "FDS_MIRROR_RTT_DENSITY",       256.0f,                         "greets",   "RTT mirror texel density (texels per world unit, pow2-rounded per axis, capped at 512x512). Replaces the old constant 64K budget that gave big panels visibly lower resolution than small ones.")
FDS_FLAG_BOOL(mirror_rtt_adaptive,      "FDS_MIRROR_RTT_ADAPTIVE",      1,                              "greets",   "View-dependent RTT resolution: bake each mirror panel at the pow2 size matching its PROJECTED on-screen footprint (clamped to the density-derived max), instead of a fixed world-size*density texture. A panel seen small/oblique/across-the-room bakes cheap; a panel you're standing in front of keeps full res. Zero visible loss (never more texels than screen pixels) and the dominant greets-central-room ANIM cost (RenderSecondOrderMirrors). Off = legacy fixed size.")
FDS_FLAG_FLOAT(mirror_rtt_adaptive_scale,"FDS_MIRROR_RTT_ADAPTIVE_SCALE", 1.0f,                          "greets",   "Multiplier on the on-screen footprint before pow2-rounding for --mirror-rtt-adaptive. 1.0 = ~1 texel per screen pixel (pow2of already rounds up within 1.5x); raise toward 2 if oblique panels look soft, lower for more savings.")
FDS_FLAG_FLOAT(greets_mirror_tint,      "FDS_GREETS_MIRROR_TINT",       0.0f,                           "greets",   "OPTIONAL cool-silver cast on ALL greets mirrors via ONE composite: out = silver*tint + reflection/2. The half-silvered look is the HALVED WARM reflection (reflection/2); silver is an extra cast on top. tint=0 = dimmed warm reflection, matching the display screens (#2) with no cast; raise for a cool silver cast on the portal (#1, kernel XparBlendAlpha=0 + Lum=tint) and shatter shards (#3, same formula baked into the atlas). LIVE. (Replaces greets_shard_silver / greets_portal_tint.) FDS_TINT_RED=1 swaps silver for red to verify.")
FDS_FLAG_FLOAT(greets_shard_randomness, "FDS_GREETS_SHARD_RANDOMNESS",  1.0f,                           "greets",   "Greets shatter: irregularity of the shard pieces. Scales BOTH the non-uniform grid line spacing (varied shard SIZES) and the per-intersection 2D jitter (irregular SHAPES). 0 = a clean uniform grid; 1 = natural cracked glass; >1 = increasingly chaotic (jitter is capped at ~0.45 of a cell so pieces never cross). Read once at shatter build.")
FDS_FLAG_FLOAT(greets_shard_fall_speed, "FDS_GREETS_SHARD_FALL_SPEED",  1.5f,                           "greets",   "Greets shatter: gravity multiplier on the falling shards. 1.0 = original pace; >1 falls faster (default 1.5 = a bit snappier). Applied per-frame to the downward integration.")
FDS_FLAG_BOOL (greets_shard_lay_flat,   "FDS_GREETS_SHARD_LAY_FLAT",    1,                              "greets",   "Greets shatter: when a shard comes to rest, rotate it to lie FLAT on the floor plane (its face normal -> +Y, with a random yaw) instead of freezing at its tumbled orientation. Correctly aligns the panel normal regardless of the screen's facing (the old fixed-pitch settle assumed a -Z panel and left greets's -X panel standing on edge). 0 = freeze tumbled pose (legacy).")
FDS_FLAG_INT  (greets_shard_res,        "FDS_GREETS_SHARD_RES",         64,                             "greets",   "Greets shatter: per-shard reflection texel resolution (each shard owns one res² cell of a reflection atlas). Rounded up to pow2. Independent of --mirror-rtt-density (that only drives the room mirror RTT panels). Shards are split across as many ≤1024² atlas textures as needed (the block-tiled sampler can't address beyond 1024/axis), so res can exceed the old single-atlas ceiling of 64: 128 = 4x the texels (sharper falling shards) at ~4x the bake + memory. Read once at scene load (prepareReflectionAtlas).")
FDS_FLAG_FLOAT(disco_bloom,             "FDS_DISCO_BLOOM",              1.5f,                           "greets",   "Disco-ball bloom strength: screen-space threshold+blur+add over the ball's projected disc. 0 disables.")
FDS_FLAG_BOOL(mirror_bounce,            "FDS_MIRROR_BOUNCE",            1,                              "greets",   "Mirrors throw beams back into the room: virtual bounce spots at mirrored light positions (volumetric shaft + bounced dot pools). Off = no bounce pool activity.")
FDS_FLAG_FLOAT(mirror_bounce_gain,      "FDS_MIRROR_BOUNCE_GAIN",       0.55f,                          "greets",   "Bounce reflectance: bounce spot intensity = source x gain.")
FDS_FLAG_FLOAT(mirror_bounce_range,     "FDS_MIRROR_BOUNCE_RANGE",      1.6f,                           "greets",   "Bounce range multiplier over the source's range. 1.0 = physical (the surviving stub past the glass is a few units and barely reads); 1.6 gives the reflected shaft a visible body.")
FDS_FLAG_BOOL(mirror_prof,              "FDS_MIRROR_PROF",              0,                              "greets",   "Per-frame mirror-pass timing: accumulate UpdateAllMirrors / StampMirrorMasks / RenderSecondOrderMirrors wall time and print averages every 120 frames (FDS_MIRROR_PROF_EVERY overrides the interval). Also reports avg active mirror count and RTT jobs/frame.")
FDS_FLAG_FLOAT(fountain_particle_omni_pct, "FDS_FOUNTAIN_PARTICLE_OMNI_PCT", 0.0f,                      "fountain", "Fountain: percentage of particles spawning omnis")
FDS_FLAG_BOOL(chase_legacy_omni_hack,   "FDS_CHASE_LEGACY_OMNI_HACK",   0,                              "chase",    "Chase: apply the 1998 load-time omni fixup SceneCorrections() (Size spline x0.1, Range spline x100000, FallOff=5000). RETIRED — the effective values are now AUTHORED in Authoring/chase/CHASE.LWS (LgtIntensity x0.1, LightRange x100000 baked into the 7 lights), so this defaults OFF and the shipped scene needs no hack. The scaling is idempotent-unsafe: turning this ON against the shipped (already-baked) FLD DOUBLE-applies it (wrong). Only meaningful against an un-baked legacy LWS/FLD, kept as an A/B / re-derivation escape hatch.")
FDS_FLAG_BOOL(sky_gradient,             "FDS_SKY_GRADIENT",             0,                              "chase",    "Paint the authored backdrop GRADIENT into void/sky pixels (where no geometry drew) before the fog composite, instead of leaving them black. The four vertical stops come from the scene's authored LWS ZenithColor/SkyColor/GroundColor/NadirColor (FLD Scene_SkyColors payload → Scene::Sky*, HasSkyGradient) — a scene without them is untouched. Generic (chase today; city/crash also render void sky). Zenith at the top of the frame blends down through sky/ground to nadir at the bottom, keyed on screen Y. Default OFF — flag-off is byte-identical (the paint pass is skipped entirely). Deferred path.")
FDS_FLAG_BOOL(chase_engine_mod,         "FDS_CHASE_ENGINE_MOD",         0,                              "chase",    "Chase: modulate the 4+2 engine-glow omnis' ISize (which drives BOTH the light contribution AND the flare sprite = ISize x FlareScale) by the ships' maneuver intensity, so the engines PUNCH during the evasive clusters and the finale climb (afterburner feel). The signal is a DETERMINISTIC function of CurFrame — the ship's rotation-spline angular rate (heading/pitch/bank deg per frame, central difference), which spikes exactly at the authored jinks (incl. the M1.1 banking) and the finale pitch-up. Normalised per ship by the P90 rate over the scene, so glowMul = 1 + chase_engine_mod_gain*clamp(rate/ref,0,1). NO accumulation (pure f(CurFrame)) → snapshot-safe. Each glow is attributed to its ship by local mount-z (-88 Ship1 / -64 ship2). Default OFF → ISize untouched → chase pins byte-identical.")
FDS_FLAG_FLOAT(chase_engine_mod_gain,   "FDS_CHASE_ENGINE_MOD_GAIN",    1.0f,                           "chase",    "chase_engine_mod punch strength: glowMul = 1 + this * clamp(angularRate/P90ref, 0, 1). 1.0 = up to 2x ISize (flare + light) at the sharpest maneuver; 0 = no punch (glows stay at authored size even with chase_engine_mod on). Only consulted when chase_engine_mod is on.")
FDS_FLAG_BOOL(chase_blasters,           "FDS_CHASE_BLASTERS",           0,                              "chase",    "Stage B1 (docs/CHASE_UPGRADE_PLAN.md §B1): ship2 fires blaster bolts at Ship1. Wires the BlasterBolts module into the chase driver, driven by a DETERMINISTIC fire table (DEMO/ChaseEvents) keyed on CurFrame — bursts aligned to Ship1's authored evasive clusters (t≈1408/1495/1623). Bolt/flash state is RECONSTRUCTED pure-t every frame (§8.B), never accumulated, so the jump-to-t chase snapshot reproduces it byte-for-byte. Bolts are occluded by terrain/ships (the additive filler's ZPage16 Z-test, §8.C), light the scene + froxel fog (transient omnis), flash at muzzle/impact (fountain bolt_flash envelope, hdr_glow_scale-parity), and reflect on the water (§8.E, streaks only). Independent of greets_blasters. Default OFF → all chase pins byte-identical (no texture, no omnis, no draw).")
FDS_FLAG_FLOAT(blaster_flash_peak,      "FDS_BLASTER_FLASH_PEAK",       950.0f,                         "blaster",  "Muzzle/impact flash light ISize at full envelope (chase B1). Pooled non-stationary Omni_FogTransient at each muzzle + impact point — lights nearby geometry + froxel fog, then decays (--blaster_flash_decay). Chase-scale (ships live in view-Z hundreds+, far larger than the greets/fountain scale). Auto-scaled by hdr_glow_scale() under --hdr (glowMax cap parity with the fountain strike-flash). 0 = no flashes.")
FDS_FLAG_FLOAT(blaster_flash_range,     "FDS_BLASTER_FLASH_RANGE",      420.0f,                         "blaster",  "Muzzle/impact flash light reach in world units (chase B1). Smaller = a tight halo at the strike; larger spreads it across more fog. Chase-scale (~hundreds of units); tune with --blaster_flash_peak.")
FDS_FLAG_FLOAT(blaster_flash_decay,     "FDS_BLASTER_FLASH_DECAY",      0.12f,                          "blaster",  "Muzzle/impact flash decay rate: intensity = exp(-decay·ageFrames) over a fixed ~26-frame window (chase B1). Larger = snappier/shorter flash; smaller = lingers. Pure function of CurFrame (no accumulation) so snapshots reproduce it. See --blaster_flash_peak.")
FDS_FLAG_FLOAT(chase_spark_size,        "FDS_CHASE_SPARK_SIZE",         0.00011f,                       "blaster",  "Stage B2 (chase): impact-spark sprite size. TBR_Sprite screen size = ImageSize(1000)·RZ·PerspX·FlareSize, so FlareSize ≈ world-disc-radius/1000; this is multiplied by the target ship's world bounding radius, so a spark disc ≈ chase_spark_size·shipRadius·1000 world units. ~0.00005 reads as small hot sparks; raise for fatter sparks/splash. Only active with --chase_blasters.")
FDS_FLAG_FLOAT(chase_spark_bright,      "FDS_CHASE_SPARK_BRIGHT",       255.0f,                         "blaster",  "Stage B2 (chase): impact-spark peak additive brightness at spawn (per-channel, faded linearly to 0 over the particle life). Each spark's colour = (0.5 + 0.5·boltColour)·this·fade — a hot-white core tinted by the bolt. Too high blows the additive buffer to white; ~200-255 is a bright spark. Only active with --chase_blasters.")
FDS_FLAG_BOOL(chase_cam_fx,             "FDS_CHASE_CAM_FX",             0,                              "chase",    "Stage C1 (chase): camera SHAKE + FOV punch on bolt impacts. A post-Animate_Objects pose modifier — reconstructed pure-t from the impact table (amplitude decays ~12 frames after each hit, scaled by camera proximity), perturbing View->ISource (positional jitter, deterministic multi-sine on CurFrame), rolling View->Mat, and kicking IFOV inward (--chase_cam_fov_kick). NO accumulation → snapshot-safe; flag-off OR no active hit leaves the authored dolly untouched (pin-identical). Needs --chase_blasters (drives off its impact events). Default OFF.")
FDS_FLAG_FLOAT(chase_cam_shake_gain,    "FDS_CHASE_CAM_SHAKE_GAIN",     0.04f,                          "chase",    "chase_cam_fx shake displacement gain: camera jitter magnitude = amp·this·shipRadius world units (amp ≈ summed hit proximity, ~0..2). 0 = no positional shake (roll + FOV punch still apply). Raise for a heavier action-cam.")
FDS_FLAG_FLOAT(chase_cam_fov_kick,      "FDS_CHASE_CAM_FOV_KICK",       5.0f,                           "chase",    "chase_cam_fx FOV punch: degrees the field of view kicks INWARD (zoom) at hit peak (amp≥1), recovering as the hit fades. 0 = no FOV punch (shake still applies). ~3-8 reads as a hit jolt; too high whips distractingly.")
FDS_FLAG_BOOL(chase_cam_dump,           "FDS_CHASE_CAM_DUMP",           0,                              "chase",    "Chase debug: print one [CHASECAM] line per rendered frame to stderr — scene tick t, CurFrame, camera ISource/ITarget/IRoll/IFOV captured AFTER the full per-frame camera chain (Dynamic_Camera + chase_cam_fx), plus both ships' spline centres. Works identically in --scene-chase, the full demo, and --snapshot=chase (each snapshot t prints one line, so a t-sweep gives a framing trace). grep '\\[CHASECAM\\]' the stderr log to debug camera/framing/clipping questions. Pure observer: no state touched, default OFF, pins unaffected.")

// ─── SSAO (screen-space ambient occlusion, deferred path only) ────────────
FDS_FLAG_BOOL (ssao,                    "FDS_SSAO",                     0,                              "ssao",     "View-space SSAO over the deferred G-buffer (Render_SSAO, runs after the lighting kernel and before fog). Darkens contact creases by hemisphere depth sampling. Deferred path only; no-op in forward mode. Output target is automatic: under --hdr/--cinematic it multiplies the LINEAR radiance in g_hdrBuf before the tonemap (physically correct, glow added later is NOT occluded); without HDR it multiplies the 8-bit VPage colour. See --ssao_downscale for the cost/quality lever and --ssao_samples for sample count.")
FDS_FLAG_INT  (ssao_downscale,          "FDS_SSAO_DOWNSCALE",           1,                              "ssao",     "SSAO compute resolution divisor: 1 = full-res (sharpest, most expensive); 2 = half-res per axis (~1/4 the AO work, depth-aware bilinear upsample); 3/4 = coarser/cheaper. The depth buffer is always sampled at full res, so geometry edges stay crisp; only the AO field is reduced + upsampled. Biggest cost lever after --ssao_samples.")
FDS_FLAG_INT  (ssao_samples,            "FDS_SSAO_SAMPLES",             16,                             "ssao",     "SSAO hemisphere samples per pixel (1..64). 16 = default (clean on flat grazing surfaces like the greets floor; the depth-only denoise resolves the interleaved-gradient dither). 8 ≈ half the compute but leaves a faint directional 'hatch' on large flat areas the denoise doesn't fully clear; 32 = marginally smoother. The compute pass scales linearly with this.")
FDS_FLAG_FLOAT(ssao_radius,             "FDS_SSAO_RADIUS",              4.0f,                           "ssao",     "SSAO sampling radius in VIEW-SPACE (world) units. SCENE-SCALE DEPENDENT and small: these scenes live in view-Z ~[5..80], so ~3-5 gives crisp contact AO; ~6-12 gives a broad soft drop-shadow halo; >20 overshoots all geometry into the background (less occlusion, not more). Set FDS_SSAO_STATS=1 to print the live view-Z range for a scene.")
FDS_FLAG_FLOAT(ssao_strength,           "FDS_SSAO_STRENGTH",            1.5f,                           "ssao",     "SSAO darkening gain. 1.0 = subtle, 2-3 = dramatic. AO = 1 - occlusion*strength.")
FDS_FLAG_FLOAT(ssao_bias,               "FDS_SSAO_BIAS",                0.1f,                           "ssao",     "SSAO depth bias (view units) subtracted before the occlusion compare to kill self-occlusion acne on flat lit surfaces. Scaled to the small view-Z range; raise toward ~0.3 if you see banding/shimmer on walls.")
FDS_FLAG_FLOAT(ssao_power,              "FDS_SSAO_POWER",               1.0f,                           "ssao",     "Contrast exponent on the AO term (ao = ao^power). >1 deepens creases and lifts open areas toward white; 1.0 = linear.")
FDS_FLAG_INT  (ssao_blur,               "FDS_SSAO_BLUR",                2,                              "ssao",     "Bilateral denoise radius applied to the AO field before compositing (0..8, in compute-grid pixels). Weighted by depth AND normal similarity (cos^4) so it kills the per-sample rotation grain WITHOUT smearing across creases — normal-awareness is what keeps panel-gap detail under --ssao_downscale. 0 = raw (dithered); 2 = default. Runs in the (reduced) compute resolution, so it's cheap even at downscale 1.")
FDS_FLAG_BOOL (ssao_debug,              "FDS_SSAO_DEBUG",               0,                              "ssao",     "Visualize the AO term as greyscale (white = unoccluded, black = fully occluded) instead of modulating the lit colour. Writes straight to VPage, so pair it with --no-hdr (under HDR the tonemap overwrites VPage and the viz is lost). Use to judge the AO itself in isolation.")

// ─── SSAO: GTAO + Visibility Bitmask compute path (drop-in for the hemisphere) ─
FDS_FLAG_BOOL (ssao_gtao,               "FDS_SSAO_GTAO",                0,                              "ssao",     "Use the GTAO + Visibility-Bitmask AO compute (Therrien/Levesque 2023) instead of the hemisphere point-sampler. Horizon-based: per slice it marches a screen-space direction and accumulates a 32-sector visibility bitmask, integrating the TRUE visible horizon. Fixes the hemisphere sampler's 'halo' (fat over-occlusion band + bright silhouette rim) because background is occluded only by the occluder's real angular extent, and the thickness param lets light pass behind thin objects. Drop-in: shares --ssao_radius/strength/power/downscale/blur and the denoise+apply. Default off.")
FDS_FLAG_INT  (ssao_gtao_slices,        "FDS_SSAO_GTAO_SLICES",         2,                              "ssao",     "GTAO: number of hemisphere SLICES (screen-space directions) per pixel (1..8). Each slice is one horizon integration; more = smoother azimuthal coverage, linear cost. 2-3 + the 4×4-tiling rotation + matched denoise is the usual sweet spot.")
FDS_FLAG_INT  (ssao_gtao_steps,         "FDS_SSAO_GTAO_STEPS",          4,                              "ssao",     "GTAO: ray-march STEPS per side per slice (1..16). Samples taken outward along the slice direction within --ssao_radius (both directions → 2× this per slice). More = finer horizon, linear cost. The biggest GTAO cost lever.")
FDS_FLAG_FLOAT(ssao_gtao_thickness,     "FDS_SSAO_GTAO_THICKNESS",      1.0f,                           "ssao",     "GTAO bitmask THICKNESS in view-space units: each occluder blocks the sector range between its front face and a back face `thickness` deeper, so beyond that light passes behind it (the visibility-bitmask fix for thin-occluder over-occlusion). Larger = thicker/solid occluders (more occlusion); ~0.5-2 at this scene scale. Scene-scale dependent like --ssao_radius.")
FDS_FLAG_BOOL (ssao_temporal,           "FDS_SSAO_TEMPORAL",            0,                              "ssao",     "Temporal AO accumulation: reproject last frame's (blended) low-res AO through the camera delta, depth-reject, and blend it with the current frame (--ssao_temporal_blend). To fund the win it HALVES the per-frame sampling (GTAO steps / hemisphere samples) and cycles the 4x4 rotation tiling per frame, so the accumulated result converges back to (or past) full quality over ~1/(1-blend) frames. Risks: AO cast by MOVING objects onto static surfaces lags by the blend window (the receiving pixel's depth doesn't change, so the reject can't fire); disocclusions fall back to the current frame's noisier field for a few frames.")
FDS_FLAG_FLOAT(ssao_temporal_blend,     "FDS_SSAO_TEMPORAL_BLEND",      0.85f,                          "ssao",     "History weight for --ssao_temporal (0..0.98). 0.85 ~ a 6-7 frame accumulation window: smoother AO + shorter ghost trail; higher = smoother but laggier on moving-object AO.")

// ─── demo / debug ────────────────────────────────────────────────────────
FDS_FLAG_BOOL(skip_to_fountain,         "SKIP_TO_FOUNTAIN",             0,                              "demo",     "Skip Glato + City and jump straight to Fountain")
FDS_FLAG_BOOL(scene_mirrortest,         "FDS_SCENE_MIRRORTEST",         0,                              "demo",     "Run the interactive mirror-test scene instead of the demo sequence. Floor + back wall + reflective panel + a test cube; uses the SceneBuilder API + the planar mirror system. TAB/WASD for free-cam, ESC/Backspace to exit. Run: ./DEMO --scene-mirrortest")
FDS_FLAG_BOOL(scene_cloaktest,          "FDS_SCENE_CLOAKTEST",          0,                              "demo",     "Run the 'invisible mirror' (Sphinx cabinet) test scene: four 45-degree mirror panels in a W, hidden cubes in the wedges, checkered room. Renders 4 preset poses to /tmp/cloak_view_*.ppm and exits. The central 90-degree seam is the recursive-mirror (--mirror-rtt) A/B target. Run: ./DEMO --scene-cloaktest")
FDS_FLAG_BOOL(scene_greets,             "FDS_SCENE_GREETS",             0,                              "demo",     "Skip Glato/City/Chase/Fountain/Crash and run only the greets scene. Useful for iterating on greets-specific code (mirror system, lightmap bake, text rasterizer) without sitting through the rest of the demo each time. Run: ./DEMO --scene-greets [--greets-mirror]")
FDS_FLAG_BOOL(scene_conetest,           "FDS_SCENE_CONETEST",           0,                              "demo",     "Run the interactive volumetric-cone test scene (single spot over a ground plane) with free-cam, instead of the demo. The rig for tuning cones / fast_fog / in-scatter live. WASD/QE move, arrows look, ESC exit. Run: ./DEMO --scene-conetest --deferred --draw_cones [--fast_fog --fast_fog_blobs ...]")
FDS_FLAG_BOOL(scene_displacetest,       "FDS_SCENE_DISPLACETEST",       0,                              "demo",     "Run the minimal stone-DISPLACEMENT test scene: ONE flat 8x8 quad with an 8-bit height map, running the EXACT production bake (DisplaceStoneSubdiv, docs/ENVDYN_DISPLACEMENT_PLAN.md B) greets uses on its wall — an isolated, analytically-checkable rig for 'is the subdivision honouring the height map?'. Height map via FDS_DISPLACETEST_MAP=0(synthetic 4x4 blocks, default)/1(ramp)/2(real greets_wall_h.png)/3(running bond); FDS_DISPLACETEST_SPAN=N tiles the map across N UV tiles per axis (N*4 blocks/axis — span 3 ~= the real multi-tile greets wall). Reuses --greets_displace_amp/_mip/_adapt/_cpb + --greets_stone_subdiv VERBATIM (amp defaults up to 0.8 so relief reads on the test wall). Default = interactive free-cam (WASD/QE move, arrows look, G dump pose, ESC exit; --displace_viz=1/2 overlays the bake live). FDS_DISPLACETEST_DUMP=1 = headless: prints the [DTEST] metric matrix over (map,span), then renders the selected combo from 4 poses (frontal/45/grazing/edge-on silhouette) x 3 styles (lit/viz1/viz2) to /tmp/displacetest_*.ppm. Run: ./DEMO --scene-displacetest  |  FDS_DISPLACETEST_DUMP=1 ./DEMO --scene-displacetest")
FDS_FLAG_BOOL(scene_chase,              "FDS_SCENE_CHASE",              0,                              "demo",     "Skip Glato/City and run only the chase scene (then exit). For interactively judging chase authoring work (loop alignment, light drama) without sitting through the intro. Music (if enabled) starts at song start, so audio sync differs from the full run — this is a look-review mode, not a timing reference. Run: ./DEMO --scene-chase --deferred [--cinematic]")
FDS_FLAG_INT(chase_start,               "FDS_CHASE_START",              0,                              "demo",     "--scene-chase only: start the chase clock at this t instead of 0 (same units as --snapshot=chase@t=; loop at ~500-580, canyon/island stretch ~1200+). Debug/preview seek — a cold jump skips any state that would have accumulated before t (bolts, events), which is acceptable for look review and byte-irrelevant to the normal run.")
FDS_FLAG_BOOL(mirrortest_multi_dump,    "FDS_MIRRORTEST_MULTI_DUMP",    0,                              "demo",     "mirrortest one-shot multi-view sanity dump: render the interactive scene from 6 preset camera poses (front, side, high, low, close, far), write each as /tmp/mt_view_N.ppm, then exit. Used to verify the mirror reflection is sane from multiple angles without manual fly-through.")
FDS_FLAG_BOOL(chase_event_test,         "FDS_CHASE_EVENT_TEST",         0,                              "demo",     "S0 music-sync foundation (docs/CHASE_UPGRADE_PLAN.md §8.B). Default OFF -> chase pins byte-identical. When ON, the chase snapshot reconstructs which events are active at the current scene-tick as a PURE FUNCTION of t (no accumulation) via DEMO/ChaseEvents, and stamps a deterministic marker for each. Sources: a beatmap+event-table pair (FDS_CHASE_BEATMAP / FDS_CHASE_EVENTS files, musical order:row resolved to scene-ticks at load, offset by FDS_CHASE_MUSIC_START_TICK) if present, else a self-contained throwaway table active only at t=800. Proof: t=800 marker (3x byte-identical), t=799/801 no marker. This is the determinism contract B1/B2 blasters/particles reconstruct against.")
FDS_FLAG_BOOL(dump_mats,                "FDS_DUMP_MATS",                0,                              "debug",    "Dump material info on load")
