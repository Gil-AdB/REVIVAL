+
+mov edi,[ebp+vertex_y]
+mov edx,edi
+sal edi,8
+sal edx,10
+add edi,[Where]
+add edi,edx
+mov [ScanLine],edi
+
+OuterLoop:
+;Inner Loop Start Here
+mov eax,[Left_X]
+mov ebp,[Right_X]
+sar eax,16
+mov edi,[ScanLine]
+sar ebp,16
+sub ebp,eax
+jle UpdateValues
+FLD dword ptr [Sixteen]
+mov [XWidth],ebp
